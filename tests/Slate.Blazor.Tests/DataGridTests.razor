    // ---- selection ------------------------------------------------------------------------------------------

    [Fact]
    public void Clicks_select_rows_with_ctrl_and_shift_and_two_way_selected_items()
    {
        _rows = MakeRows(20);
        var (cut, grid) = RenderGrid(GridSelectionMode.Multi);
        ClickCell(cut, 1, "Name");
        ClickCell(cut, 3, "Name", ctrl: true);
        Assert.Equal([1, 3], _selected!.Select(r => r.Id).Order());
        ClickCell(cut, 6, "Name", shift: true);
        Assert.Equal([3, 4, 5, 6], _selected!.Select(r => r.Id).Order());
        Assert.Equal("4 selected", cut.Find(".sl-data-grid__selection-count").TextContent);
        Assert.Equal("true", cut.Find(".sl-data-grid__row[data-key='4']").GetAttribute("aria-selected"));
        Assert.Contains("is-selected", cut.Find(".sl-data-grid__row[data-key='4']").ClassList);
        Assert.Equal(4, _selectionEvents[^1].Count);

        RowCommand(cut, cut.Find(".sl-data-grid__row[data-key='9']"), "check");
        Assert.Equal(5, grid.SelectedCount);
        Assert.NotNull(cut.Find(".sl-data-grid__row[data-key='9'] .sl-data-grid__check input[checked]"));
        cut.Find(".sl-data-grid__header-cell--select input").Click();
        Assert.Equal(20, grid.SelectedCount);
        Assert.Equal("true", cut.Find(".sl-data-grid__header-cell--select input").GetAttribute("aria-checked"));
        cut.Find(".sl-data-grid__selection-bar .sl-data-grid__link").Click(); // Clear selection
        Assert.Empty(_selected!);

        // A SelectedItems value from the parent selects those rows.
        var cut2 = Render(@<SlDataGrid T="Row" Items="_rows" RowKey="r => r.Id" SelectionMode="GridSelectionMode.Multi" SelectedItems="@(new[] { _rows[2] })" Columns="@Columns()" />);
        Assert.Equal("true", cut2.Find(".sl-data-grid__row[data-key='2']").GetAttribute("aria-selected"));
        Assert.Equal("mixed", cut2.Find(".sl-data-grid__header-cell--select input").GetAttribute("aria-checked"));
    }

    /// <summary>What slate.js does for a click on a cell: report its row/column (parsed from the cell id) to the grid.</summary>
    private static void ClickCell(IRenderedComponent<ContainerFragment> cut, int key, string field, bool ctrl = false, bool shift = false, bool dbl = false)
    {
        var m = System.Text.RegularExpressions.Regex.Match(Cell(cut, key, field).Id!, @"-r(\d+)-c(\d+)$");
        var grid = cut.FindComponent<SlDataGrid<Row>>().Instance;
        cut.InvokeAsync(() => grid.OnGridCellClick(int.Parse(m.Groups[1].Value), int.Parse(m.Groups[2].Value), ctrl, shift, dbl)).GetAwaiter().GetResult();
    }

    /// <summary>What slate.js does for a click on a row's checkbox, expander or menu trigger.</summary>
    private static void RowCommand(IRenderedComponent<ContainerFragment> cut, AngleSharp.Dom.IElement row, string command, bool shift = false)
    {
        var m = System.Text.RegularExpressions.Regex.Match(row.QuerySelector("[id]")!.Id!, @"-r(\d+)-c");
        var grid = cut.FindComponent<SlDataGrid<Row>>().Instance;
        cut.InvokeAsync(() => grid.OnGridRowCommand(int.Parse(m.Groups[1].Value), command, shift)).GetAwaiter().GetResult();
    }

    private static AngleSharp.Dom.IElement Cell(IRenderedComponent<ContainerFragment> cut, int key, string field) =>
        cut.Find($".sl-data-grid__row[data-key='{key}'] .sl-data-grid__cell[data-field={field}]");

    // ---- keyboard -------------------------------------------------------------------------------------------

    [Fact]
    public void Keyboard_moves_the_active_cell_selects_and_activates()
    {
        _rows = MakeRows(100);
        var (cut, grid) = RenderGrid(GridSelectionMode.Multi);
        var vp = () => cut.Find(".sl-data-grid__viewport");
        vp().KeyDown("ArrowDown");
        vp().KeyDown("ArrowRight");
        Assert.EndsWith("-r1-c1", vp().GetAttribute("aria-activedescendant"));
        Assert.Contains("is-keyboard", cut.Find(".sl-data-grid").ClassList);
        Assert.Contains("is-active", Cell(cut, 1, "Name").ClassList);

        vp().KeyDown("End");
        Assert.EndsWith("-r1-c5", vp().GetAttribute("aria-activedescendant"));
        vp().KeyDown(new KeyboardEventArgs { Key = "End", CtrlKey = true });
        Assert.EndsWith("-r99-c5", vp().GetAttribute("aria-activedescendant"));
        Assert.Contains("data-key=\"99\"", cut.Find(".sl-data-grid__rows").InnerHtml); // revealed
        vp().KeyDown(new KeyboardEventArgs { Key = "Home", CtrlKey = true });
        vp().KeyDown("PageDown");
        Assert.EndsWith("-r13-c0", vp().GetAttribute("aria-activedescendant"));

        vp().KeyDown(" ");
        Assert.True(_selected!.Single().Id == 13);
        vp().KeyDown(new KeyboardEventArgs { Key = "ArrowDown", ShiftKey = true });
        vp().KeyDown(new KeyboardEventArgs { Key = "ArrowDown", ShiftKey = true });
        Assert.Equal([13, 14, 15], _selected!.Select(r => r.Id).Order());
        vp().KeyDown("Escape");
        Assert.Empty(_selected!);
        vp().KeyDown(new KeyboardEventArgs { Key = "a", CtrlKey = true });
        Assert.Equal(100, grid.SelectedCount);

        vp().KeyDown("Enter");
        Assert.Equal(15, _activated.Single().Id);

        vp().KeyDown(new KeyboardEventArgs { Key = "ArrowRight", AltKey = true }); // column 0 isn't reorderable
        vp().KeyDown("ArrowRight");
        vp().KeyDown(new KeyboardEventArgs { Key = "ArrowRight", AltKey = true });
        Assert.Equal(["Id", "Team", "Name", "Score", "Due", "Active"], _state!.Order);
    }

    [Fact]
    public void Keyboard_expands_and_collapses_tree_rows()
    {
        var tree = new List<Row> { new() { Id = 1, Name = "root", Children = [new() { Id = 2, Name = "child", Children = [new() { Id = 3, Name = "leaf" }] }] } };
        var cut = Render(@<SlDataGrid T="Row" Items="tree" RowKey="r => r.Id" ChildrenSelector="r => r.Children" ShowFooter="true" Columns="@Columns()" />);
        Assert.Equal("treegrid", cut.Find(".sl-data-grid__viewport").GetAttribute("role"));
        Assert.Equal(["1", "2", "3"], RowKeys(cut));
        Assert.Equal("2", cut.Find(".sl-data-grid__row[data-key='2']").GetAttribute("aria-level"));
        Assert.Contains("width:20px", cut.Find(".sl-data-grid__row[data-key='2'] [data-field=Id] span").GetAttribute("style")!);
        var vp = cut.Find(".sl-data-grid__viewport");
        vp.KeyDown("ArrowLeft");
        Assert.Equal(["1"], RowKeys(cut));
        Assert.Equal("false", cut.Find(".sl-data-grid__row[data-key='1']").GetAttribute("aria-expanded"));
        cut.Find(".sl-data-grid__viewport").KeyDown("ArrowRight");
        Assert.Equal(["1", "2", "3"], RowKeys(cut));
        RowCommand(cut, cut.Find(".sl-data-grid__row[data-key='2']"), "toggle");
        Assert.Equal(["1", "2"], RowKeys(cut));
    }

