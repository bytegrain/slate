    // ---- server mode ----------------------------------------------------------------------------------

    [Fact]
    public async Task Server_mode_shows_skeletons_then_loaded_blocks_and_selects_all_matching()
    {
        var rows = MakeRows(2500);
        var cols = new List<GridColumn<Row>> { new() { Field = "Id", Type = GridColumnType.Number }, new() { Field = "Name" }, new() { Field = "Team", Type = GridColumnType.Enum } };
        var source = new InMemoryGridDataSource<Row>(rows, cols, TimeSpan.FromMilliseconds(400), Time);
        var defs = cols.Select(c => (DataGridColumn<Row>)c).ToList();
        var cut = Render(@<SlDataGrid T="Row" DataSource="source" ColumnDefinitions="defs" RowKey="r => r.Id" SelectionMode="GridSelectionMode.Multi" ShowToolbar="true" @bind-State="_state" />);
        var grid = cut.FindComponent<SlDataGrid<Row>>().Instance;

        Assert.Contains("is-loading", cut.Find(".sl-data-grid").ClassList);
        Assert.NotNull(cut.Find(".sl-data-grid__loading-bar"));
        Assert.Equal(22, cut.FindAll(".sl-data-grid__row--skeleton").Count);
        Assert.NotNull(cut.Find(".sl-data-grid__skeleton"));
        Assert.Equal("Loading…", cut.Find(".sl-data-grid__status").TextContent);

        Time.Advance(TimeSpan.FromMilliseconds(400));
        cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".sl-data-grid__row--skeleton")));
        Assert.Equal("2,500 rows", cut.Find(".sl-data-grid__status").TextContent);
        Assert.Equal("2501", cut.Find(".sl-data-grid__viewport").GetAttribute("aria-rowcount"));
        Assert.Equal("Item 00000", cut.Find(".sl-data-grid__row[data-key='0'] [data-field=Name]").TextContent.Trim());

        // Far scroll: skeletons until the block arrives.
        await cut.InvokeAsync(() => grid.OnGridScroll(32 * 2000, 0, false, false));
        Assert.NotEmpty(cut.FindAll(".sl-data-grid__row--skeleton"));
        Time.Advance(TimeSpan.FromMilliseconds(400));
        cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".sl-data-grid__row--skeleton")));
        await cut.Find(".sl-data-grid__header-cell--select input").ClickAsync();
        cut.WaitForAssertion(() => Assert.Equal(2500, grid.SelectedCount));
        Assert.Equal("2,500 selected", cut.Find(".sl-data-grid__selection-count").TextContent);

        // A new query (sort) resets the cache and clears the selection.
        await cut.InvokeAsync(() => grid.OnGridScroll(0, 0, false, false));
        cut.Find("[data-field=Name] .sl-data-grid__sort").Click();
        cut.Find("[data-field=Name] .sl-data-grid__sort").Click();
        Assert.Equal(0, grid.SelectedCount);
        Assert.NotEmpty(cut.FindAll(".sl-data-grid__row--skeleton"));
        Time.Advance(TimeSpan.FromMilliseconds(400));
        cut.WaitForAssertion(() => Assert.Equal("2499", RowKeys(cut)[0]));

        // Select some, then "Select all matching".
        ClickCell(cut, 2499, "Name");
        cut.Find(".sl-data-grid__selection-bar .sl-data-grid__link").Click();
        Assert.Equal(2500, grid.SelectedCount);
    }

