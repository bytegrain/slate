    [Fact]
    public async Task Prerenders_without_javascript()
    {
        var services = new ServiceCollection();
        services.AddSingleton<Microsoft.JSInterop.IJSRuntime, ThrowingJs>();
        services.AddSlate();
        await using var provider = services.BuildServiceProvider();
        await using var html = new HtmlRenderer(provider, NullLoggerFactory.Instance);
        var rows = MakeRows(500);
        var text = await html.Dispatcher.InvokeAsync(async () =>
        {
            var output = await html.RenderComponentAsync<SlDataGrid<Row>>(ParameterView.FromDictionary(new Dictionary<string, object?>
            {
                [nameof(SlDataGrid<Row>.Items)] = rows,
                [nameof(SlDataGrid<Row>.ShowToolbar)] = true,
                [nameof(SlDataGrid<Row>.Columns)] = Columns(),
            }));
            return output.ToHtmlString();
        });
        Assert.Contains("sl-data-grid__viewport", text);
        Assert.Contains("500 rows", text);
        Assert.Contains("Item 00021", text);
        Assert.DoesNotContain("Item 00022", text);
    }

    private sealed class ThrowingJs : Microsoft.JSInterop.IJSRuntime
    {
        public ValueTask<TValue> InvokeAsync<TValue>(string identifier, object?[]? args) => throw new InvalidOperationException("JS during prerender");
        public ValueTask<TValue> InvokeAsync<TValue>(string identifier, CancellationToken cancellationToken, object?[]? args) => throw new InvalidOperationException("JS during prerender");
    }

    [Fact]
    public async Task Renders_100k_rows_quickly()
    {
        _rows = MakeRows(100_000);
        var sw = Stopwatch.StartNew();
        var (cut, grid) = RenderGrid(GridSelectionMode.Multi, toolbar: true, footer: true, groupable: true);
        var first = sw.Elapsed;
        Assert.Equal(22, RowKeys(cut).Length);
        Assert.Equal("100,000 rows", cut.Find(".sl-data-grid__status").TextContent);

        sw.Restart();
        cut.Find("[data-field=Score] .sl-data-grid__sort").Click();
        var sort = sw.Elapsed;
        sw.Restart();
        for (var i = 1; i <= 50; i++) await cut.InvokeAsync(() => grid.OnGridScroll(i * 32 * 30, 0, false, false));
        var scroll = sw.Elapsed / 50;
        _output.WriteLine($"100k rows: pipeline + first window {first.TotalMilliseconds:0} ms; sort {sort.TotalMilliseconds:0} ms; window shift {scroll.TotalMilliseconds:0.0} ms");
        Assert.True(first < TimeSpan.FromSeconds(5), $"first render took {first}");
        Assert.True(scroll < TimeSpan.FromMilliseconds(100), $"window shift took {scroll}");
    }
