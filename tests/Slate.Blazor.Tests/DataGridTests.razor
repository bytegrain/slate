    [Fact]
    public void Cell_editing_commits_on_enter_and_validates()
    {
        _rows = MakeRows(10);
        var module = Module;
        var (cut, _) = RenderGrid(edit: GridEditMode.Cell);
        ClickCell(cut, 0, "Name");
        cut.Find(".sl-data-grid__viewport").KeyDown("Enter");
        var editor = cut.Find(".sl-data-grid__editor");
        Assert.Equal("Item 00000", editor.GetAttribute("value"));
        Assert.Equal("Edit Name", editor.GetAttribute("aria-label"));
        Assert.Contains("is-editing", Cell(cut, 0, "Name").ClassList);
        Assert.Contains(module.Invocations["gridSync"], i => i.Arguments[1]!.ToString()!.Contains("Focus = editor"));

        editor.Input("");
        cut.Find(".sl-data-grid__editor").KeyDown("Enter");
        Assert.Equal("Name is required", cut.Find(".sl-data-grid__cell-error[role=alert]").TextContent);
        Assert.Contains("is-invalid", Cell(cut, 0, "Name").ClassList);

        cut.Find(".sl-data-grid__editor").Input("Renamed");
        cut.Find(".sl-data-grid__editor").KeyDown("Enter");
        Assert.Equal("Renamed", _rows[0].Name);
        var change = Assert.Single(_committed);
        Assert.Equal(("Name", "Item 00000", "Renamed"), (change.Field, change.OldValue, change.NewValue));
        Assert.Empty(cut.FindAll(".sl-data-grid__editor"));
        Assert.EndsWith("-r1-c1", cut.Find(".sl-data-grid__viewport").GetAttribute("aria-activedescendant")); // Enter moves down

        // Typing starts an edit with that text; number columns parse.
        cut.Find(".sl-data-grid__viewport").KeyDown("ArrowRight");
        cut.Find(".sl-data-grid__viewport").KeyDown("ArrowRight");
        cut.Find(".sl-data-grid__viewport").KeyDown("7");
        Assert.Equal("7", cut.Find(".sl-data-grid__editor").GetAttribute("value"));
        cut.Find(".sl-data-grid__editor").KeyDown("Tab");
        Assert.Equal(7, _rows[1].Score);

        // Tab moved on to Due (read-only): F2 does nothing there. Back on Score, Escape cancels.
        cut.Find(".sl-data-grid__viewport").KeyDown("F2");
        Assert.Empty(cut.FindAll(".sl-data-grid__editor"));
        cut.Find(".sl-data-grid__viewport").KeyDown("ArrowLeft");
        cut.Find(".sl-data-grid__viewport").KeyDown("F2");
        cut.Find(".sl-data-grid__editor").Input("123");
        cut.Find(".sl-data-grid__editor").KeyDown("Escape");
        Assert.Equal(7, _rows[1].Score);
        Assert.Empty(cut.FindAll(".sl-data-grid__editor"));
    }

    [Fact]
    public void Batch_editing_collects_changes_until_commit()
    {
        _rows = MakeRows(10);
        var (cut, _) = RenderGrid(edit: GridEditMode.Batch);
        ClickCell(cut, 2, "Score", dbl: true);
        cut.Find(".sl-data-grid__editor").Input("50");
        cut.Find(".sl-data-grid__editor").KeyDown("Enter");
        Assert.Equal(2, _rows[2].Score);
        Assert.Contains("is-dirty", Cell(cut, 2, "Score").ClassList);
        Assert.Equal("50", Cell(cut, 2, "Score").TextContent.Trim());
        Assert.Equal("1 unsaved change", cut.Find(".sl-data-grid__batch-bar .sl-data-grid__batch-count").TextContent);

        cut.FindAll(".sl-data-grid__batch-bar button").Single(b => b.TextContent.Contains("Commit")).Click();
        Assert.Equal(50, _rows[2].Score);
        Assert.Empty(cut.FindAll(".sl-data-grid__batch-bar"));
        Assert.Single(_committed);

        ClickCell(cut, 3, "Score", dbl: true);
        cut.Find(".sl-data-grid__editor").Input("9");
        cut.Find(".sl-data-grid__editor").KeyDown("Enter");
        cut.FindAll(".sl-data-grid__batch-bar button").Single(b => b.TextContent.Contains("Discard")).Click();
        Assert.Equal(3, _rows[3].Score);
        Assert.Empty(cut.FindAll(".is-dirty"));
    }

