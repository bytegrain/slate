@inherits SlateTestContext
@using System.Diagnostics
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging.Abstractions
@using Slate.Data
@using Xunit.Abstractions
@using Bunit.Rendering

@code {
    public sealed class Row
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Team { get; set; } = "";
        public double Score { get; set; }
        public DateTime Due { get; set; }
        public bool Active { get; set; }
        public List<Row>? Children { get; set; }
    }

    private static readonly string[] Teams = ["Alpha", "Beta", "Gamma"];

    private static List<Row> MakeRows(int count) =>
        Enumerable.Range(0, count).Select(i => new Row
        {
            Id = i, Name = $"Item {i:D5}", Team = Teams[i % 3], Score = i % 100, Due = new DateTime(2026, 1, 1, 0, 0, 0, DateTimeKind.Utc).AddDays(i % 365), Active = i % 2 == 0,
        }).ToList();

    private readonly ITestOutputHelper _output;

    public DataGridTests(ITestOutputHelper output) => _output = output;

    private List<Row> _rows = MakeRows(1000);
    private IReadOnlyCollection<Row>? _selected;
    private GridState? _state;
    private string[]? _groupBy;
    private readonly List<GridCellChange<Row>> _committed = [];
    private readonly List<Row> _activated = [];
    private readonly List<GridSelectionChangedEventArgs<Row>> _selectionEvents = [];

    private RenderFragment Columns(bool editable = false, bool groups = false) =>
        @<text>
            <SlGridColumn T="Row" Field="Id" Title="ID" Width="80" Pinned="GridPin.Start" Type="GridColumnType.Number" Aggregate="GridAggregate.Count" Reorderable="false" />
            <SlGridColumn T="Row" Field="Name" Title="Name" Width="160" Editable="editable" HeaderGroup="@(groups ? "Info" : null)"
                          Validate="@(v => string.IsNullOrWhiteSpace(v as string) ? "Name is required" : null)" />
            <SlGridColumn T="Row" Field="Team" Title="Team" Width="120" Type="GridColumnType.Enum" EnumOrder="Teams" HeaderGroup="@(groups ? "Info" : null)" />
            <SlGridColumn T="Row" Field="Score" Title="Score" Width="100" Type="GridColumnType.Number" Aggregate="GridAggregate.Sum" Editable="editable" />
            <SlGridColumn T="Row" Field="Due" Title="Due" Width="120" Type="GridColumnType.Date" />
            <SlGridColumn T="Row" Field="Active" Title="Active" Width="80" Type="GridColumnType.Boolean" />
        </text>;

    private (IRenderedComponent<ContainerFragment> Cut, SlDataGrid<Row> Grid) RenderGrid(GridSelectionMode selection = GridSelectionMode.None,
        GridEditMode edit = GridEditMode.None, bool toolbar = false, bool footer = false, bool groupable = false, bool detail = false, bool groups = false,
        string? quickFilter = null, GridPagination pagination = GridPagination.None)
    {
        var cut = Render(@<SlDataGrid T="Row" Items="_rows" RowKey="r => r.Id" Label="Rows" SelectionMode="selection" EditMode="edit"
                                      ShowToolbar="toolbar" ShowFooter="footer" Groupable="groupable" QuickFilter="@quickFilter" Pagination="pagination"
                                      @bind-SelectedItems="_selected" @bind-State="_state" @bind-GroupBy="_groupBy"
                                      SelectionChanged="e => _selectionEvents.Add(e)" CellEditCommitted="c => _committed.Add(c)" RowActivated="r => _activated.Add(r)"
                                      RowDetail="@(detail ? Detail : null)"
                                      Columns="@Columns(edit != GridEditMode.None, groups)" />);
        return (cut, cut.FindComponent<SlDataGrid<Row>>().Instance);
    }

    private static readonly RenderFragment<Row> Detail = r => @<p class="detail">Detail @r.Name</p>;

    private static string[] RowKeys(IRenderedComponent<ContainerFragment> cut) =>
        cut.FindAll(".sl-data-grid__rows > .sl-data-grid__row").Select(r => r.GetAttribute("data-key")!).ToArray();

    // ---- markup contract ----------------------------------------------------------------------------------

    [Fact]
    public void Renders_the_markup_contract()
    {
        var (cut, _) = RenderGrid(GridSelectionMode.Multi, GridEditMode.Cell, toolbar: true, footer: true, groupable: true, detail: true, groups: true);
        var root = cut.Find(".sl-data-grid");
        Assert.Equal("base", root.GetAttribute("part"));
        foreach (var c in new[] { "sl-data-grid--selection-multi", "sl-data-grid--edit-cell", "sl-data-grid--pagination-none" }) Assert.Contains(c, root.ClassList);
        Assert.Equal(2, cut.FindAll(".sl-data-grid__probe").Count);
        Assert.NotNull(cut.Find(".sl-data-grid__probe--head"));

        var toolbar = cut.Find(".sl-data-grid__toolbar");
        Assert.Equal("toolbar", toolbar.GetAttribute("part"));
        Assert.NotNull(toolbar.QuerySelector(".sl-data-grid__quick-filter"));
        Assert.Equal("1,000 rows", cut.Find(".sl-data-grid__status").TextContent);
        Assert.Contains("Drag a column header here", cut.Find(".sl-data-grid__group-bar").TextContent);

        var vp = cut.Find(".sl-data-grid__viewport");
        Assert.Equal("grid", vp.GetAttribute("role"));
        Assert.Equal("0", vp.GetAttribute("tabindex"));
        Assert.Equal("Rows", vp.GetAttribute("aria-label"));
        Assert.Equal("1003", vp.GetAttribute("aria-rowcount")); // 1000 + 2 header rows + footer
        Assert.Equal("8", vp.GetAttribute("aria-colcount")); // 6 + select + detail
        Assert.Equal("true", vp.GetAttribute("aria-multiselectable"));
        Assert.NotNull(cut.Find(".sl-data-grid__canvas"));

        var header = cut.Find(".sl-data-grid__header");
        Assert.Equal("header", header.GetAttribute("part"));
        Assert.Equal("1", cut.Find(".sl-data-grid__header-groups").GetAttribute("aria-rowindex"));
        Assert.Equal(["", "", "Info", ""], cut.FindAll(".sl-data-grid__header-group").Select(g => g.TextContent).Take(4));
        Assert.Equal("2", cut.Find(".sl-data-grid__header-row").GetAttribute("aria-rowindex"));
        var select = cut.Find(".sl-data-grid__header-cell--select");
        Assert.Contains("is-pinned-start", select.ClassList);
        Assert.Equal("Select all rows", select.QuerySelector("input")!.GetAttribute("aria-label"));

        var id = cut.Find(".sl-data-grid__header-cell[data-field=Id]");
        Assert.Equal("header-cell", id.GetAttribute("part"));
        Assert.Contains("is-pinned-start", id.ClassList);
        Assert.Contains("is-pinned-edge-start", id.ClassList);
        Assert.Contains("sl-data-grid__header-cell--end", id.ClassList);
        Assert.Equal("3", id.GetAttribute("aria-colindex"));
        Assert.Equal("none", id.GetAttribute("aria-sort"));
        Assert.Contains("left:80px", id.GetAttribute("style")!); // after the 44px select and 36px detail toggle
        Assert.NotNull(id.QuerySelector("button.sl-data-grid__sort .sl-data-grid__title"));
        Assert.Equal("Filter ID", cut.Find(".sl-data-grid__header-cell[data-field=Id] .sl-data-grid__header-button").GetAttribute("aria-label"));
        Assert.NotNull(cut.Find(".sl-data-grid__header-cell[data-field=Name] .sl-data-grid__resize[role=separator]"));

        var rows = cut.Find(".sl-data-grid__rows");
        Assert.Equal("body", rows.GetAttribute("part"));
        Assert.Equal("rowgroup", rows.GetAttribute("role"));
        var row = cut.Find(".sl-data-grid__rows > .sl-data-grid__row");
        Assert.Equal("row", row.GetAttribute("part"));
        Assert.Equal("0", row.GetAttribute("data-key"));
        Assert.Equal("3", row.GetAttribute("aria-rowindex"));
        Assert.Equal("false", row.GetAttribute("aria-selected"));
        var cell = row.QuerySelector(".sl-data-grid__cell[data-field=Name]")!;
        Assert.Equal("cell", cell.GetAttribute("part"));
        Assert.Matches(@"-r0-c1$", cell.Id!);
        Assert.Equal("Item 00000", cell.QuerySelector(".sl-data-grid__text")!.TextContent);
        Assert.Contains("sl-badge sl-badge--soft sl-tone-neutral", row.QuerySelector("[data-field=Team] span")!.ClassName);
        Assert.NotNull(row.QuerySelector("[data-field=Active] .sl-data-grid__bool[aria-label=Yes]"));
        Assert.Contains("sl-data-grid__cell--date", row.QuerySelector("[data-field=Due]")!.ClassList);
        Assert.Equal("true", row.QuerySelector("[data-field=Team]")!.GetAttribute("aria-readonly"));
        Assert.NotNull(row.QuerySelector(".sl-data-grid__expander[aria-label='Toggle details']"));

        var foot = cut.Find(".sl-data-grid__row--footer");
        Assert.Equal("footer", foot.GetAttribute("part"));
        Assert.Equal("count1,000", foot.QuerySelector("[data-field=Id]")!.TextContent.Replace(" ", ""));
        Assert.Equal("Σ49500", foot.QuerySelector("[data-field=Score]")!.TextContent.Replace(" ", ""));
        Assert.Equal("polite", cut.Find(".sl-data-grid__sr-only[role=status]").GetAttribute("aria-live"));
    }

    [Fact]
    public void Empty_states_offer_to_clear_filters()
    {
        _rows = [];
        var (cut, _) = RenderGrid();
        Assert.Equal("No data", cut.Find(".sl-data-grid__empty-title").TextContent);
        Assert.Equal("empty", cut.Find(".sl-data-grid__empty").GetAttribute("part"));

        _rows = MakeRows(10);
        var (cut2, grid) = RenderGrid(quickFilter: "zzz");
        Assert.Equal("No matching rows", cut2.Find(".sl-data-grid__empty-title").TextContent);
        cut2.Find(".sl-data-grid__empty .sl-data-grid__link").Click();
        Assert.Equal(10, cut2.FindAll(".sl-data-grid__rows > .sl-data-grid__row").Count);
        Assert.Equal("", grid.CurrentState.QuickFilter);
        Assert.Equal("", _state!.QuickFilter);
    }

    // ---- virtualisation -----------------------------------------------------------------------------------

    [Fact]
    public async Task Renders_only_the_window_and_rerenders_only_when_it_moves()
    {
        _rows = MakeRows(10_000);
        var (cut, grid) = RenderGrid();
        // Default viewport 480px − 40px header = 13.75 rows of 32px, plus 8 rows of overscan.
        Assert.Equal(22, RowKeys(cut).Length);
        Assert.Equal("0", RowKeys(cut)[0]);
        Assert.Contains("translateY(40px)", cut.Find(".sl-data-grid__rows").GetAttribute("style")!);
        Assert.Contains("height:320040px", cut.Find(".sl-data-grid__canvas").GetAttribute("style")!);

        Assert.True(await cut.InvokeAsync(() => grid.OnGridScroll(3200, 0, false, false)));
        var keys = RowKeys(cut);
        Assert.Equal("92", keys[0]);
        Assert.Equal(30, keys.Length);
        Assert.Contains($"translateY({92 * 32 + 40}px)", cut.Find(".sl-data-grid__rows").GetAttribute("style")!);
        Assert.Equal("94", cut.Find(".sl-data-grid__rows > .sl-data-grid__row").GetAttribute("aria-rowindex"));

        // Same window: nothing to render (keeps Blazor Server payloads to window shifts only).
        Assert.False(await cut.InvokeAsync(() => grid.OnGridScroll(3204, 0, false, false)));

        // Measured sizes from slate.js.
        await cut.InvokeAsync(() => grid.OnGridMeasure(40, 48, 1200, 848, true));
        Assert.Contains("sl-data-grid--comfortable", cut.Find(".sl-data-grid").ClassList);
        Assert.Equal("72", RowKeys(cut)[0]); // 3204 / 40 = 80.1 → row 80, minus 8 rows of overscan
    }

    [Fact]
    public async Task Wide_grids_virtualise_columns_with_spacers()
    {
        var columns = Enumerable.Range(0, 60).Select(i => (DataGridColumn<Row>)new GridColumn<Row> { Field = $"C{i}", Width = 100, Accessor = r => r.Id * 100 + i }).ToList();
        var cut = Render(@<SlDataGrid T="Row" Items="_rows" ColumnDefinitions="columns" />);
        var grid = cut.FindComponent<SlDataGrid<Row>>().Instance;
        var headers = cut.FindAll(".sl-data-grid__header-cell[data-field]");
        Assert.InRange(headers.Count, 5, 20);
        Assert.Equal("C0", headers[0].GetAttribute("data-field"));
        Assert.NotEmpty(cut.FindAll(".sl-data-grid__header-row > .sl-data-grid__spacer"));

        Assert.True(await cut.InvokeAsync(() => grid.OnGridScroll(0, 3000, true, true)));
        var first = cut.FindAll(".sl-data-grid__header-cell[data-field]")[0].GetAttribute("data-field");
        Assert.Equal("C26", first); // columns overlapping 3000px − 300px of overscan
        Assert.Contains("is-scrolled-x", cut.Find(".sl-data-grid").ClassList);
        Assert.Contains("is-scrollable-end", cut.Find(".sl-data-grid").ClassList);
        Assert.Equal("C26", cut.Find(".sl-data-grid__rows > .sl-data-grid__row > [data-field]").GetAttribute("data-field"));
    }

    // ---- sorting, filtering, grouping --------------------------------------------------------------------

    [Fact]
    public void Header_clicks_sort_and_shift_click_adds_sorts()
    {
        _rows = MakeRows(30);
        var (cut, _) = RenderGrid();
        cut.Find("[data-field=Score] .sl-data-grid__sort").Click();
        cut.Find("[data-field=Score] .sl-data-grid__sort").Click();
        Assert.Equal("descending", cut.Find(".sl-data-grid__header-cell[data-field=Score]").GetAttribute("aria-sort"));
        Assert.Contains("is-sorted", cut.Find(".sl-data-grid__header-cell[data-field=Score]").ClassList);
        Assert.Equal("29", RowKeys(cut)[0]);

        cut.Find("[data-field=Team] .sl-data-grid__sort").Click(new MouseEventArgs { ShiftKey = true });
        Assert.Equal(2, _state!.Sorts.Count);
        Assert.Equal("2", cut.Find("[data-field=Team] .sl-data-grid__sort-order").TextContent);
        Assert.Equal("1", cut.Find("[data-field=Score] .sl-data-grid__sort-order").TextContent);
        Assert.Contains("Sorted by Team", cut.Find(".sl-data-grid__sr-only[role=status]").TextContent);
    }

    [Fact]
    public void Filter_popover_applies_a_filter_and_shows_a_chip()
    {
        _rows = MakeRows(30);
        var (cut, _) = RenderGrid(toolbar: true);
        cut.Find(".sl-data-grid__header-cell[data-field=Name] .sl-popover__anchor").Click();
        var panel = cut.Find("form.sl-data-grid__panel");
        Assert.Equal("filter-panel", panel.GetAttribute("part"));
        Assert.Equal("Filter · Name", panel.QuerySelector(".sl-data-grid__panel-title")!.TextContent);
        cut.Find("form.sl-data-grid__panel input.sl-field__input:not([role])").Input("00001");
        cut.Find("form.sl-data-grid__panel").Submit();

        Assert.Equal(new GridFilter("Name", FilterOperator.Contains, "00001"), _state!.Filters.Single());
        Assert.Equal(["1"], RowKeys(cut));
        Assert.Equal("Name contains 00001", cut.Find(".sl-data-grid__chip .sl-data-grid__link").TextContent);
        Assert.Contains("is-filtered", cut.Find(".sl-data-grid__header-cell[data-field=Name]").ClassList);
        Assert.Equal("1 of 30 rows", cut.Find(".sl-data-grid__status").TextContent);

        cut.Find(".sl-data-grid__chip-remove").Click();
        Assert.Empty(_state!.Filters);
        Assert.Empty(cut.FindAll(".sl-data-grid__chips"));
    }

