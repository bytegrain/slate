        var (cut, _) = RenderGrid();
        Assert.Equal("Team: Alpha, Gamma", cut.Find(".sl-data-grid__chip .sl-data-grid__link").TextContent);
        Assert.Equal(20, RowKeys(cut).Length);
        cut.Find(".sl-data-grid__chip .sl-data-grid__link").Click();
