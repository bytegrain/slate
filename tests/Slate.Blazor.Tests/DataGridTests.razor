    [Fact]
    public void Grouping_renders_group_rows_with_counts_and_aggregates()
    {
        _rows = MakeRows(12);
        _groupBy = ["Team"];
        var (cut, grid) = RenderGrid(groupable: true);
        var groups = cut.FindAll(".sl-data-grid__row--group");
        Assert.Equal(3, groups.Count);
        Assert.Equal("group-row", groups[0].GetAttribute("part"));
        Assert.Equal("true", groups[0].GetAttribute("aria-expanded"));
        Assert.Equal("Team:", groups[0].QuerySelector(".sl-data-grid__group-label")!.TextContent);
        Assert.Equal("4", groups[0].QuerySelector(".sl-data-grid__group-count")!.TextContent);
        Assert.Equal(["count ID4", "Σ Score18"], groups[0].QuerySelectorAll(".sl-data-grid__aggregate").Select(a => a.TextContent));
        Assert.Equal("Team", cut.Find(".sl-data-grid__group-bar .sl-data-grid__chip").TextContent.Trim());

        RowCommand(cut, groups[0], "toggle");
        Assert.Equal("false", cut.FindAll(".sl-data-grid__row--group")[0].GetAttribute("aria-expanded"));
        Assert.Equal(11, RowKeys(cut).Length);

        cut.Find(".sl-data-grid__group-bar .sl-data-grid__chip-remove").Click();
        Assert.Empty(_groupBy!);
        Assert.Empty(cut.FindAll(".sl-data-grid__row--group"));
        Assert.Empty(grid.CurrentState.GroupBy);
    }

    [Fact]
    public async Task Dragging_a_header_reorders_or_groups()
    {
        _rows = MakeRows(5);
        var (cut, grid) = RenderGrid(groupable: true);
        await cut.InvokeAsync(() => grid.OnGridDrag("Score", "Name", false, false, false));
        Assert.Contains("is-dragging", cut.Find(".sl-data-grid__header-cell[data-field=Score]").ClassList);
        Assert.Contains("is-drop-before", cut.Find(".sl-data-grid__header-cell[data-field=Name]").ClassList);
        await cut.InvokeAsync(() => grid.OnGridDrag("Score", "Name", false, false, true));
        Assert.Equal(["Id", "Score", "Name", "Team", "Due", "Active"], cut.FindAll(".sl-data-grid__header-cell[data-field]").Select(c => c.GetAttribute("data-field")));
        Assert.Equal(["Id", "Score", "Name", "Team", "Due", "Active"], _state!.Order);

        await cut.InvokeAsync(() => grid.OnGridDrag("Team", null, false, true, false));
        Assert.Contains("is-drop-target", cut.Find(".sl-data-grid__group-bar").ClassList);
        await cut.InvokeAsync(() => grid.OnGridDrag("Team", null, false, true, true));
        Assert.Equal(["Team"], _groupBy!);

        await cut.InvokeAsync(() => grid.OnGridResize("Name", 40, false));
        Assert.Contains("width:200px", cut.Find(".sl-data-grid__header-cell[data-field=Name]").GetAttribute("style")!);
        await cut.InvokeAsync(() => grid.OnGridResize("Name", 60, true));
        Assert.Equal(220, _state!.Column("Name")!.Width);
    }

    [Fact]
    public void Column_menu_offers_the_actions_and_runs_them()
    {
        _rows = MakeRows(5);
        var (cut, _) = RenderGrid(groupable: true);
        cut.Find(".sl-data-grid__header-cell[data-field=Name] .sl-menu__trigger").Click();
        var labels = cut.FindAll(".sl-data-grid__header-cell[data-field=Name] .sl-menu-item__label").Select(l => l.TextContent).ToList();
        Assert.Equal(["Sort ascending", "Sort descending", "Filter…", "Group by Name", "Pin to start", "Pin to end", "Autosize column", "Hide column", "Columns…"], labels);
        cut.FindAll(".sl-data-grid__header-cell[data-field=Name] [role=menuitem]").First(i => i.TextContent.Contains("Pin to end")).Click();
