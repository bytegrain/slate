@inherits SlateTestContext
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.DependencyInjection

@code {
    private bool _open = true;

    // Composition style: SlAppBar / SlDrawer / SlMain children; the shell owns the drawer state.
    private IRenderedComponent<SlAppShell> RenderShell(DrawerVariant variant, Breakpoint breakpoint = Breakpoint.Md) => Render<SlAppShell>(
        @<SlAppShell DrawerVariant="variant" @bind-DrawerOpen="_open" ResponsiveBreakpoint="breakpoint" FillViewport="true">
            <SlAppBar Title="Slate" />
            <SlDrawer id="nav">
                <SlNav>
                    <SlNavHeading>Docs</SlNavHeading>
                    <SlNavItem Href="/" Icon="home" Label="Overview" Match="NavLinkMatch.All" />
                    <SlNavItem Href="/components" Label="Components" Trailing="12" />
                </SlNav>
            </SlDrawer>
            <SlMain>content</SlMain>
        </SlAppShell>);

    [Fact]
    public void Shell_renders_app_bar_with_toggle_linked_to_the_drawer()
    {
        var cut = RenderShell(DrawerVariant.Persistent);
        Assert.Equal("sl-app-shell sl-app-shell--viewport", cut.Find("div").ClassName);
        var toggle = cut.Find(".sl-app-bar button");
        Assert.Equal("Toggle navigation", toggle.GetAttribute("aria-label"));
        Assert.Equal("true", toggle.GetAttribute("aria-expanded"));
        Assert.Equal("nav", toggle.GetAttribute("aria-controls"));
        Assert.Equal("Slate", cut.Find(".sl-app-bar__title").TextContent);
        Assert.Equal("sl-drawer sl-drawer--persistent is-open", cut.Find("nav").ClassName);
        Assert.Equal("Navigation", cut.Find("nav").GetAttribute("aria-label"));
    }

    [Fact]
    public void Region_parameters_compose_app_bar_drawer_and_main()
    {
        var cut = Render(@<SlAppShell DrawerVariant="DrawerVariant.Persistent" Flush="true">
            <AppBar><SlAppBar Title="Slate" /></AppBar>
            <Drawer><SlNavItem Label="Home" Icon="home" Active="true" /></Drawer>
            <ChildContent><p id="page">page</p></ChildContent>
        </SlAppShell>);
        Assert.NotNull(cut.Find(".sl-app-shell > header.sl-app-bar"));
        Assert.NotNull(cut.Find(".sl-app-shell > nav.sl-drawer .sl-nav__item.is-active"));
        Assert.NotNull(cut.Find(".sl-app-shell > main.sl-main.sl-main--flush > #page"));
        Assert.NotNull(cut.Find(".sl-app-bar button[aria-expanded=true]"));
    }

    [Fact]
    public void App_bar_regions_and_menu_button()
    {
        var cut = Render(@<SlAppBar Title="T" ShowMenuButton="false">
            <Leading><i id="l"></i></Leading><Center><i id="c"></i></Center><Actions><i id="a"></i></Actions>
        </SlAppBar>);
        Assert.Equal(["sl-app-bar__leading", "sl-app-bar__title", "sl-app-bar__center", "sl-app-bar__actions"],
            cut.Find("header").Children.Select(c => c.ClassName));
        Assert.Empty(cut.FindAll("button"));
    }

    [Fact]
    public void Toggle_closes_and_reopens_with_two_way_binding()
    {
        var cut = RenderShell(DrawerVariant.Persistent);
        cut.Find(".sl-app-bar button").Click();
        Assert.False(_open);
        cut.WaitForAssertion(() => Assert.DoesNotContain("is-open", cut.Find("nav").ClassList));
        Assert.Equal("false", cut.Find(".sl-app-bar button").GetAttribute("aria-expanded"));
        cut.Find(".sl-app-bar button").Click();
        Assert.True(_open);
    }

    [Fact]
    public void Persistent_and_mini_drawers_have_no_scrim()
    {
        Assert.Empty(RenderShell(DrawerVariant.Persistent).FindAll(".sl-drawer-scrim"));
        Assert.Empty(RenderShell(DrawerVariant.Mini).FindAll(".sl-drawer-scrim"));
    }

    [Fact]
    public void Temporary_drawer_is_an_overlay_with_scrim_and_escape_closes_it()
    {
        var cut = RenderShell(DrawerVariant.Temporary);
        Assert.Contains("sl-drawer--temporary", cut.Find("nav").ClassList);
        Assert.Contains("is-overlay", cut.Find("nav").ClassList);
        cut.Find(".sl-drawer-scrim").Click();
        Assert.False(_open);
        cut.WaitForAssertion(() => Assert.Empty(cut.FindAll(".sl-drawer-scrim")));

        cut.Find(".sl-app-bar button").Click();
        cut.Find("nav").KeyDown("Escape");
        Assert.False(_open);
    }

    [Fact]
    public void Responsive_drawer_on_a_wide_screen_is_docked_without_scrim()
    {
        var cut = RenderShell(DrawerVariant.Responsive);
        Assert.DoesNotContain("is-overlay", cut.Find("nav").ClassList);
        Assert.Empty(cut.FindAll(".sl-drawer-scrim"));
        Assert.DoesNotContain("sl-drawer--unresolved", cut.Find("nav").ClassList);
    }

    [Fact]
    public void Responsive_drawer_closes_on_narrow_screens_after_first_render()
    {
        var module = Module;
        module.Setup<bool>("mediaMatches", _ => true).SetResult(true);
        RenderShell(DrawerVariant.Responsive);
        Assert.False(_open);
    }

    [Fact]
    public void Responsive_breakpoint_changes_class_and_media_query()
    {
        var module = Module;
        var cut = RenderShell(DrawerVariant.Responsive, Breakpoint.Lg);
        Assert.Contains("sl-drawer--breakpoint-lg", cut.Find("nav").ClassList);
        Assert.Contains(module.Invocations["mediaMatches"], i => (string)i.Arguments[0]! == "(max-width: 1199.98px)");
    }

    [Fact]
    public void Nav_items_mark_the_current_page()
    {
        Services.GetRequiredService<Bunit.TestDoubles.BunitNavigationManager>().NavigateTo("/components/button");
        var cut = RenderShell(DrawerVariant.Persistent);
        var links = cut.FindAll(".sl-nav__item");
        Assert.Null(links[0].GetAttribute("aria-current"));          // "/" matches exactly only
        Assert.Equal("page", links[1].GetAttribute("aria-current")); // prefix match
        Assert.Equal("12", links[1].QuerySelector(".sl-nav__meta")!.TextContent);
        Assert.Equal("Components", links[1].QuerySelector(".sl-nav__label")!.TextContent);
        Assert.Equal("Docs", cut.Find(".sl-nav__heading").TextContent);
    }

    [Fact]
    public void Nav_item_without_href_is_a_button_and_can_be_disabled()
    {
        var clicks = 0;
        var cut = Render<SlNavItem>(p => p.Add(x => x.Label, "Run").Add(x => x.Click, () => clicks++));
        cut.Find("button.sl-nav__item").Click();
        Assert.Equal(1, clicks);

        var disabled = Render<SlNavItem>(p => p.Add(x => x.Label, "Run").Add(x => x.Href, "/x").Add(x => x.Disabled, true));
        Assert.Empty(disabled.FindAll("a"));
        Assert.Contains("is-disabled", disabled.Find("button").ClassList);
    }

    [Fact]
    public void Navigating_closes_an_overlay_drawer()
    {
        var cut = RenderShell(DrawerVariant.Temporary);
        Services.GetRequiredService<Bunit.TestDoubles.BunitNavigationManager>().NavigateTo("/components");
        cut.WaitForAssertion(() => Assert.False(_open));
    }
}
