@* A dialog component used by the tests: edits a name and returns it. *@
<SlDialogBody>
    <SlTextField @bind-Value="Name" Label="Name" id="dialog-name" />
</SlDialogBody>
<SlDialogFooter>
    <SlButton id="cancel" OnClick="() => Dialog.Cancel()">Cancel</SlButton>
    <SlButton id="ok" Variant="ButtonVariant.Primary" OnClick="() => Dialog.Ok(Name)">Rename</SlButton>
</SlDialogFooter>

@code {
    [CascadingParameter] public SlDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string? Name { get; set; }
}
