@namespace Slate.Blazor
@implements IDisposable
@inject IDialogService Dialogs
@*
  Declarative dialog: <SlDialog @bind-Open="_open" Title="Rename"> <SlDialogBody>…</SlDialogBody> <SlDialogFooter>…</SlDialogFooter> </SlDialog>
  Rendered by the provider's dialog host so it stacks, traps focus and makes the page inert like service dialogs.
*@

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Raised when the dialog ends (Escape, scrim, close button, or SlDialogInstance.Close).</summary>
    [Parameter] public EventCallback<DialogResult> OnClose { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }

    /// <summary>Icon in a tinted tile beside the title.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Colour of the icon tile. Default neutral.</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Neutral;

    [Parameter] public DialogWidth MaxWidth { get; set; } = DialogWidth.Sm;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool FullScreen { get; set; }
    [Parameter] public DialogPlacement Placement { get; set; } = DialogPlacement.Center;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    /// <summary>The body (or SlDialogBody/SlDialogFooter children when <see cref="Footer"/> isn't used).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Footer actions — secondary first, primary last. When set, ChildContent becomes the body.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    private DialogReference? _dialog;

    private RenderFragment Body => Footer is null
        ? b => b.AddContent(0, ChildContent)
        : b =>
        {
            b.OpenElement(0, "div");
            b.AddAttribute(1, "class", "sl-dialog__body");
            b.AddContent(2, ChildContent);
            b.CloseElement();
            b.OpenElement(3, "footer");
            b.AddAttribute(4, "class", "sl-dialog__footer");
            b.AddContent(5, Footer);
            b.CloseElement();
        };

    private async Task WaitForCloseAsync(DialogReference dialog)
    {
        var result = await dialog.Result;
        await InvokeAsync(async () =>
        {
            if (_dialog == dialog) _dialog = null;
            await OnClose.InvokeAsync(result);
            if (Open)
            {
                Open = false;
                await OpenChanged.InvokeAsync(false);
            }
        });
    }

    protected override void OnParametersSet()
    {
        if (Open && _dialog is null)
        {
            var dialog = _dialog = Dialogs.Show(
                new DialogContent { Fragment = Body, Description = Description },
                new DialogOptions
                {
                    Title = Title, Description = Description, Icon = Icon, Tone = Tone, MaxWidth = MaxWidth, FullWidth = FullWidth, FullScreen = FullScreen, Placement = Placement,
                    CloseOnEscape = CloseOnEscape, CloseOnBackdropClick = CloseOnBackdropClick, ShowCloseButton = ShowCloseButton,
                });
            _ = WaitForCloseAsync(dialog);
        }
        else if (!Open && _dialog is not null)
        {
            Dialogs.Close(_dialog);
            _dialog = null;
        }
        else if (_dialog is not null)
        {
            // Parent re-rendered: refresh the host so the dialog shows current state.
            Dialogs.Refresh();
        }
    }

    public void Dispose()
    {
        if (_dialog is not null) Dialogs.Close(_dialog);
    }
}
