@namespace Slate.Blazor
@inherits SlCheckedBase<bool>
@inject SlateJs Js
<label class="@CssClass" style="@Style">
    <span class="sl-switch__control">
        <input @attributes="AdditionalAttributes" @ref="_input" id="@ElementId" type="checkbox" role="switch" class="sl-switch__input"
               checked="@Checked" aria-checked="@(Checked ? "true" : "false")" disabled="@Disabled"
               aria-describedby="@(Description is null ? null : DescriptionId)"
               @onchange="OnChange" />
        <span class="sl-switch__thumb" aria-hidden="true"></span>
    </span>
    @if (Label is not null || ChildContent is not null || Description is not null)
    {
        <span class="sl-switch__text">
            <span class="sl-switch__label">@(Label)@ChildContent</span>
            @if (Description is not null)
            {
                <span class="sl-switch__description" id="@DescriptionId">@Description</span>
            }
        </span>
    }
</label>

@code {
    [Parameter] public string? Description { get; set; }

    /// <summary>Colour when on. Default accent.</summary>
    [Parameter] public Tone? Tone { get; set; }

    [Parameter] public ControlSize? Size { get; set; }

    /// <summary>Label after the switch (End, default) or before it (Start).</summary>
    [Parameter] public Placement? LabelPlacement { get; set; }

    /// <summary>Label and switch at opposite ends of the row (settings lists; pair with LabelPlacement Start).</summary>
    [Parameter] public bool Spread { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string DescriptionId => $"{ElementId}-desc";

    private string CssClass => Css.Of("sl-switch")
        .Add(Names.Tone(Tone ?? Slate.Tone.Accent))
        .Add(Names.Size(Size ?? ControlSize.Medium, "sl-switch"))
        .Add((LabelPlacement ?? Defaults.Selection.LabelPlacement) == Placement.Start ? "sl-switch--label-start" : "sl-switch--label-end")
        .Add("sl-switch--spread", Spread)
        .Add("is-disabled", Disabled)
        .Add(Class);

    private ElementReference _input;

    private void OnChange(ChangeEventArgs e) => CurrentValue = e.Value is true || e.Value is "true" || e.Value is "on";

    // Enter must not submit the surrounding form (Space toggles natively). Needs a real listener, so it's done in JS.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JsSafe.Run(() => Js.PreventEnterAsync(_input));
    }
}
