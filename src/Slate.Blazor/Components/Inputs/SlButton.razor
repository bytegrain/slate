@namespace Slate.Blazor
@inherits SlComponentBase
@if (Href is not null && !Disabled)
{
    <a @attributes="AdditionalAttributes" class="@CssClass" style="@Style" href="@(IsLoading ? null : Href)" target="@Target"
       rel="@(Target == "_blank" ? "noreferrer noopener" : null)"
       role="@(IsLoading ? "link" : null)" aria-disabled="@(IsLoading ? "true" : null)"
       aria-label="@Label" aria-busy="@(IsLoading ? "true" : null)" aria-keyshortcuts="@Shortcut" aria-pressed="@PressedValue"
       @onclick="OnClickAsync">@Inner</a>
}
else
{
    <button @attributes="AdditionalAttributes" type="@TypeValue" class="@CssClass" style="@Style" disabled="@Disabled"
            aria-label="@Label" aria-busy="@(IsLoading ? "true" : null)" aria-disabled="@(IsLoading ? "true" : null)"
            aria-keyshortcuts="@Shortcut" aria-pressed="@PressedValue" @onclick="OnClickAsync">@Inner</button>
}

@code {
    /// <summary>Chrome: outlined (default), solid, soft, ghost or link. Primary action = Solid + Accent.</summary>
    [Parameter] public ButtonVariant? Variant { get; set; }

    /// <summary>Colour role. Default neutral (or <c>Defaults.Button.Tone</c>).</summary>
    [Parameter] public Tone? Tone { get; set; }

    [Parameter] public ControlSize? Size { get; set; }

    /// <summary>Corner radius override; Default uses <c>component.button.radius</c>.</summary>
    [Parameter] public Radius? Radius { get; set; }

    /// <summary>Icon name before the label (replaced by a spinner while loading).</summary>
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }

    /// <summary>Custom leading content (replaces <see cref="StartIcon"/>).</summary>
    [Parameter] public RenderFragment? StartContent { get; set; }

    /// <summary>Custom trailing content (replaces <see cref="EndIcon"/>).</summary>
    [Parameter] public RenderFragment? EndContent { get; set; }

    /// <summary>Square, icon-only button showing <see cref="StartIcon"/>. Requires <see cref="Label"/>.</summary>
    [Parameter] public bool IconOnly { get; set; }

    /// <summary>Accessible name (aria-label). Required for icon-only buttons.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Loading { get; set; }

    /// <summary>Show the loading state automatically while an async Click handler runs (also prevents double submits).</summary>
    [Parameter] public bool LoadingWhileBusy { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FullWidth { get; set; }

    /// <summary>Keyboard hint shown as a Kbd after the label, e.g. "⌘↵". Also sets aria-keyshortcuts.</summary>
    [Parameter] public string? Shortcut { get; set; }

    [Parameter] public ButtonType Type { get; set; } = ButtonType.Button;

    /// <summary>Renders an &lt;a&gt; with button styling.</summary>
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }

    /// <summary>Toggle buttons: true/false sets aria-pressed; null (default) is a normal button.</summary>
    [Parameter] public bool? Pressed { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _busy;

    private bool IsLoading => Loading || _busy;
    private bool IsInert => Disabled || IsLoading;
    private string? PressedValue => Pressed is { } p ? (p ? "true" : "false") : null;

    private string TypeValue => Type switch { ButtonType.Submit => "submit", ButtonType.Reset => "reset", _ => "button" };

    protected override void OnParametersSet()
    {
        if (IconOnly && string.IsNullOrWhiteSpace(Label))
            throw new InvalidOperationException("Icon-only SlButton needs a Label so assistive technology can name it.");
        if (IconOnly && StartIcon is null && StartContent is null)
            throw new InvalidOperationException("Icon-only SlButton needs a StartIcon (or StartContent).");
    }

    private string CssClass => Css.Of("sl-button")
        .Add(Names.Variant(Variant ?? Defaults.Button.Variant, "sl-button"))
        .Add(Names.Tone(Tone ?? Defaults.Button.Tone))
        .Add(Names.Size(Size ?? Defaults.Button.Size, "sl-button"))
        .Add(Names.Radius(Radius ?? Defaults.Button.Radius))
        .Add("sl-button--icon-only", IconOnly)
        .Add("sl-button--full", FullWidth)
        .Add("is-loading", IsLoading)
        .Add(Class);

    private bool HasStart => IsLoading || StartIcon is not null || StartContent is not null;
    private bool HasEnd => !IconOnly && (EndIcon is not null || EndContent is not null);

    private RenderFragment Inner => @<text>
        @if (HasStart)
        {
            <span class="sl-button__start">
                @if (IsLoading)
                {
                    <span class="sl-spinner sl-button__icon" aria-hidden="true"></span>
                }
                else if (StartContent is not null)
                {
                    @StartContent
                }
                else
                {
                    <SlIcon Name="@StartIcon" Class="sl-button__icon" />
                }
            </span>
        }
        @if (!IconOnly)
        {
            <span class="sl-button__label">@ChildContent</span>
        }
        @if (HasEnd)
        {
            <span class="sl-button__end">
                @if (EndContent is not null)
                {
                    @EndContent
                }
                else
                {
                    <SlIcon Name="@EndIcon" Class="sl-button__icon" />
                }
            </span>
        }
        @if (Shortcut is not null)
        {
            <kbd class="sl-kbd" aria-hidden="true">@Shortcut</kbd>
        }
    </text>;

    private async Task OnClickAsync(MouseEventArgs e)
    {
        if (IsInert) return;
        if (!LoadingWhileBusy)
        {
            await Click.InvokeAsync(e);
            return;
        }

        _busy = true;
        try { await Click.InvokeAsync(e); }
        finally { _busy = false; }
    }
}
