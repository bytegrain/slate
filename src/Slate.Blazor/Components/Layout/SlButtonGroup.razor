@namespace Slate.Blazor
@inherits SlComponentBase
<div @attributes="AdditionalAttributes" class="@(Css.Of("sl-button-group").Add(Class))" style="@Style" role="group" aria-label="@Label">@ChildContent</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
