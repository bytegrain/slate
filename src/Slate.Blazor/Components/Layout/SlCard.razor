@namespace Slate.Blazor
@inherits SlComponentBase
<article @attributes="AdditionalAttributes" class="@CssClass" style="@Style" tabindex="@(Interactive ? "0" : null)"
         @onclick="OnClick" @onkeydown="OnKeyDownAsync">
    @if (Header is not null)
    {
        <header class="sl-card__header">@Header</header>
    }
    else if (Title is not null || Actions is not null)
    {
        <header class="sl-card__header">
            <div class="sl-card__titles">
                @if (Title is not null)
                {
                    <h3 class="sl-card__title">@Title</h3>
                }
                @if (Subtitle is not null)
                {
                    <p class="sl-card__subtitle">@Subtitle</p>
                }
            </div>
            @if (Actions is not null)
            {
                <div class="sl-card__actions">@Actions</div>
            }
        </header>
    }
    @if (ChildContent is not null)
    {
        <div class="@(Css.Of("sl-card__body").Add("sl-card__body--flush", FlushBody))">@ChildContent</div>
    }
    @if (Footer is not null)
    {
        <footer class="sl-card__footer">@Footer</footer>
    }
</article>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Buttons on the right of the header.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Replaces the whole header (title/subtitle/actions).</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>The body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Footer actions — primary last.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public bool Outlined { get; set; }

    /// <summary>Hover lift, focusable, Enter activates OnClick.</summary>
    [Parameter] public bool Interactive { get; set; }

    /// <summary>Body without padding (tables, lists).</summary>
    [Parameter] public bool FlushBody { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string CssClass => Css.Of("sl-card").Add("sl-card--outlined", Outlined).Add("sl-card--interactive", Interactive).Add(Class);

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Interactive && e.Key == "Enter") await OnClick.InvokeAsync(new MouseEventArgs());
    }
}
