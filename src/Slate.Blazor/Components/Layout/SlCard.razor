@namespace Slate.Blazor
@inherits SlComponentBase
<article @attributes="AdditionalAttributes" class="@CssClass" style="@Style" tabindex="@(Interactive ? "0" : null)"
         @onclick="OnClickAsync" @onkeydown="OnKeyDownAsync">
    @if (Header is not null || Title is not null || Subtitle is not null || HeaderActions is not null)
    {
        <header class="sl-card__header">
            @if (Header is not null)
            {
                @Header
            }
            else
            {
                <div class="sl-card__titles">
                    @if (Title is not null)
                    {
                        <h3 class="sl-card__title">@Title</h3>
                    }
                    @if (Subtitle is not null)
                    {
                        <p class="sl-card__subtitle">@Subtitle</p>
                    }
                </div>
            }
            @if (HeaderActions is not null)
            {
                <div class="sl-card__actions">@HeaderActions</div>
            }
        </header>
    }
    @if (ChildContent is not null)
    {
        <div class="@(Css.Of("sl-card__body").Add("sl-card__body--flush", Flush))">@ChildContent</div>
    }
    @if (Footer is not null)
    {
        <footer class="sl-card__footer">@Footer</footer>
    }
</article>

@code {
    /// <summary>Elevated (default), outlined or flat.</summary>
    [Parameter] public CardVariant? Variant { get; set; }

    /// <summary>Corner radius override; Default uses <c>component.card.radius</c>.</summary>
    [Parameter] public Radius? Radius { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Replaces the title/subtitle block of the header.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Buttons on the right of the header.</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    /// <summary>The body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Footer actions — primary last.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Hover lift, focusable, Enter activates Click.</summary>
    [Parameter] public bool Interactive { get; set; }

    /// <summary>Body without padding (tables, lists, media).</summary>
    [Parameter] public bool Flush { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> Click { get; set; }

    private string CssClass => Css.Of("sl-card")
        .Add(Names.Variant(Variant ?? Defaults.Card.Variant, "sl-card"))
        .Add(Names.Radius(Radius ?? Defaults.Card.Radius))
        .Add("sl-card--interactive", Interactive)
        .Add(Class);

    private Task OnClickAsync(MouseEventArgs e) => Click.HasDelegate ? Click.InvokeAsync(e) : Task.CompletedTask;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Interactive && e.Key == "Enter") await Click.InvokeAsync(new MouseEventArgs());
    }
}
