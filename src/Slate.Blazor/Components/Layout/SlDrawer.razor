@namespace Slate.Blazor
@inherits SlComponentBase
@implements IAsyncDisposable
@inject SlateJs Js
@inject NavigationManager Navigation
<nav @attributes="AdditionalAttributes" id="@DrawerId" class="@CssClass" style="@Style" aria-label="@Label" @onkeydown="OnKeyDownAsync">
    @ChildContent
</nav>
@if (IsOpen && IsOverlay)
{
    <div class="sl-drawer-scrim" @onclick="CloseFromOverlayAsync"></div>
}

@code {
    [CascadingParameter] private SlAppShell? Shell { get; set; }

    /// <summary>Used when the drawer is not inside an <see cref="SlAppShell"/> (the shell's DrawerVariant wins).</summary>
    [Parameter] public DrawerVariant Variant { get; set; } = DrawerVariant.Responsive;

    /// <summary>Used when the drawer is not inside an <see cref="SlAppShell"/> (bind the shell's DrawerOpen instead).</summary>
    [Parameter] public bool Open { get; set; } = true;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Used when the drawer is not inside an <see cref="SlAppShell"/>.</summary>
    [Parameter] public Breakpoint Breakpoint { get; set; } = Breakpoint.Md;

    /// <summary>Accessible name of the navigation landmark.</summary>
    [Parameter] public string Label { get; set; } = "Navigation";

    /// <summary>Close overlay drawers after navigating. Default true.</summary>
    [Parameter] public bool CloseOnNavigate { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal string DrawerId => ElementId;

    private DrawerVariant EffectiveVariant => Shell?.DrawerVariant ?? Variant;
    private Breakpoint EffectiveBreakpoint => Shell?.ResponsiveBreakpoint ?? Breakpoint;

    /// <summary>Whether the drawer is open (the shell's DrawerOpen when inside a shell).</summary>
    public bool IsOpen => Shell?.DrawerOpen ?? Open;

    private string NarrowQuery => $"(max-width: {Names.Number(Breakpoints.MinWidth(EffectiveBreakpoint) - 0.02)}px)";
    private bool _narrow;
    private IJSObjectReference? _media;
    private DotNetObjectReference<SlDrawer>? _self;

    /// <summary>True when the drawer currently overlays content (temporary, or responsive below its breakpoint).</summary>
    public bool IsOverlay => EffectiveVariant == DrawerVariant.Temporary || (EffectiveVariant == DrawerVariant.Responsive && _narrow);

    // Until script has measured the viewport (prerender, or before the circuit connects) a responsive drawer
    // can't know whether it should overlay; slate-blazor.css hides it on narrow screens until then.
    private bool _resolved;

    private string CssClass => Css.Of("sl-drawer")
        .Add(Names.Variant(EffectiveVariant, "sl-drawer"))
        .Add($"sl-drawer--breakpoint-{Names.Kebab(EffectiveBreakpoint.ToString())}", EffectiveBreakpoint != Breakpoint.Md)
        .Add("is-open", IsOpen)
        .Add("is-overlay", IsOverlay)
        .Add("sl-drawer--unresolved", EffectiveVariant == DrawerVariant.Responsive && !_resolved)
        .Add(Class);

    protected override void OnInitialized()
    {
        Shell?.Register(this);
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet() => Shell?.NotifyDrawerChanged();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || EffectiveVariant != DrawerVariant.Responsive) return;
        try
        {
            await JsSafe.Run(async () =>
            {
                _self = DotNetObjectReference.Create(this);
                _media = await Js.WatchMediaAsync(NarrowQuery, _self);
                _narrow = await Js.MediaMatchesAsync(NarrowQuery);
                if (_narrow && IsOpen) await SetOpenAsync(false);
            });
        }
        finally
        {
            _resolved = true;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnMediaChanged(bool narrow)
    {
        _narrow = narrow;
        // Entering the narrow layout closes the drawer so it doesn't cover the page; widening reopens it.
        await InvokeAsync(() => SetOpenAsync(!narrow));
    }

    public Task ToggleAsync() => SetOpenAsync(!IsOpen);

    public async Task SetOpenAsync(bool open)
    {
        if (IsOpen == open)
        {
            StateHasChanged();
            return;
        }
        if (Shell is not null)
        {
            await Shell.SetDrawerOpenAsync(open);
        }
        else
        {
            Open = open;
            await OpenChanged.InvokeAsync(open);
        }
        StateHasChanged();
    }

    private async Task CloseFromOverlayAsync()
    {
        await SetOpenAsync(false);
        if (Shell is not null) await Shell.FocusToggleAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && IsOpen && IsOverlay) await CloseFromOverlayAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (CloseOnNavigate && IsOpen && IsOverlay) _ = InvokeAsync(() => SetOpenAsync(false));
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Shell?.Unregister(this);
        await JsSafe.DisposeQuietly(_media, "dispose");
        _self?.Dispose();
    }
}
