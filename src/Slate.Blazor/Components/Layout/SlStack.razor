@namespace Slate.Blazor
@inherits SlComponentBase
<DynamicTag Tag="@Tag" Attributes="AdditionalAttributes" Class="@CssClass" Style="@Style">@ChildContent</DynamicTag>

@code {
    [Parameter] public Direction Direction { get; set; } = Direction.Column;

    /// <summary>Gap as a space-token step. Default 2 (8px).</summary>
    [Parameter] public double Spacing { get; set; } = 2;

    /// <summary>Cross-axis alignment. Default stretch.</summary>
    [Parameter] public StackAlign Align { get; set; } = StackAlign.Stretch;

    /// <summary>Main-axis distribution. Default start.</summary>
    [Parameter] public StackJustify Justify { get; set; } = StackJustify.Start;
    [Parameter] public bool Wrap { get; set; }
    [Parameter] public string Tag { get; set; } = "div";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shorthand for <c>Direction="Direction.Row"</c>.</summary>
    [Parameter] public bool Row { get; set; }

    protected override void OnParametersSet()
    {
        if (!Names.SpacingSteps.Contains(Spacing))
            throw new ArgumentOutOfRangeException(nameof(Spacing), Spacing, $"Spacing must be one of {string.Join(", ", Names.SpacingSteps)}.");
    }

    private string CssClass => Css.Of("sl-stack")
        .Add("sl-stack--row", Row || Direction == Direction.Row)
        .Add($"sl-stack--spacing-{Names.Spacing(Spacing)}")
        .Add($"sl-stack--align-{Names.Kebab(Align.ToString())}", Align != StackAlign.Stretch)
        .Add($"sl-stack--justify-{Names.Kebab(Justify.ToString())}", Justify != StackJustify.Start)
        .Add("sl-stack--wrap", Wrap)
        .Add(Class);
}
