@namespace Slate.Blazor
@inherits SlComponentBase
@*
  Pagination (docs/design/css-classes.md#pagination). Pages are 1-based. PageCount comes from the parameter or
  from TotalCount / PageSize. Changing the page size keeps the first visible item on screen.
*@
<nav @attributes="AdditionalAttributes" class="@(Css.Of("sl-pagination").Add(Names.Size(Size, "sl-pagination")).Add(Class))" style="@Style" aria-label="@Label">
    @if (Summary is { } summary)
    {
        <span class="sl-pagination__summary" aria-live="polite">@summary</span>
    }
    <ul class="sl-pagination__pages">
        <li>
            <button class="sl-pagination__page" type="button" aria-label="Previous page" disabled="@(Current <= 1)" @onclick="() => GoToAsync(Current - 1)">
                <SlIcon Name="chevron-left" />
            </button>
        </li>
        @foreach (var item in PaginationRange.Compute(Current, Pages, Siblings))
        {
            if (item.IsEllipsis)
            {
                <li class="sl-pagination__ellipsis" aria-hidden="true">…</li>
            }
            else
            {
                var p = item.Page;
                <li>
                    <button class="sl-pagination__page" type="button" aria-label="@($"Page {p}")" aria-current="@(p == Current ? "page" : null)"
                            @onclick="() => GoToAsync(p)">@p</button>
                </li>
            }
        }
        <li>
            <button class="sl-pagination__page" type="button" aria-label="Next page" disabled="@(Current >= Pages)" @onclick="() => GoToAsync(Current + 1)">
                <SlIcon Name="chevron-right" />
            </button>
        </li>
    </ul>
    @if (PageSizes is { Length: > 0 })
    {
        <label class="sl-pagination__size">
            @PageSizeLabel
            <select class="sl-pagination__select" @onchange="OnSizeChange">
                @foreach (var s in PageSizes)
                {
                    <option value="@s" selected="@(s == PageSize)">@s</option>
                }
            </select>
        </label>
    }
</nav>

@code {
    /// <summary>Current page (1-based, two-way).</summary>
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    /// <summary>Number of pages. Derived from TotalCount / PageSize when not set.</summary>
    [Parameter] public int PageCount { get; set; }

    /// <summary>Pages shown either side of the current one.</summary>
    [Parameter] public int Siblings { get; set; } = 1;

    [Parameter] public int? PageSize { get; set; }
    [Parameter] public EventCallback<int?> PageSizeChanged { get; set; }

    /// <summary>Choices for the "Rows per page" select.</summary>
    [Parameter] public int[]? PageSizes { get; set; }

    /// <summary>Total items: enables the "41–50 of 200" summary.</summary>
    [Parameter] public int? TotalCount { get; set; }

    [Parameter] public ControlSize Size { get; set; } = ControlSize.Medium;

    [Parameter] public string Label { get; set; } = "Pagination";
    [Parameter] public string PageSizeLabel { get; set; } = "Rows per page";

    private int Pages => PageCount > 0 ? PageCount
        : TotalCount is { } total && PageSize is { } size and > 0 ? PaginationRange.PageCount(total, size) : 1;

    private int Current => Math.Clamp(Page, 1, Math.Max(1, Pages));

    private string? Summary => TotalCount is { } total && PageSize is { } size and > 0
        ? $"{(total == 0 ? 0 : (Current - 1) * size + 1)}–{Math.Min(Current * size, total)} of {total}"
        : null;

    public async Task GoToAsync(int page)
    {
        page = Math.Clamp(page, 1, Math.Max(1, Pages));
        if (page == Page) return;
        Page = page;
        await PageChanged.InvokeAsync(page);
    }

    private async Task OnSizeChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size) || size < 1) return;
        var old = PageSize ?? size;
        var page = PaginationRange.PageForFirstItem(Current, old, size);
        PageSize = size;
        await PageSizeChanged.InvokeAsync(size);
        if (page != Page)
        {
            Page = page;
            await PageChanged.InvokeAsync(page);
        }
    }
}
