@namespace Slate.Blazor
@inherits SlComponentBase
<span @attributes="AdditionalAttributes" class="@CssClass" style="@Style" role="status" aria-label="@Label"></span>

@code {
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Medium;

    /// <summary>Neutral (default) follows the text colour.</summary>
    [Parameter] public Tone Tone { get; set; } = Tone.Neutral;

    [Parameter] public string Label { get; set; } = "Loading";

    private string CssClass => Css.Of("sl-spinner")
        .Add(Names.Size(Size, "sl-spinner"))
        .Add(Tone == Tone.Neutral ? null : Names.Tone(Tone))
        .Add(Class);
}
