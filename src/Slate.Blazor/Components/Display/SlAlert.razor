@namespace Slate.Blazor
@inherits SlComponentBase
@if (!_dismissed)
{
    <div @attributes="AdditionalAttributes" class="@CssClass" style="@Style" role="@Role">
        @if (IconName is not null)
        {
            <span class="sl-alert__icon"><SlIcon Name="@IconName" /></span>
        }
        <div class="sl-alert__content">
            @if (Title is not null)
            {
                <strong class="sl-alert__title">@Title</strong>
            }
            @if (ChildContent is not null)
            {
                <div class="sl-alert__message">@ChildContent</div>
            }
        </div>
        @if (Actions is not null || Dismissible)
        {
            <div class="sl-alert__actions">
                @Actions
                @if (Dismissible)
                {
                    <button type="button" class="sl-button sl-button--ghost sl-tone-neutral sl-button--icon-only sl-button--small sl-alert__close"
                            aria-label="@DismissLabel" @onclick="DismissAsync"><span class="sl-button__start"><SlIcon Name="x" Class="sl-button__icon" /></span></button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Severity Severity { get; set; } = Severity.Info;

    /// <summary>Soft (default), outlined or solid.</summary>
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Soft;

    [Parameter] public string? Title { get; set; }

    /// <summary>Overrides the severity icon; "none" hides it.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Tighter padding for dense layouts.</summary>
    [Parameter] public bool Dense { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public string DismissLabel { get; set; } = "Dismiss";
    [Parameter] public EventCallback Dismissed { get; set; }

    /// <summary>Set when the alert appears in response to something, so it is announced. Errors always announce.</summary>
    [Parameter] public bool Live { get; set; }

    private bool _dismissed;

    private string? Role => Severity == Severity.Error ? "alert" : Live ? "status" : null;

    private string? IconName => Icon switch
    {
        "none" => null,
        { } custom => custom,
        _ => Severity switch
        {
            Severity.Success => "check-circle",
            Severity.Warning => "alert-triangle",
            Severity.Error => "alert-circle",
            _ => "info",
        },
    };

    private string CssClass => Css.Of("sl-alert")
        .Add(Names.Variant(Variant, "sl-alert"))
        .Add($"sl-alert--{Names.Kebab(Severity.ToString())}")
        .Add(Names.Tone(Severity.ToTone()))
        .Add("sl-alert--dense", Dense)
        .Add(Class);

    private async Task DismissAsync()
    {
        _dismissed = true;
        await Dismissed.InvokeAsync();
    }
}
