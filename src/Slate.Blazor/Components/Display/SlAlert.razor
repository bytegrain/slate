@namespace Slate.Blazor
@inherits SlComponentBase
@if (!_dismissed)
{
    <div @attributes="AdditionalAttributes" class="@CssClass" style="@Style" role="@Role">
        <SlIcon Name="@IconName" Class="sl-alert__icon" />
        <div class="sl-alert__content">
            @if (Title is not null)
            {
                <strong class="sl-alert__title">@Title</strong>
            }
            @if (ChildContent is not null)
            {
                <div class="sl-alert__message">@ChildContent</div>
            }
        </div>
        @if (Actions is not null || Dismissible)
        {
            <div class="sl-alert__actions">
                @Actions
                @if (Dismissible)
                {
                    <button type="button" class="sl-button sl-button--ghost sl-button--sm sl-button--icon sl-alert__close"
                            aria-label="@DismissLabel" @onclick="DismissAsync"><SlIcon Name="x" /></button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Severity Severity { get; set; } = Severity.Normal;
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Dismissible { get; set; }
    [Parameter] public string DismissLabel { get; set; } = "Dismiss";
    [Parameter] public EventCallback OnDismiss { get; set; }

    /// <summary>Set when the alert appears in response to something, so it is announced. Errors always announce.</summary>
    [Parameter] public bool Live { get; set; }

    private bool _dismissed;

    private string? Role => Severity == Severity.Error ? "alert" : Live ? "status" : null;

    private string IconName => Severity switch
    {
        Severity.Success => "check-circle",
        Severity.Warning => "alert-triangle",
        Severity.Error => "alert-circle",
        _ => "info",
    };

    private string CssClass => Css.Of("sl-alert")
        .Add($"sl-alert--{Names.Kebab(Severity.ToString())}", Severity != Severity.Normal)
        .Add(Class);

    private async Task DismissAsync()
    {
        _dismissed = true;
        await OnDismiss.InvokeAsync();
    }
}
