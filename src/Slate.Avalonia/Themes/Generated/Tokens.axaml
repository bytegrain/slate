  <!-- motion -->
  <sys:TimeSpan x:Key="Sl.Motion.Duration.Instant">00:00:00</sys:TimeSpan>
  <sys:TimeSpan x:Key="Sl.Motion.Duration.Fast">00:00:00.1200000</sys:TimeSpan>
  <sys:TimeSpan x:Key="Sl.Motion.Duration.Base">00:00:00.1600000</sys:TimeSpan>
  <sys:TimeSpan x:Key="Sl.Motion.Duration.Slow">00:00:00.2400000</sys:TimeSpan>
  <SplineEasing x:Key="Sl.Motion.Easing.Standard" X1="0.2" Y1="0" X2="0" Y2="1" />
  <SplineEasing x:Key="Sl.Motion.Easing.Emphasized" X1="0.3" Y1="0" X2="0" Y2="1" />
  <SplineEasing x:Key="Sl.Motion.Easing.Exit" X1="0.4" Y1="0" X2="1" Y2="1" />

