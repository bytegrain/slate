  <!-- font -->
  <FontFamily x:Key="Sl.Font.Family.Ui">Instrument Sans, Segoe UI</FontFamily>
  <FontFamily x:Key="Sl.Font.Family.Mono">IBM Plex Mono, Cascadia Mono, Consolas</FontFamily>
  <FontWeight x:Key="Sl.Font.Weight.Regular">Normal</FontWeight>
  <FontWeight x:Key="Sl.Font.Weight.Medium">Medium</FontWeight>
  <FontWeight x:Key="Sl.Font.Weight.Semibold">SemiBold</FontWeight>
  <FontWeight x:Key="Sl.Font.Weight.Bold">Bold</FontWeight>
  <x:Double x:Key="Sl.Font.Size.2xs">11</x:Double>
  <x:Double x:Key="Sl.Font.Size.Xs">12</x:Double>
  <x:Double x:Key="Sl.Font.Size.Sm">13</x:Double>
  <x:Double x:Key="Sl.Font.Size.Md">14</x:Double>
  <x:Double x:Key="Sl.Font.Size.Lg">16</x:Double>
  <x:Double x:Key="Sl.Font.Size.Xl">18</x:Double>
  <x:Double x:Key="Sl.Font.Size.2xl">22</x:Double>
  <x:Double x:Key="Sl.Font.Size.3xl">28</x:Double>
  <x:Double x:Key="Sl.Font.Size.4xl">36</x:Double>
  <x:Double x:Key="Sl.Font.Size.Display">56</x:Double>
  <x:Double x:Key="Sl.Font.LineHeight.Tight">1.15</x:Double>
  <x:Double x:Key="Sl.Font.LineHeight.Snug">1.3</x:Double>
  <x:Double x:Key="Sl.Font.LineHeight.Normal">1.5</x:Double>

  <!-- typography -->
  <ControlTheme x:Key="Sl.Typography.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="56" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="64.4" />
    <Setter Property="LetterSpacing" Value="-1.96" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="41.4" />
    <Setter Property="LetterSpacing" Value="-1.08" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.H2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="32.2" />
    <Setter Property="LetterSpacing" Value="-0.56" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.H3" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28.6" />
    <Setter Property="LetterSpacing" Value="-0.33" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="20.8" />
    <Setter Property="LetterSpacing" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="LetterSpacing" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.BodyStrong" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="LetterSpacing" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="16.9" />
    <Setter Property="LetterSpacing" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="15.6" />
    <Setter Property="LetterSpacing" Value="0" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.Overline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LineHeight" Value="14.3" />
    <Setter Property="LetterSpacing" Value="0.44" />
  </ControlTheme>
  <ControlTheme x:Key="Sl.Typography.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="LineHeight" Value="19.5" />
    <Setter Property="LetterSpacing" Value="0" />
  </ControlTheme>

