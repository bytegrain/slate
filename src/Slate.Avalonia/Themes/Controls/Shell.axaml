<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="using:Slate.Avalonia.Controls"
                    xmlns:slate="using:Slate.Avalonia">

  <!-- AppShell (docs/design/layout.md#app-shell). Drawer geometry and visibility are set by AppShell.cs. -->
  <ControlTheme x:Key="{x:Type sl:AppShell}" TargetType="sl:AppShell">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Canvas}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel Background="{TemplateBinding Background}">
          <ContentPresenter Name="PART_AppBar" DockPanel.Dock="Top" Content="{TemplateBinding AppBar}" />
          <Panel ClipToBounds="True">
            <ContentPresenter Name="PART_Content"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <Border Name="PART_Scrim" Background="{DynamicResource Sl.Brush.Scrim}" IsVisible="False" />
            <ContentPresenter Name="PART_DrawerPresenter"
                              Content="{TemplateBinding Drawer}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:temporary /template/ ContentPresenter#PART_DrawerPresenter">
      <Setter Property="BoxShadow" Value="{DynamicResource Sl.Shadow.E3}" />
    </Style>
  </ControlTheme>

  <!-- AppBar: 56px surface with bottom hairline. -->
  <ControlTheme x:Key="{x:Type sl:AppBar}" TargetType="sl:AppBar">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Appbar}" />
    <Setter Property="Padding" Value="12,0,16,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Sl.Brush.Border.Default}" Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Name="PART_MenuButton" Classes="ghost" slate:Sl.Icon="menu" Margin="0,0,8,0"
                    AutomationProperties.Name="Toggle navigation" IsVisible="{TemplateBinding ShowMenuButton}" />
            <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,16,0" />
            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            <ContentPresenter Grid.Column="3" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Drawer: subtle panel with a right hairline. -->
  <ControlTheme x:Key="{x:Type sl:Drawer}" TargetType="sl:Drawer">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Subtle}" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource Sl.Brush.Border.Default}">
          <DockPanel Margin="{TemplateBinding Padding}">
            <ContentPresenter DockPanel.Dock="Top" Content="{TemplateBinding Header}" Margin="0,0,0,8" />
            <ContentPresenter DockPanel.Dock="Bottom" Content="{TemplateBinding Footer}" Margin="0,8,0,0" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ScrollViewer>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:mini">
      <Setter Property="Padding" Value="8,12" />
    </Style>
  </ControlTheme>

  <!-- NavItem: drawer entry. Active = surface chip with e1, like the Alloy sidebar. -->
  <ControlTheme x:Key="{x:Type sl:NavItem}" TargetType="sl:NavItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Sl.FocusAdorner.Tight}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Sl.CornerRadius.Md}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <sl:Icon Kind="{TemplateBinding Icon}" Margin="0,0,10,0" />
            <TextBlock Name="PART_Label" Grid.Column="1" Text="{TemplateBinding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="PART_Count" Grid.Column="2" Text="{TemplateBinding Count}" VerticalAlignment="Center"
                       FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="11" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    </Style>
    <Style Selector="^:active">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource Sl.Shadow.E1}" />
      </Style>
    </Style>
    <Style Selector="sl|Drawer:mini ^">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Style Selector="^ /template/ TextBlock#PART_Label, ^ /template/ TextBlock#PART_Count">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ sl|Icon">
        <Setter Property="Margin" Value="0" />
      </Style>
      <Style Selector="^ /template/ Grid">
        <Setter Property="HorizontalAlignment" Value="Center" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
    </Style>
  </ControlTheme>

  <!--
    SlateWindow: Fluent's window template plus Alloy's 36px title bar. The title bar has the TitleBar
    decoration role (drag, double-click to maximise); its buttons have the User role so they get input.
  -->
  <ControlTheme x:Key="{x:Type sl:SlateWindow}" TargetType="sl:SlateWindow">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
          <Border Background="{TemplateBinding Background}" IsHitTestVisible="False" />
          <VisualLayerManager Name="PART_VisualLayerManager">
            <DockPanel>
              <Border Name="PART_TitleBar" DockPanel.Dock="Top" Height="{DynamicResource Sl.Size.Titlebar}"
                      Background="{DynamicResource Sl.Brush.Background.Surface}"
                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Sl.Brush.Border.Default}"
                      WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Sl.Brush.Text.Primary}">
                      <sl:Icon Kind="{TemplateBinding AppIcon}" Size="13" StrokeThickness="2.4"
                               Foreground="{DynamicResource Sl.Brush.Background.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                  </StackPanel>
                  <ContentPresenter Grid.Column="1" Content="{TemplateBinding TitleBarContent}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    WindowDecorationProperties.ElementRole="User" />
                  <ContentPresenter Grid.Column="2" Content="{TemplateBinding TitleBarActions}" VerticalAlignment="Center"
                                    Margin="0,0,8,0" WindowDecorationProperties.ElementRole="User" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" WindowDecorationProperties.ElementRole="User">
                    <Button Name="PART_Minimize" Classes="ghost caption" slate:Sl.Icon="minus" AutomationProperties.Name="Minimise" />
                    <Button Name="PART_Maximize" Classes="ghost caption" slate:Sl.Icon="copy" AutomationProperties.Name="Maximise" />
                    <Button Name="PART_Close" Classes="ghost caption close" slate:Sl.Icon="x" AutomationProperties.Name="Close" />
                  </StackPanel>
                </Grid>
              </Border>
              <sl:DialogHost Service="{TemplateBinding DialogService}">
                <sl:SnackbarHost Service="{TemplateBinding SnackbarService}">
                  <ContentPresenter Name="PART_ContentPresenter"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Content="{TemplateBinding Content}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </sl:SnackbarHost>
              </sl:DialogHost>
            </DockPanel>
          </VisualLayerManager>
        </Panel>
      </ControlTemplate>
    </Setter>
    <!-- Neutral caption buttons: 44×36, ghost; close turns danger on hover. -->
    <Style Selector="^ /template/ Button.caption">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="{DynamicResource Sl.Size.Titlebar}" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^ /template/ Button.caption:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    </Style>
    <Style Selector="^ /template/ Button.caption.close:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Solid}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.OnSolid}" />
    </Style>
    <Style Selector="^:maximized">
      <Setter Property="Padding" Value="0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
