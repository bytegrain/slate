<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="using:Slate.Avalonia.Controls"
                    xmlns:slate="using:Slate.Avalonia">
  <!--
    Button (docs/design/components.md#button, design/api/components.json)
    Variant classes: outlined (default) solid soft ghost link — via sl:Sl.Variant or Classes.
    Tone classes: tone-neutral (default) tone-accent tone-success tone-warning tone-danger tone-info — via sl:Sl.Tone.
    Variants read the tone's brushes (sl:Sl.ToneFill, ToneOn, ToneText, ToneSubtle), so any combination works:
    the primary action is Solid + Accent; a destructive confirm is Solid + Danger.
    Sizes: small large. States: loading, icon-only, pressed (toggle), full-width.
    Geometry comes from component tokens (Sl.Component.Button.*), so overriding those restyles every button in scope.
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sl.Component.Button.Radius.Corner}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="MinWidth" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Sl.Component.Button.PaddingMd.Inline}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Component.Button.FontWeight}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{DynamicResource Sl.FocusAdorner}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="{DynamicResource Sl.Component.Button.Shadow}" />
          <!-- State layer for tones without their own hover/pressed colours. -->
          <Border Name="PART_Overlay" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent" IsHitTestVisible="False" />
          <StackPanel Name="PART_Row"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource Sl.Component.Button.Gap}"
                      Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <sl:LoadingSpinner Name="PART_Spinner" Diameter="14" IsVisible="False" VerticalAlignment="Center" />
            <sl:Icon Name="PART_Icon" Kind="{TemplateBinding (slate:Sl.StartIcon)}" Size="{DynamicResource Sl.Component.Button.IconSize}" VerticalAlignment="Center" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center" />
            <sl:Icon Name="PART_EndIcon" Kind="{TemplateBinding (slate:Sl.EndIcon)}" Size="{DynamicResource Sl.Component.Button.IconSize}" VerticalAlignment="Center" />
            <sl:Kbd Name="PART_Shortcut" Text="{TemplateBinding (slate:Sl.Shortcut)}" IsVisible="False" Margin="2,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Transitions are set by style (not in the template) so ReduceMotion can remove them. -->
    <Style Selector="^ /template/ Border#PART_Border">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <!-- outlined (default): neutral chrome, tone-coloured text -->
    <Style Selector="^.outlined">
      <Setter Property="Foreground" Value="{Binding $self.(slate:Sl.ToneText)}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Pressed}" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource Sl.Shadow.Pressed}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- toggle (sl:Sl.Pressed): pressed state uses the tone's subtle fill -->
    <Style Selector="^.pressed">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Accent.Text}" />
    </Style>

    <!-- parts -->
    <Style Selector="^.icon-only">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="{DynamicResource Sl.Size.Control.Md}" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^ /template/ sl|Icon:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.has-shortcut /template/ sl|Kbd#PART_Shortcut">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.loading">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Cursor" Value="Wait" />
      <Style Selector="^ /template/ sl|LoadingSpinner#PART_Spinner">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^ /template/ sl|Icon#PART_Icon">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </Style>
    <Style Selector="^.full-width">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- sizes -->
    <Style Selector="^.small">
      <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
      <Setter Property="MinWidth" Value="{DynamicResource Sl.Size.Control.Sm}" />
      <Setter Property="Padding" Value="{DynamicResource Sl.Component.Button.PaddingSm.Inline}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="^.small.icon-only">
      <Setter Property="Width" Value="{DynamicResource Sl.Size.Control.Sm}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
      <Setter Property="MinWidth" Value="{DynamicResource Sl.Size.Control.Lg}" />
      <Setter Property="Padding" Value="{DynamicResource Sl.Component.Button.PaddingLg.Inline}" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="^.large.icon-only">
      <Setter Property="Width" Value="{DynamicResource Sl.Size.Control.Lg}" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- solid: filled with the tone -->
    <Style Selector="^.solid">
      <Setter Property="Background" Value="{Binding $self.(slate:Sl.ToneFill)}" />
      <Setter Property="Foreground" Value="{Binding $self.(slate:Sl.ToneOn)}" />
      <Setter Property="BorderThickness" Value="0" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="{DynamicResource Sl.Component.Button.SolidShadow}" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{Binding $self.(slate:Sl.ToneFillHover)}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{Binding $self.(slate:Sl.ToneFillPressed)}" />
      </Style>
    </Style>
    <!-- Tones without dedicated hover/pressed colours darken through the overlay instead. -->
    <Style Selector="^.solid:not(.tone-accent):pointerover /template/ Border#PART_Overlay">
      <Setter Property="Background" Value="#1A000000" />
    </Style>
    <Style Selector="^.solid:not(.tone-accent):pressed /template/ Border#PART_Overlay">
      <Setter Property="Background" Value="#33000000" />
    </Style>

    <!-- soft: tinted with the tone's subtle colour -->
    <Style Selector="^.soft">
      <Setter Property="Background" Value="{Binding $self.(slate:Sl.ToneSubtle)}" />
      <Setter Property="Foreground" Value="{Binding $self.(slate:Sl.ToneText)}" />
      <Setter Property="BorderThickness" Value="0" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="none" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{Binding $self.(slate:Sl.ToneSubtle)}" />
        <Style Selector="^ /template/ Border#PART_Overlay">
          <Setter Property="Background" Value="{Binding $parent[Button].(slate:Sl.ToneText)}" />
          <Setter Property="Opacity" Value="0.08" />
        </Style>
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Overlay">
        <Setter Property="Background" Value="{Binding $parent[Button].(slate:Sl.ToneText)}" />
        <Setter Property="Opacity" Value="0.14" />
      </Style>
    </Style>

    <!-- ghost: no chrome until hovered -->
    <Style Selector="^.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{Binding $self.(slate:Sl.ToneText)}" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="none" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Pressed}" />
      </Style>
    </Style>
    <!-- Neutral ghost text is secondary until hovered (toolbars, dense rows). -->
    <Style Selector="^.ghost.tone-neutral">
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    </Style>
    <Style Selector="^.ghost.tone-neutral:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    </Style>

    <!-- link: inline text link (neutral links use the link colour) -->
    <Style Selector="^.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{Binding $self.(slate:Sl.ToneText)}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="NaN" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="BoxShadow" Value="none" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter > TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="Transparent" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style>
    <Style Selector="^.link.tone-neutral, ^.link.tone-accent">
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Link}" />
    </Style>
    <Style Selector="^.link.tone-neutral:pointerover, ^.link.tone-accent:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.LinkHover}" />
    </Style>
  </ControlTheme>

  <!-- ToggleButton shares the Button look; checked uses the accent tint. -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Subtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Accent.Text}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
