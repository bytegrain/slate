<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="using:Slate.Avalonia.Controls"
                    xmlns:slate="using:Slate.Avalonia">

  <!-- Popover: anchor + floating panel (Sl.Component.Popover.*). Positioned by SlatePlacement. -->
  <ControlTheme x:Key="{x:Type sl:Popover}" TargetType="sl:Popover">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_Anchor" Content="{TemplateBinding Anchor}" />
          <Popup Name="PART_Popup" WindowManagerAddShadowHint="True">
            <Border Name="PART_Panel"
                    Background="{DynamicResource Sl.Component.Popover.Background.Brush}"
                    BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="{DynamicResource Sl.Component.Popover.Radius.Corner}"
                    BoxShadow="{DynamicResource Sl.Component.Popover.Shadow}"
                    Padding="{DynamicResource Sl.Thickness.3}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter Content="{TemplateBinding Content}" Foreground="{DynamicResource Sl.Brush.Text.Primary}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Menu: just the trigger; the menu itself is a native ContextMenu (themed below). -->
  <ControlTheme x:Key="{x:Type sl:Menu}" TargetType="sl:Menu">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_Trigger" Content="{TemplateBinding Trigger}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Menus (ContextMenu, Menu, submenus): popover surface, 4px padding, item rows from Sl.Component.Menu.*. -->
  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Popover.Background.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sl.Component.Popover.Radius.Corner}" />
    <Setter Property="Padding" Value="{DynamicResource Sl.Component.Popover.Padding.Thickness}" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="WindowManagerAddShadowHint" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="{DynamicResource Sl.Component.Popover.Shadow}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"
                            Grid.IsSharedSizeScope="True" KeyboardNavigation.TabNavigation="Continue" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}"
                  MinHeight="{DynamicResource Sl.Component.Menu.ItemHeight}" Padding="8,0"
                  CornerRadius="{DynamicResource Sl.Component.Menu.ItemRadius.Corner}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemIcon" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemShortcut" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemChevron" />
              </Grid.ColumnDefinitions>
              <Panel Name="PART_IconSlot" Width="16" Margin="0,0,10,0" VerticalAlignment="Center">
                <ContentPresenter Name="PART_IconPresenter" Content="{TemplateBinding Icon}"
                                  Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                <sl:Icon Name="PART_Check" Kind="check" Size="14" IsVisible="False" Foreground="{DynamicResource Sl.Brush.Accent.Text}" />
              </Panel>
              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="1" Content="{TemplateBinding Header}"
                                VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock Name="PART_InputGestureText" Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"
                         Text="{Binding $parent[MenuItem].(slate:Sl.Shortcut)}"
                         FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="11"
                         Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
              <sl:Icon Name="PART_Chevron" Grid.Column="3" Kind="chevron-right" Size="14" Margin="8,0,0,0" IsVisible="False"
                       Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup" Placement="RightEdgeAlignedTop" HorizontalOffset="4" IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}" WindowManagerAddShadowHint="True">
            <Border Background="{DynamicResource Sl.Component.Popover.Background.Brush}"
                    BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="{DynamicResource Sl.Component.Popover.Radius.Corner}"
                    Padding="{DynamicResource Sl.Component.Popover.Padding.Thickness}" MinWidth="180"
                    BoxShadow="{DynamicResource Sl.Component.Popover.Shadow}">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Sl.Component.Menu.ItemHover.Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Sl.Component.Menu.ItemHover.Brush}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Sl.Component.Menu.ItemHover.Brush}" />
    </Style>
    <Style Selector="^:checked /template/ sl|Icon#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:empty /template/ sl|Icon#PART_Chevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:empty) /template/ sl|Icon#PART_Chevron">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.tone-danger">
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
    </Style>
    <Style Selector="^.tone-danger /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
    </Style>
  </ControlTheme>

  <!-- ToolTip: inverse chip (Sl.Component.Tooltip.*) with an optional keyboard shortcut (sl:Sl.Shortcut). -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Tooltip.Background.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Component.Tooltip.Foreground.Brush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sl.Component.Tooltip.Radius.Corner}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" TextWrapping="Wrap" />
            <Border Name="PART_Shortcut" Padding="4,0" CornerRadius="3" BorderThickness="1" Opacity="0.75" BorderBrush="{DynamicResource Sl.Component.Tooltip.Foreground.Brush}" VerticalAlignment="Center"
                    IsVisible="{Binding $parent[ToolTip].(slate:Sl.Shortcut), Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding $parent[ToolTip].(slate:Sl.Shortcut)}" FontFamily="{DynamicResource Sl.Font.Family.Mono}"
                         FontSize="11" Opacity="0.85" />
            </Border>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
