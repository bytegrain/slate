<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="using:Slate.Avalonia">
  <!--
    Alloy styling for native controls that keep Fluent's templates (their template parts are stable):
    Window, TextBox, ProgressBar, ScrollBar, ToolTip. Styles outrank ControlTheme setters.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!--
    TextBox (and the field of TextField), styled from Sl.Component.Field.*.
    Variant classes: (outlined) filled underlined. Sizes: small large. Radius: radius-* (Configuration.axaml).
  -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Field.Background.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.Border.Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sl.Component.Field.Radius.Corner}" />
    <Setter Property="MinHeight" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Sl.Component.Field.PaddingX.Inline}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Sl.Brush.Text.Placeholder}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Sl.Brush.Selection.Background}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Sl.Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{DynamicResource Sl.Component.Field.Shadow}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.BorderHover.Brush}" />
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.BorderFocus.Brush}" />
    <Setter Property="BorderThickness" Value="{Binding $parent[TextBox].BorderThickness}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Sl.Shadow.FocusRing}" />
  </Style>
  <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement, TextBox:error /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
  </Style>
  <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="{DynamicResource Sl.Shadow.FocusRingDanger}" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.Border.Brush}" />
  </Style>
  <Style Selector="TextBox[AcceptsReturn=True]">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MinHeight" Value="76" />
  </Style>

  <!-- filled: muted fill, border only on hover/focus -->
  <Style Selector="TextBox.filled">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Field.FilledBackground.Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.filled /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <!-- underlined: bottom border only; focus = 2px accent underline -->
  <Style Selector="TextBox.underlined">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="TextBox.underlined /template/ Border#PART_BorderElement">
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="TextBox.underlined:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>

  <Style Selector="TextBox.small">
    <Setter Property="MinHeight" Value="{DynamicResource Sl.Size.Control.Sm}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBox.large">
    <Setter Property="MinHeight" Value="{DynamicResource Sl.Size.Control.Lg}" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <!-- ProgressBar: pill track from Sl.Component.Progress.*; tone colours the fill; small 4px / large 10px. -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Component.Progress.Fill.Brush}" />
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Progress.Track.Brush}" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="ProgressBar.tone-neutral, ProgressBar.tone-success, ProgressBar.tone-warning, ProgressBar.tone-danger, ProgressBar.tone-info">
    <Setter Property="Foreground" Value="{Binding $self.(slate:Sl.ToneFill)}" />
  </Style>
  <Style Selector="ProgressBar:horizontal">
    <Setter Property="MinHeight" Value="{DynamicResource Sl.Component.Progress.Height}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Component.Progress.Height}" />
    <Setter Property="MinWidth" Value="80" />
  </Style>
  <Style Selector="ProgressBar:horizontal.small">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
  </Style>
  <Style Selector="ProgressBar:horizontal.large">
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="ProgressBar:vertical">
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Width" Value="6" />
  </Style>

  <!-- ScrollBar: quiet thumb in border.strong. -->
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Border.Strong}" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
  </Style>

  <!-- ToolTip: inverse chip. -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Inverse.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Inverse.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sl.CornerRadius.Md}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
</Styles>
