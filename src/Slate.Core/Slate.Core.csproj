<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Slate</RootNamespace>
    <PackageId>Slate.Core</PackageId>
    <Description>Platform-independent core of Slate: Alloy design tokens and the shared logic behind snackbars, dialogs and responsive layout used by Slate.Blazor, Slate.Wpf and Slate.Avalonia.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Self-explanatory members (enum values, obvious properties) are not required to carry XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Slate.Core.Tests" />
  </ItemGroup>
</Project>
