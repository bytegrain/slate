<!-- Default templates for Slate's own controls. Themed values are DynamicResource lookups into the
     dictionaries merged by SlateTheme (App.xaml). Shadows are drawn on a separate layer behind content so
     text keeps ClearType (WPF effects rasterise their subtree). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="clr-namespace:Slate.Wpf">

  <!-- ===== Shared pieces ===== -->

  <!-- Small button on inverse surfaces (snackbars, bulk bars). -->
  <Style x:Key="Sl.InverseButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Inverse.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <sl:Icon x:Name="Icon" Size="14" Kind="{Binding Path=(sl:Sl.StartIcon), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter x:Name="Label" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="sl:Sl.StartIcon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Inverse.TextMuted}" />
              <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="26" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Borderless TextBox used inside TextField's chrome. -->
  <Style x:Key="Sl.TextBox.Bare" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid Background="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            <TextBlock x:Name="Placeholder" Padding="2,0" IsHitTestVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Foreground="{DynamicResource Sl.Brush.Text.Placeholder}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                       Text="{Binding Path=(sl:Sl.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sl:Sl.Empty" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Borderless PasswordBox used inside TextField when InputType is Password. -->
  <Style x:Key="Sl.PasswordBox.Bare" TargetType="PasswordBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid Background="Transparent">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <TextBlock x:Name="Placeholder" Padding="2,0" IsHitTestVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                       Foreground="{DynamicResource Sl.Brush.Text.Placeholder}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                       Text="{Binding Path=(sl:Sl.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sl:Sl.Empty" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Layout ===== -->

  <Style TargetType="sl:Container">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Container">
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
            <ContentPresenter MaxWidth="{TemplateBinding ContentMaxWidth}" HorizontalAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Divider">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Border.Default}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Divider">
          <Border x:Name="Line" Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
              <Setter TargetName="Line" Property="Height" Value="Auto" />
              <Setter TargetName="Line" Property="Width" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:SectionHeader">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.2xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Padding" Value="8,10,8,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:SectionHeader">
          <ContentPresenter Margin="{TemplateBinding Padding}">
            <ContentPresenter.Resources>
              <Style TargetType="TextBlock">
                <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
              </Style>
            </ContentPresenter.Resources>
          </ContentPresenter>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Display ===== -->

  <Style TargetType="sl:Kbd">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Kbd">
          <Border CornerRadius="{DynamicResource Sl.CornerRadius.Xs}" Background="{DynamicResource Sl.Brush.Background.Surface}"
                  BorderBrush="{DynamicResource Sl.Brush.Border.Strong}" BorderThickness="1,1,1,2" Padding="5,0" Height="19" SnapsToDevicePixels="True">
            <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                       FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}" FontWeight="Normal" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Badge">
    <Setter Property="Background" Value="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Foreground" Value="{Binding Path=(sl:Sl.ChromeForeground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="BorderBrush" Value="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Component.Badge.Height}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Semibold}" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Badge">
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" SnapsToDevicePixels="True"
                  CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,5,0" Fill="{TemplateBinding Foreground}" Visibility="Collapsed" />
              <sl:Icon x:Name="Icon" Kind="{TemplateBinding Icon}" Size="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Dot" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="sl:Sl.ActualSize" Value="Small">
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.2xs}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="sl:Alert">
    <Setter Property="Background" Value="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="BorderBrush" Value="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Foreground" Value="{Binding Path=(sl:Sl.ChromeForeground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Padding" Value="{DynamicResource Sl.Component.Alert.Padding.Thickness}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Alert">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                  CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <sl:Icon x:Name="Icon" Kind="{TemplateBinding ActualIcon}" Size="18" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{TemplateBinding Foreground}" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" TextWrapping="Wrap"
                           Foreground="{Binding Path=(sl:Sl.StrongForeground), RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter TextElement.Foreground="{Binding Path=(sl:Sl.MutedForeground), RelativeSource={RelativeSource TemplatedParent}}">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </StackPanel>
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding Actions}" Margin="12,0,0,0" VerticalAlignment="Center" />
              <Button x:Name="PART_Close" Grid.Column="3" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x" sl:Sl.IconOnly="True"
                      sl:Sl.Label="Dismiss" Margin="8,-3,-6,-3" VerticalAlignment="Top" Visibility="Collapsed"
                      Foreground="{Binding Path=(sl:Sl.StrongForeground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActualIcon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Dismissible" Value="True">
              <Setter TargetName="PART_Close" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Dense" Value="True">
              <Setter TargetName="Icon" Property="Size" Value="16" />
              <Setter TargetName="Icon" Property="Margin" Value="0,1,8,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Dense" Value="True">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="sl:Card">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Card.Background.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.Card.Border.Brush}" />
    <Setter Property="Padding" Value="{DynamicResource Sl.Component.Card.Padding.Thickness}" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Card">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Shadow" Background="{TemplateBinding Background}" Effect="{DynamicResource Sl.Component.Card.Shadow.Effect}"
                    CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
              <DockPanel>
                <Border x:Name="HeaderBar" DockPanel.Dock="Top" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,10,12,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TitleBlock" VerticalAlignment="Center">
                      <TextBlock x:Name="Title" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                 FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" FontSize="{DynamicResource Sl.Font.Size.Md}" />
                      <TextBlock x:Name="Subtitle" Text="{TemplateBinding Subtitle}" TextWrapping="Wrap"
                                 FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                    </StackPanel>
                    <ContentPresenter x:Name="CustomHeader" ContentSource="Header" VerticalAlignment="Center" Visibility="Collapsed" />
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding HeaderActions}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Background="{DynamicResource Sl.Brush.Background.Subtle}"
                        BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,10"
                        CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerPartConverter.Instance}, ConverterParameter=Bottom}">
                  <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
                </Border>
                <ContentPresenter x:Name="Body" Margin="{TemplateBinding Padding}" />
              </DockPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Subtitle" Value="{x:Null}">
              <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasHeader" Value="True">
              <Setter TargetName="CustomHeader" Property="Visibility" Value="Visible" />
              <Setter TargetName="TitleBlock" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasHeader" Value="False" />
                <Condition Property="Title" Value="{x:Null}" />
                <Condition Property="Subtitle" Value="{x:Null}" />
                <Condition Property="HeaderActions" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="HeaderBar" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="Footer" Value="{x:Null}">
              <Setter TargetName="FooterBar" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Flush" Value="True">
              <Setter TargetName="Body" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="ActualVariant" Value="Outlined">
              <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActualVariant" Value="Flat">
              <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Transparent}" />
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Sl.Brush.Background.Subtle}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Interactive" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Shadow" Property="Effect" Value="{DynamicResource Sl.Component.Card.HoverShadow.Effect}" />
              <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
              <Setter Property="Cursor" Value="Hand" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Toolbar">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Toolbar">
          <Grid>
            <Border CornerRadius="{DynamicResource Sl.CornerRadius.Lg}" Background="{DynamicResource Sl.Brush.Background.Surface}" Effect="{DynamicResource Sl.Effect.E1}" />
            <Border CornerRadius="{DynamicResource Sl.CornerRadius.Lg}" Background="{DynamicResource Sl.Brush.Background.Surface}"
                    BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1" Padding="3">
              <ItemsPresenter />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:ToolbarSeparator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:ToolbarSeparator">
          <Border Width="1" Height="18" Margin="4,0" VerticalAlignment="Center" Background="{DynamicResource Sl.Brush.Border.Default}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Inputs ===== -->

  <Style TargetType="sl:TextField">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:TextField">
          <StackPanel>
            <StackPanel x:Name="LabelRow" Orientation="Horizontal" Margin="0,0,0,6">
              <Label Content="{TemplateBinding Label}" Target="{Binding ElementName=PART_TextBox}" />
              <TextBlock x:Name="RequiredMark" Text=" *" Foreground="{DynamicResource Sl.Brush.Status.Danger.Fg}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}"
                         Visibility="Collapsed" AutomationProperties.Name="required" />
            </StackPanel>
            <Grid x:Name="Field" Height="{DynamicResource Sl.Size.Control.Md}" SnapsToDevicePixels="True">
              <Border x:Name="Ring" Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Focus.Ring}" Visibility="Collapsed"
                      CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerInflateConverter.Instance}, ConverterParameter=4}">
                <Border BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Background.Canvas}"
                        CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerInflateConverter.Instance}, ConverterParameter=2}" />
              </Border>
              <Border x:Name="Chrome" BorderThickness="1" ClipToBounds="True"
                      Background="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      BorderBrush="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource TemplatedParent}}"
                      CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                <Grid>
                  <Border x:Name="InsetShade" Height="1" VerticalAlignment="Top" Margin="3,0" Background="{DynamicResource Sl.Brush.Effect.Shade}" />
                  <DockPanel>
                    <Border x:Name="PrefixBox" DockPanel.Dock="Left" Background="{DynamicResource Sl.Brush.Background.Subtle}"
                            BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,1,0" Padding="10,0">
                      <TextBlock Text="{TemplateBinding Prefix}" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}"
                                 FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.Xs}" />
                    </Border>
                    <Border x:Name="SuffixBox" DockPanel.Dock="Right" Background="{DynamicResource Sl.Brush.Background.Subtle}"
                            BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1,0,0,0" Padding="10,0">
                      <TextBlock Text="{TemplateBinding Suffix}" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}"
                                 FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.Xs}" />
                    </Border>
                    <ContentPresenter x:Name="EndContentHost" DockPanel.Dock="Right" Content="{TemplateBinding EndContent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <sl:Icon x:Name="EndIconGlyph" DockPanel.Dock="Right" Kind="{TemplateBinding EndIcon}" Margin="0,0,10,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                    <Button x:Name="PART_Clear" DockPanel.Dock="Right" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x" sl:Sl.IconOnly="True"
                            sl:Sl.Label="Clear" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" Focusable="False" />
                    <ContentPresenter x:Name="StartContentHost" DockPanel.Dock="Left" Content="{TemplateBinding StartContent}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <sl:Icon x:Name="StartIconGlyph" DockPanel.Dock="Left" Kind="{TemplateBinding StartIcon}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                    <Grid>
                      <TextBox x:Name="PART_TextBox" Style="{StaticResource Sl.TextBox.Bare}"
                               Margin="{Binding Path=(sl:Sl.PaddingX), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:HorizontalThicknessConverter.Instance}, ConverterParameter=-2}"
                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                               IsReadOnly="{TemplateBinding ReadOnly}" FontSize="{TemplateBinding FontSize}"
                               MaxLength="{Binding MaxLength, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=0}"
                               sl:Sl.Placeholder="{TemplateBinding Placeholder}" />
                      <PasswordBox x:Name="PART_PasswordBox" Style="{StaticResource Sl.PasswordBox.Bare}" Visibility="Collapsed"
                                   Margin="{Binding Path=(sl:Sl.PaddingX), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:HorizontalThicknessConverter.Instance}, ConverterParameter=-2}"
                                   FontSize="{TemplateBinding FontSize}"
                                   MaxLength="{Binding MaxLength, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=0}"
                                   sl:Sl.Placeholder="{TemplateBinding Placeholder}" />
                    </Grid>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
            <Grid x:Name="HelperRow" Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <sl:Icon x:Name="ErrorIcon" Kind="alert-circle" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Sl.Brush.Status.Danger.Fg}" Visibility="Collapsed" />
                <TextBlock x:Name="Helper" Text="{TemplateBinding HelperText}" TextWrapping="Wrap"
                           FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
              </StackPanel>
              <TextBlock x:Name="CounterText" Grid.Column="1" Text="{TemplateBinding CounterText}" Margin="12,0,0,0" Visibility="Collapsed"
                         FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Required" Value="True">
              <Setter TargetName="RequiredMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Prefix" Value="{x:Null}">
              <Setter TargetName="PrefixBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Suffix" Value="{x:Null}">
              <Setter TargetName="SuffixBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="StartIcon" Value="{x:Null}">
              <Setter TargetName="StartIconGlyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="EndIcon" Value="{x:Null}">
              <Setter TargetName="EndIconGlyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="StartContent" Value="{x:Null}">
              <Setter TargetName="StartContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="EndContent" Value="{x:Null}">
              <Setter TargetName="EndContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding StartContent, RelativeSource={RelativeSource Self}, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True">
              <Setter TargetName="StartIconGlyph" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EndContent, RelativeSource={RelativeSource Self}, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True">
              <Setter TargetName="EndIconGlyph" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="ShowClear" Value="True">
              <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HelperText" Value="{x:Null}" />
                <Condition Property="Counter" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="HelperRow" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="Counter" Value="True">
              <Setter TargetName="CounterText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="InputType" Value="Password">
              <Setter TargetName="PART_TextBox" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Small">
              <Setter TargetName="Field" Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Large">
              <Setter TargetName="Field" Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Lg}" />
            </Trigger>
            <Trigger Property="Multiline" Value="True">
              <Setter TargetName="Field" Property="Height" Value="Auto" />
              <Setter TargetName="Field" Property="MinHeight" Value="76" />
              <Setter TargetName="PART_TextBox" Property="AcceptsReturn" Value="True" />
              <Setter TargetName="PART_TextBox" Property="TextWrapping" Value="Wrap" />
              <Setter TargetName="PART_TextBox" Property="VerticalContentAlignment" Value="Top" />
              <Setter TargetName="PART_TextBox" Property="VerticalScrollBarVisibility" Value="Auto" />
              <Setter TargetName="PART_TextBox" Property="MinLines" Value="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="PART_TextBox" Property="Margin" Value="8,7" />
            </Trigger>
            <Trigger Property="ActualVariant" Value="Filled">
              <Setter TargetName="InsetShade" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ActualVariant" Value="Underlined">
              <Setter TargetName="InsetShade" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="0,0,0,1" />
              <Setter TargetName="PrefixBox" Property="Background" Value="{DynamicResource Sl.Brush.Transparent}" />
              <Setter TargetName="SuffixBox" Property="Background" Value="{DynamicResource Sl.Brush.Transparent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Path=(sl:Sl.HoverBorder), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="ReadOnly" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Sl.Brush.Background.Subtle}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.BorderFocus.Brush}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                <Condition Property="ActualVariant" Value="Underlined" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chrome" Property="BorderThickness" Value="0,0,0,2" />
            </MultiTrigger>
            <Trigger Property="HasError" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
              <Setter TargetName="HelperRow" Property="Visibility" Value="Visible" />
              <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="Helper" Property="Text" Value="{Binding Error, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Helper" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Field" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Switch">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Switch">
          <Grid x:Name="Root" Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="TrackColumn" Width="Auto" />
              <ColumnDefinition x:Name="LabelColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TrackSite" Width="{DynamicResource Sl.Component.Selection.SwitchWidth}" Height="{DynamicResource Sl.Component.Selection.SwitchHeight}"
                  Margin="0,1,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" SnapsToDevicePixels="True">
              <Border x:Name="Track" CornerRadius="{DynamicResource Sl.CornerRadius.Full}" Background="{DynamicResource Sl.Brush.Control.Track}"
                      BorderThickness="1" BorderBrush="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource TemplatedParent}}">
                <Border Height="1" VerticalAlignment="Top" Margin="5,0" Background="{DynamicResource Sl.Brush.Effect.Shade}" />
              </Border>
              <Border x:Name="Thumb" Width="{DynamicResource Sl.Component.Selection.ThumbSize}" Height="{DynamicResource Sl.Component.Selection.ThumbSize}"
                      CornerRadius="{DynamicResource Sl.CornerRadius.Full}" HorizontalAlignment="Left" Margin="2"
                      BorderBrush="{DynamicResource Sl.Brush.Effect.Shade}" BorderThickness="0,0,0,1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{DynamicResource Sl.Color.Control.Thumb}" />
                    <GradientStop Offset="1" Color="{DynamicResource Sl.Color.Control.ThumbShade}" />
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                  <TranslateTransform>
                    <TranslateTransform.X>
                      <MultiBinding Converter="{x:Static sl:MultiplyConverter.Instance}">
                        <Binding Path="ThumbPosition" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ThumbTravel" RelativeSource="{RelativeSource TemplatedParent}" />
                      </MultiBinding>
                    </TranslateTransform.X>
                  </TranslateTransform>
                </Border.RenderTransform>
              </Border>
            </Grid>
            <StackPanel x:Name="LabelStack" Grid.Column="1" VerticalAlignment="Center">
              <ContentPresenter x:Name="ContentHost" RecognizesAccessKey="True" />
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Visibility="Collapsed" />
              <TextBlock x:Name="Description" Text="{TemplateBinding Description}" TextWrapping="Wrap"
                         FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="{x:Null}">
              <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Content" Value="{x:Null}" />
                <Condition Property="HasLabel" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="LabelText" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Content" Value="{x:Null}" />
                <Condition Property="HasLabel" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TrackSite" Property="Margin" Value="0" />
            </MultiTrigger>
            <Trigger Property="sl:Sl.ActualLabelPlacement" Value="Start">
              <Setter TargetName="TrackColumn" Property="Width" Value="*" />
              <Setter TargetName="LabelColumn" Property="Width" Value="Auto" />
              <Setter TargetName="TrackSite" Property="Grid.Column" Value="1" />
              <Setter TargetName="TrackSite" Property="Margin" Value="10,1,0,0" />
              <Setter TargetName="LabelStack" Property="Grid.Column" Value="0" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Spread" Value="True" />
                <Condition Property="sl:Sl.ActualLabelPlacement" Value="Start" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TrackColumn" Property="Width" Value="Auto" />
              <Setter TargetName="LabelColumn" Property="Width" Value="*" />
              <Setter TargetName="TrackSite" Property="HorizontalAlignment" Value="Right" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Spread" Value="True" />
                <Condition Property="sl:Sl.ActualLabelPlacement" Value="End" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TrackColumn" Property="Width" Value="*" />
              <Setter TargetName="LabelColumn" Property="Width" Value="Auto" />
            </MultiTrigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Small">
              <Setter TargetName="TrackSite" Property="Width" Value="28" />
              <Setter TargetName="TrackSite" Property="Height" Value="16" />
              <Setter TargetName="Thumb" Property="Width" Value="12" />
              <Setter TargetName="Thumb" Property="Height" Value="12" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Large">
              <Setter TargetName="TrackSite" Property="Width" Value="44" />
              <Setter TargetName="TrackSite" Property="Height" Value="24" />
              <Setter TargetName="Thumb" Property="Width" Value="20" />
              <Setter TargetName="Thumb" Property="Height" Value="20" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Lg}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{Binding Path=(sl:Sl.Fill), RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{Binding Path=(sl:Sl.Fill), RelativeSource={RelativeSource TemplatedParent}}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(sl:Switch.ThumbPosition)" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="(sl:Switch.ThumbPosition)" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:RadioGroup">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <sl:Stack Spacing="2" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:RadioGroup">
          <StackPanel>
            <Label x:Name="Legend" Content="{TemplateBinding Label}" Margin="0,0,0,8" />
            <ItemsPresenter />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="Legend" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Direction" Value="Row">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <sl:Stack Direction="Row" Spacing="4" Wrap="True" />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Shell ===== -->

  <Style TargetType="sl:AppBar">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.AppBar.Background.Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.AppBar.Border.Brush}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Component.AppBar.Height}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:AppBar">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0,12,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="Nav" sl:Sl.Variant="Ghost" sl:Sl.StartIcon="menu" sl:Sl.IconOnly="True" sl:Sl.Label="Toggle navigation"
                      Command="{x:Static sl:AppShell.ToggleDrawerCommand}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Leading}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock x:Name="TitleText" Grid.Column="2" Text="{TemplateBinding Title}" VerticalAlignment="Center" Margin="4,0,16,0"
                         FontSize="{DynamicResource Sl.Font.Size.Lg}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" />
              <ContentPresenter Grid.Column="3" Content="{TemplateBinding Center}" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="4" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowMenuButton" Value="False">
              <Setter TargetName="Nav" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Title" Value="{x:Null}">
              <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:AppShell">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Canvas}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:AppShell">
          <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{TemplateBinding AppBar}" Panel.ZIndex="3" />
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="Main" Grid.Column="1" />
              <Border x:Name="PART_Scrim" Grid.ColumnSpan="2" Background="{DynamicResource Sl.Brush.Scrim}" Visibility="Collapsed" Panel.ZIndex="1" />
              <Grid x:Name="DrawerPane" Width="{DynamicResource Sl.Component.Drawer.Width}" HorizontalAlignment="Left" Panel.ZIndex="2">
                <Border x:Name="DrawerShadow" Background="{DynamicResource Sl.Component.Drawer.Background.Brush}" Effect="{DynamicResource Sl.Effect.E3}" Visibility="Collapsed" />
                <Border Background="{DynamicResource Sl.Component.Drawer.Background.Brush}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,1,0">
                  <ContentPresenter Content="{TemplateBinding Drawer}" />
                </Border>
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="DrawerOpen" Value="False">
              <Setter TargetName="DrawerPane" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sl:AppShell.Mini" Value="True">
              <Setter TargetName="DrawerPane" Property="Width" Value="{DynamicResource Sl.Component.Drawer.MiniWidth}" />
            </Trigger>
            <Trigger Property="Overlay" Value="True">
              <Setter TargetName="Main" Property="Grid.Column" Value="0" />
              <Setter TargetName="Main" Property="Grid.ColumnSpan" Value="2" />
              <Setter TargetName="DrawerShadow" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Overlay" Value="True" />
                <Condition Property="DrawerOpen" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Scrim" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:NavItem">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:NavItem">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Lift" CornerRadius="{DynamicResource Sl.Component.Drawer.ItemRadius.Corner}" Background="{DynamicResource Sl.Component.Drawer.ActiveItem.Brush}"
                    Effect="{DynamicResource Sl.Effect.E1}" Visibility="Collapsed" />
            <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.Component.Drawer.ItemRadius.Corner}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="8,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <sl:Icon x:Name="Icon" Kind="{TemplateBinding Icon}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ContentPresenter x:Name="Label" Grid.Column="1" VerticalAlignment="Center" />
                <ContentPresenter x:Name="Trailing" Grid.Column="2" Content="{TemplateBinding Trailing}" VerticalAlignment="Center"
                                  TextElement.FontFamily="{DynamicResource Sl.Font.Family.Mono}" TextElement.FontSize="{DynamicResource Sl.Font.Size.2xs}"
                                  TextElement.Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Lift" Property="Visibility" Value="Visible" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Component.Drawer.ActiveItem.Brush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Default}" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
              <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
            </Trigger>
            <Trigger Property="sl:AppShell.Mini" Value="True">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Trailing" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Icon" Property="Margin" Value="0" />
              <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Title-bar window buttons: 46x36, neutral; close turns danger. -->
  <Style x:Key="Sl.WindowButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Titlebar}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Pressed}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sl.WindowCloseButton" TargetType="Button" BasedOn="{StaticResource Sl.WindowButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Solid}" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.OnSolid}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:SlateWindow">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:SlateWindow">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Sl.Brush.Border.Strong}" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Height="{DynamicResource Sl.Size.Titlebar}" Background="{DynamicResource Sl.Brush.Background.Surface}"
                      BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="12,0,16,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Sl.Brush.Text.Primary}">
                      <sl:Icon Kind="{TemplateBinding AppIcon}" Size="13" Foreground="{DynamicResource Sl.Brush.Background.Surface}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Sl.Font.Size.Sm}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" />
                  </StackPanel>
                  <ContentPresenter Grid.Column="1" Content="{TemplateBinding TitleBarContent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                  <ContentPresenter Grid.Column="2" Content="{TemplateBinding TitleBarActions}" VerticalAlignment="Center" Margin="0,0,8,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="Minimize" Style="{StaticResource Sl.WindowButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" AutomationProperties.Name="Minimize">
                      <Path Data="M0 5 L10 5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="PART_Maximize" Style="{StaticResource Sl.WindowButton}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" AutomationProperties.Name="Maximize">
                      <Path x:Name="MaxGlyph" Data="M0.5 0.5 L9.5 0.5 L9.5 9.5 L0.5 9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="Close" Style="{StaticResource Sl.WindowCloseButton}" Command="{x:Static SystemCommands.CloseWindowCommand}" AutomationProperties.Name="Close">
                      <Path Data="M0 0 L10 10 M10 0 L0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <AdornerDecorator>
                  <ContentPresenter />
                </AdornerDecorator>
                <sl:DialogHost Service="{TemplateBinding DialogService}" />
                <sl:SnackbarHost Service="{TemplateBinding SnackbarService}" Margin="16" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="Frame" Property="Margin" Value="{x:Static sl:SlateWindow.MaximizedPadding}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
              <Setter TargetName="PART_Maximize" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
              <Setter TargetName="PART_Maximize" Property="AutomationProperties.Name" Value="Restore" />
              <Setter TargetName="MaxGlyph" Property="Data" Value="M2.5 2.5 L9.5 2.5 L9.5 9.5 L2.5 9.5 Z M2.5 0.5 L2.5 0.5 M0.5 7.5 L0.5 0.5 L7.5 0.5" />
            </Trigger>
            <Trigger Property="IsMaximizeHovered" Value="True">
              <Setter TargetName="PART_Maximize" Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
            </Trigger>
            <Trigger Property="IsActive" Value="False">
              <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </Trigger>
            <Trigger Property="ResizeMode" Value="NoResize">
              <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Minimize" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ResizeMode" Value="CanMinimize">
              <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Systems ===== -->

  <Style TargetType="sl:SnackbarHost">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:SnackbarHost">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:SnackbarItem">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Component.Snackbar.Foreground.Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:SnackbarItem">
          <Grid MinWidth="{DynamicResource Sl.Size.Snackbar.Min}" MaxWidth="{DynamicResource Sl.Size.Snackbar.Max}" Margin="0,4">
            <Border CornerRadius="{DynamicResource Sl.Component.Snackbar.Radius.Corner}" Background="{DynamicResource Sl.Component.Snackbar.Background.Brush}" Effect="{DynamicResource Sl.Component.Snackbar.Shadow.Effect}" />
            <Border CornerRadius="{DynamicResource Sl.Component.Snackbar.Radius.Corner}" Background="{DynamicResource Sl.Component.Snackbar.Background.Brush}" ClipToBounds="True">
              <Grid>
                <Grid Margin="12,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Tile" Width="18" Height="18" CornerRadius="5" Margin="0,1,10,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <sl:Icon x:Name="Glyph" Size="12" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Title" Text="{Binding Options.Title}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" TextWrapping="Wrap" />
                    <TextBlock x:Name="Message" Text="{Binding Message}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="PART_Action" Grid.Column="2" Style="{StaticResource Sl.InverseButton}" Content="{Binding Options.Action.Label}"
                          Margin="12,0,0,0" VerticalAlignment="Center" />
                  <Button x:Name="PART_Close" Grid.Column="3" Style="{StaticResource Sl.InverseButton}" sl:Sl.StartIcon="x"
                          AutomationProperties.Name="Dismiss notification" Margin="4,0,-4,0" VerticalAlignment="Center" />
                </Grid>
                <Rectangle x:Name="PART_Progress" Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Sl.Component.Snackbar.Timer.Brush}" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Options.Title}" Value="{x:Null}">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Options.Action}" Value="{x:Null}">
              <Setter TargetName="PART_Action" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Options.ShowCloseButton}" Value="False">
              <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Options.Title, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Sl.Component.Snackbar.Muted.Brush}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Success">
              <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Success.Solid}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Success.OnSolid}" />
              <Setter TargetName="Glyph" Property="Kind" Value="check" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Info">
              <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Info.Solid}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Info.OnSolid}" />
              <Setter TargetName="Glyph" Property="Kind" Value="info" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
              <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Warning.Solid}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Warning.OnSolid}" />
              <Setter TargetName="Glyph" Property="Kind" Value="alert-triangle" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
              <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Solid}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.OnSolid}" />
              <Setter TargetName="Glyph" Property="Kind" Value="x" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:DialogHost">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:DialogHost">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:DialogFrame">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:DialogFrame">
          <Grid>
            <Border x:Name="PART_Scrim" Background="{DynamicResource Sl.Component.Dialog.Scrim.Brush}" />
            <Grid x:Name="PART_Panel" Margin="32" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                  KeyboardNavigation.DirectionalNavigation="Contained" Focusable="True" FocusVisualStyle="{x:Null}">
              <Border CornerRadius="{DynamicResource Sl.Component.Dialog.Radius.Corner}" Background="{DynamicResource Sl.Component.Dialog.Background.Brush}"
                      Effect="{DynamicResource Sl.Component.Dialog.Shadow.Effect}" />
              <Border CornerRadius="{DynamicResource Sl.Component.Dialog.Radius.Corner}" Background="{DynamicResource Sl.Component.Dialog.Background.Brush}"
                      BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                  <Grid x:Name="Header" DockPanel.Dock="Top" Margin="20,16,12,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Tile" Width="36" Height="36" CornerRadius="{DynamicResource Sl.CornerRadius.Lg}" Margin="0,0,14,0" VerticalAlignment="Top"
                            Background="{Binding Path=(sl:Sl.Fill), RelativeSource={RelativeSource TemplatedParent}}">
                      <sl:Icon Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Kind="{Binding EffectiveOptions.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                               Foreground="{Binding Path=(sl:Sl.OnFill), RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding EffectiveOptions.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                 FontSize="{DynamicResource Sl.Font.Size.Lg}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" TextWrapping="Wrap" />
                      <TextBlock x:Name="Description" Text="{Binding EffectiveOptions.Description, RelativeSource={RelativeSource TemplatedParent}}"
                                 Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Sl.Brush.Text.Secondary}" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x" sl:Sl.IconOnly="True"
                            sl:Sl.Label="Close dialog" Command="{x:Static sl:DialogCommands.Cancel}" VerticalAlignment="Top" />
                  </Grid>
                  <ContentPresenter x:Name="Body" Margin="20,12,20,20" />
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowHeader" Value="False">
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Body" Property="Margin" Value="0" />
            </Trigger>
            <DataTrigger Binding="{Binding EffectiveOptions.Icon, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
              <Setter TargetName="Tile" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EffectiveOptions.Description, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
              <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EffectiveOptions.ShowCloseButton, RelativeSource={RelativeSource Self}}" Value="False">
              <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static sl:IsDialogContentConverter.Instance}}" Value="True">
              <Setter TargetName="Body" Property="Margin" Value="0,4,0,0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:DialogContent">
    <Setter Property="Padding" Value="20,12,20,20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:DialogContent">
          <DockPanel>
            <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Background="{DynamicResource Sl.Component.Dialog.Footer.Brush}"
                    BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="20,12">
              <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </ScrollViewer>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Footer" Value="{x:Null}">
              <Setter TargetName="FooterBar" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Message box / confirmation: icon tile + title + message, footer with Cancel then the confirm action last. -->
  <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type sl:DialogHost}, ResourceId=MessageBoxTemplate}">
    <StackPanel>
      <Grid Margin="20,20,20,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Tile" Width="36" Height="36" CornerRadius="9" Margin="0,0,14,0" VerticalAlignment="Top" Visibility="Collapsed">
          <sl:Icon x:Name="TileIcon" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="{DynamicResource Sl.Font.Size.Lg}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Sl.Brush.Text.Secondary}" />
        </StackPanel>
      </Grid>
      <Border Background="{DynamicResource Sl.Component.Dialog.Footer.Brush}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="20,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="Cancel" Content="{Binding CancelText}" Command="{x:Static sl:DialogCommands.Cancel}" Margin="0,0,8,0" />
          <Button x:Name="Confirm" Content="{Binding ConfirmText}" Command="{x:Static sl:DialogCommands.Ok}" IsDefault="True" sl:Sl.Variant="Solid" sl:Sl.Tone="Accent" />
        </StackPanel>
      </Border>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
        <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding CancelText}" Value="{x:Null}">
        <Setter TargetName="Cancel" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="Info">
        <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Info.Bg}" />
        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Info.Fg}" />
        <Setter TargetName="TileIcon" Property="Kind" Value="info" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="Success">
        <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Success.Bg}" />
        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Success.Fg}" />
        <Setter TargetName="TileIcon" Property="Kind" Value="check-circle" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="Warning">
        <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Warning.Bg}" />
        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Warning.Fg}" />
        <Setter TargetName="TileIcon" Property="Kind" Value="alert-triangle" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Severity}" Value="Error">
        <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Bg}" />
        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
        <Setter TargetName="TileIcon" Property="Kind" Value="alert-circle" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Destructive}" Value="True">
        <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Bg}" />
        <Setter TargetName="TileIcon" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
        <Setter TargetName="TileIcon" Property="Kind" Value="alert-triangle" />
        <Setter TargetName="Confirm" Property="sl:Sl.Tone" Value="Danger" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ======================= Wave 2: overlays, navigation, pickers, collections ======================= -->

  <!-- Raised overlay panel (popover tokens): shadow on its own layer so text keeps ClearType. -->
  <ControlTemplate x:Key="Sl.OverlayPanel" TargetType="ContentControl">
    <Grid Margin="8,4,8,16">
      <Border CornerRadius="{DynamicResource Sl.Component.Popover.Radius.Corner}" Background="{DynamicResource Sl.Component.Popover.Background.Brush}"
              Effect="{DynamicResource Sl.Component.Popover.Shadow.Effect}" />
      <Border CornerRadius="{DynamicResource Sl.Component.Popover.Radius.Corner}" Background="{DynamicResource Sl.Component.Popover.Background.Brush}"
              BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1" Padding="{DynamicResource Sl.Component.Popover.Padding.Thickness}"
              TextElement.Foreground="{DynamicResource Sl.Brush.Text.Primary}" TextElement.FontFamily="{DynamicResource Sl.Font.Family.Ui}"
              TextElement.FontSize="{DynamicResource Sl.Font.Size.Md}">
        <ContentPresenter />
      </Border>
    </Grid>
  </ControlTemplate>

  <Style TargetType="sl:Popover">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Popover">
          <Grid>
            <ContentPresenter x:Name="PART_Anchor" Content="{TemplateBinding Anchor}" />
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <ContentControl Template="{StaticResource Sl.OverlayPanel}" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="Continue">
                <ContentPresenter x:Name="PART_Panel" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="8" />
              </ContentControl>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Tooltip">
    <Setter Property="Background" Value="{DynamicResource Sl.Component.Tooltip.Background.Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Component.Tooltip.Foreground.Brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Tooltip">
          <Grid Margin="4">
            <Border CornerRadius="{DynamicResource Sl.Component.Tooltip.Radius.Corner}" Background="{TemplateBinding Background}" Effect="{DynamicResource Sl.Effect.E2}" />
            <Border CornerRadius="{DynamicResource Sl.Component.Tooltip.Radius.Corner}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" TextElement.Foreground="{TemplateBinding Foreground}">
                <TextBlock x:Name="TextHost" Text="{TemplateBinding Text}" VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap" />
                <ContentPresenter x:Name="ContentHost" VerticalAlignment="Center" />
                <Border x:Name="ShortcutBox" Margin="8,0,-2,0" CornerRadius="{DynamicResource Sl.CornerRadius.Xs}" BorderThickness="1"
                        BorderBrush="{DynamicResource Sl.Brush.Inverse.TextMuted}" Padding="4,0" VerticalAlignment="Center">
                  <TextBlock Text="{TemplateBinding Shortcut}" FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}"
                             Foreground="{DynamicResource Sl.Brush.Inverse.TextMuted}" />
                </Border>
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True">
              <Setter TargetName="TextHost" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="Shortcut" Value="{x:Null}">
              <Setter TargetName="ShortcutBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Menu">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Menu">
          <ContentPresenter x:Name="PART_Trigger" Content="{TemplateBinding Trigger}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Tabs ===== -->

  <Style TargetType="sl:Tabs">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Tabs">
          <DockPanel KeyboardNavigation.TabNavigation="Local" LastChildFill="True">
            <Border x:Name="Strip" DockPanel.Dock="Top" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,0,1">
              <ScrollViewer x:Name="StripScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="Transparent" />
              </ScrollViewer>
            </Border>
            <Border x:Name="ContentBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}"
                    BorderThickness="0" Padding="0,16,0,0" KeyboardNavigation.TabIndex="2">
              <Grid>
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                <Grid x:Name="PART_KeepAliveHost" />
              </Grid>
            </Border>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Direction" Value="Column">
              <Setter TargetName="Strip" Property="DockPanel.Dock" Value="Left" />
              <Setter TargetName="Strip" Property="BorderThickness" Value="0,0,1,0" />
              <Setter TargetName="StripScroll" Property="HorizontalScrollBarVisibility" Value="Disabled" />
              <Setter TargetName="StripScroll" Property="VerticalScrollBarVisibility" Value="Auto" />
              <Setter TargetName="ContentBorder" Property="Padding" Value="20,0,0,0" />
            </Trigger>
            <Trigger Property="Variant" Value="Pills">
              <Setter TargetName="Strip" Property="BorderThickness" Value="0" />
              <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Sl.Component.Tabs.PillBackground.Brush}" />
              <Setter TargetName="Strip" Property="CornerRadius" Value="{DynamicResource Sl.CornerRadius.Lg}" />
              <Setter TargetName="Strip" Property="Padding" Value="3" />
              <Setter TargetName="Strip" Property="HorizontalAlignment" Value="Left" />
            </Trigger>
            <Trigger Property="Variant" Value="Enclosed">
              <Setter TargetName="ContentBorder" Property="BorderThickness" Value="1,0,1,1" />
              <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
              <Setter TargetName="ContentBorder" Property="Padding" Value="16" />
              <Setter TargetName="ContentBorder" Property="CornerRadius" Value="0,0,8,8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Tab">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Tab">
          <Grid x:Name="Root" SnapsToDevicePixels="True" Background="Transparent">
            <Border x:Name="Pill" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="Transparent" BorderThickness="0" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
              <sl:Icon x:Name="IconGlyph" Kind="{TemplateBinding Icon}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" VerticalAlignment="Center" />
              <ContentPresenter x:Name="HeaderHost" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <Border x:Name="BadgeBox" Margin="6,0,0,0" CornerRadius="9" Background="{DynamicResource Sl.Brush.Background.Muted}" Padding="6,0" VerticalAlignment="Center">
                <TextBlock Text="{TemplateBinding Badge}" FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}"
                           Foreground="{DynamicResource Sl.Brush.Text.Secondary}" />
              </Border>
              <Button x:Name="PART_Close" Margin="4,0,-6,0" Width="20" Height="20" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x"
                      sl:Sl.IconOnly="True" sl:Sl.Label="Close tab" Focusable="False" Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="Indicator" Height="{DynamicResource Sl.Component.Tabs.IndicatorHeight}" VerticalAlignment="Bottom" Margin="8,0,8,-1"
                    Background="{DynamicResource Sl.Component.Tabs.Indicator.Brush}" Visibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Label, RelativeSource={RelativeSource Self}, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True">
              <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="Badge" Value="{x:Null}">
              <Setter TargetName="BadgeBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Closable" Value="True">
              <Setter TargetName="PART_Close" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="ActualVariant" Value="Line" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="ActualVariant" Value="Pills" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
              <Setter TargetName="Pill" Property="Effect" Value="{DynamicResource Sl.Effect.Control}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="ActualVariant" Value="Enclosed" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Default}" />
              <Setter TargetName="Pill" Property="BorderThickness" Value="1,1,1,0" />
              <Setter TargetName="Pill" Property="CornerRadius" Value="8,8,0,0" />
              <Setter TargetName="Pill" Property="Margin" Value="0,0,0,-1" />
            </MultiTrigger>
            <Trigger Property="TabStripPlacement" Value="Left">
              <Setter TargetName="Indicator" Property="VerticalAlignment" Value="Stretch" />
              <Setter TargetName="Indicator" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Indicator" Property="Height" Value="NaN" />
              <Setter TargetName="Indicator" Property="Width" Value="2" />
              <Setter TargetName="Indicator" Property="Margin" Value="0,4,-1,4" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Small">
              <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Large">
              <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Breadcrumbs, pagination, segmented ===== -->

  <Style TargetType="sl:Breadcrumbs">
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Breadcrumbs">
          <ItemsControl ItemsSource="{TemplateBinding Entries}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <sl:Icon x:Name="Sep" Size="14" Margin="2,0" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}"
                           Kind="{Binding Separator, RelativeSource={RelativeSource AncestorType=sl:Breadcrumbs}}" />
                  <Button x:Name="Link" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="{Binding Icon}" Content="{Binding Label}" />
                  <TextBlock x:Name="Current" Text="{Binding Label}" Margin="8,0" VerticalAlignment="Center" Visibility="Collapsed"
                             FontWeight="{DynamicResource Sl.Font.Weight.Medium}" Foreground="{DynamicResource Sl.Brush.Text.Primary}" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ShowSeparator}" Value="False">
                    <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Link" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Current" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                    <Setter TargetName="Link" Property="sl:Sl.Label" Value="Show hidden path items" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Pagination">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Pagination">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Range" Text="{TemplateBinding RangeText}" VerticalAlignment="Center" Margin="0,0,16,0"
                       FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            <ComboBox x:Name="PART_PageSize" ItemsSource="{TemplateBinding PageSizes}" Margin="0,0,12,0" MinWidth="72" VerticalAlignment="Center"
                      SelectedItem="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="Rows per page" />
            <Button x:Name="PART_Previous" IsEnabled="{TemplateBinding CanGoPrevious}" sl:Sl.Variant="Ghost" sl:Sl.Size="{TemplateBinding Size}" sl:Sl.StartIcon="chevron-left" sl:Sl.IconOnly="True" sl:Sl.Label="Previous page" />
            <ItemsControl ItemsSource="{TemplateBinding Pages}" Focusable="False" Margin="2,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="1,0">
                    <Button x:Name="PageButton" Content="{Binding Label}" MinWidth="32" sl:Sl.Variant="Ghost"
                            sl:Sl.Size="{Binding Size, RelativeSource={RelativeSource AncestorType=sl:Pagination}}" AutomationProperties.Name="{Binding AccessibleName}" />
                    <TextBlock x:Name="Dots" Text="…" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                               Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                      <Setter TargetName="PageButton" Property="Visibility" Value="Collapsed" />
                      <Setter TargetName="Dots" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                      <Setter TargetName="PageButton" Property="sl:Sl.Pressed" Value="True" />
                      <Setter TargetName="PageButton" Property="AutomationProperties.ItemStatus" Value="current page" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="PART_Next" IsEnabled="{TemplateBinding CanGoNext}" sl:Sl.Variant="Ghost" sl:Sl.Size="{TemplateBinding Size}" sl:Sl.StartIcon="chevron-right" sl:Sl.IconOnly="True" sl:Sl.Label="Next page" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="RangeText" Value="{x:Null}">
              <Setter TargetName="Range" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="PageSizes" Value="{x:Null}">
              <Setter TargetName="PART_PageSize" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sl.SegmentItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Shadow" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="{DynamicResource Sl.Brush.Background.Surface}"
                    Effect="{DynamicResource Sl.Effect.Control}" Visibility="Collapsed" />
            <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="Transparent" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <sl:Icon x:Name="Glyph" Kind="{Binding Icon}" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:SegmentedControl">
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:SegmentedControl">
          <Border x:Name="Trough" Background="{DynamicResource Sl.Brush.Background.Muted}" CornerRadius="{DynamicResource Sl.CornerRadius.Lg}"
                  Padding="2" Height="{DynamicResource Sl.Size.Control.Md}">
            <ListBox x:Name="PART_List" ItemsSource="{TemplateBinding Segments}" SelectedItem="{Binding SelectedSegment, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource Sl.SegmentItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="None" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="FullWidth" Value="True">
              <Setter TargetName="PART_List" Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="Size" Value="Small">
              <Setter TargetName="Trough" Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
            </Trigger>
            <Trigger Property="Size" Value="Large">
              <Setter TargetName="Trough" Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Trough" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="FullWidth" Value="True">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Avatar, skeleton, slider ===== -->

  <Style TargetType="sl:Avatar">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Avatar">
          <Grid x:Name="Root" Width="32" Height="32">
            <Border x:Name="Disc" CornerRadius="{DynamicResource Sl.Component.Avatar.Radius.Corner}"
                    Background="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource TemplatedParent}}">
              <TextBlock x:Name="InitialsText" Text="{TemplateBinding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" FontSize="12"
                         Foreground="{Binding Path=(sl:Sl.ChromeForeground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Border>
            <Border x:Name="Photo" CornerRadius="{DynamicResource Sl.Component.Avatar.Radius.Corner}">
              <Border.Background>
                <ImageBrush ImageSource="{Binding ImageSource, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
            <Border x:Name="Dot" Width="10" Height="10" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                    Background="{Binding Path=(sl:Sl.Fill), RelativeSource={RelativeSource TemplatedParent}}"
                    BorderBrush="{DynamicResource Sl.Brush.Background.Surface}" BorderThickness="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ImageSource" Value="{x:Null}">
              <Setter TargetName="Photo" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Status" Value="None">
              <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Small">
              <Setter TargetName="Root" Property="Width" Value="24" />
              <Setter TargetName="Root" Property="Height" Value="24" />
              <Setter TargetName="InitialsText" Property="FontSize" Value="10" />
              <Setter TargetName="Dot" Property="Width" Value="8" />
              <Setter TargetName="Dot" Property="Height" Value="8" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Large">
              <Setter TargetName="Root" Property="Width" Value="40" />
              <Setter TargetName="Root" Property="Height" Value="40" />
              <Setter TargetName="InitialsText" Property="FontSize" Value="14" />
              <Setter TargetName="Dot" Property="Width" Value="12" />
              <Setter TargetName="Dot" Property="Height" Value="12" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Skeleton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Skeleton">
          <Grid x:Name="PART_Root">
            <ItemsControl x:Name="LineList" ItemsSource="{TemplateBinding LineWidths}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="10" Margin="0,0,0,8" HorizontalAlignment="Left" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}"
                          Background="{DynamicResource Sl.Component.Skeleton.Background.Brush}">
                    <Border.Width>
                      <MultiBinding Converter="{x:Static sl:MultiplyConverter.Instance}">
                        <Binding />
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                      </MultiBinding>
                    </Border.Width>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="Block" MinHeight="40" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Visibility="Collapsed"
                    Background="{DynamicResource Sl.Component.Skeleton.Background.Brush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Shape" Value="Rect">
              <Setter TargetName="LineList" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Block" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Shape" Value="Circle">
              <Setter TargetName="LineList" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Block" Property="Visibility" Value="Visible" />
              <Setter TargetName="Block" Property="CornerRadius" Value="9999" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sl.SliderThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Border CornerRadius="8" Background="{DynamicResource Sl.Brush.Control.Thumb}" Effect="{DynamicResource Sl.Effect.Control}" />
            <Border CornerRadius="8" Background="{DynamicResource Sl.Brush.Control.Thumb}" BorderThickness="2"
                    BorderBrush="{Binding Path=(sl:Sl.Fill), RelativeSource={RelativeSource AncestorType=sl:Slider}}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:Slider">
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Slider">
          <StackPanel>
            <DockPanel x:Name="Header" Margin="0,0,0,6">
              <TextBlock x:Name="ValueLabel" DockPanel.Dock="Right" Text="{TemplateBinding ValueText}" VerticalAlignment="Center"
                         FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontSize="{DynamicResource Sl.Font.Size.Sm}"
                         FontWeight="{DynamicResource Sl.Font.Weight.Medium}" Foreground="{DynamicResource Sl.Brush.Text.Primary}" />
            </DockPanel>
            <Canvas x:Name="PART_Canvas" Height="22" Background="Transparent" ClipToBounds="False">
              <Border Canvas.Top="9" Height="4" CornerRadius="2" Width="{Binding ActualWidth, ElementName=PART_Canvas}"
                      Background="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource TemplatedParent}}" />
              <Border x:Name="PART_Fill" Canvas.Top="9" Height="4" CornerRadius="2"
                      Background="{Binding Path=(sl:Sl.Fill), RelativeSource={RelativeSource TemplatedParent}}" />
              <sl:SliderTicks x:Name="PART_Ticks" Canvas.Top="17" Height="4" Width="{Binding ActualWidth, ElementName=PART_Canvas}" Brush="{DynamicResource Sl.Brush.Border.Strong}" />
              <Thumb x:Name="PART_Thumb" Canvas.Top="3" Width="16" Height="16" Style="{StaticResource Sl.SliderThumb}" />
              <Thumb x:Name="PART_Thumb2" Canvas.Top="3" Width="16" Height="16" Style="{StaticResource Sl.SliderThumb}" Visibility="Collapsed" />
            </Canvas>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ShowValue" Value="False">
              <Setter TargetName="ValueLabel" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Label" Value="{x:Null}" />
                <Condition Property="ShowValue" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Select ===== -->

  <Style x:Key="Sl.SelectOption" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Sl.Component.Menu.ItemHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Sl.Component.Menu.ItemRadius.Corner}" Padding="{TemplateBinding Padding}"
                  MinHeight="{TemplateBinding MinHeight}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Component.Menu.ItemHover.Brush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Component.Menu.ItemHover.Brush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsHeader}" Value="True">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="MinHeight" Value="26" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="sl:Select">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:Select">
          <StackPanel>
            <StackPanel x:Name="LabelRow" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="{TemplateBinding Label}" FontSize="{DynamicResource Sl.Font.Size.Sm}" FontWeight="{DynamicResource Sl.Font.Weight.Medium}" />
              <TextBlock x:Name="RequiredMark" Text=" *" Foreground="{DynamicResource Sl.Brush.Status.Danger.Fg}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" Visibility="Collapsed" />
            </StackPanel>
            <Grid x:Name="PART_Field" MinHeight="{DynamicResource Sl.Size.Control.Md}" SnapsToDevicePixels="True" Cursor="Hand">
              <Border x:Name="Ring" Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Focus.Ring}" Visibility="Collapsed"
                      CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerInflateConverter.Instance}, ConverterParameter=4}">
                <Border BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Background.Canvas}"
                        CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerInflateConverter.Instance}, ConverterParameter=2}" />
              </Border>
              <Border x:Name="Chrome" BorderThickness="1"
                      Background="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      BorderBrush="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource TemplatedParent}}"
                      CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                <DockPanel>
                  <sl:Icon x:Name="Chevron" DockPanel.Dock="Right" Kind="chevron-down" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                  <sl:Spinner x:Name="Busy" DockPanel.Dock="Right" Size="Small" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                  <Button x:Name="PART_Clear" DockPanel.Dock="Right" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x" sl:Sl.IconOnly="True"
                          sl:Sl.Label="Clear" Margin="0,0,2,0" VerticalAlignment="Center" Visibility="Collapsed" Focusable="False" />
                  <WrapPanel VerticalAlignment="Center"
                             Margin="{Binding Path=(sl:Sl.PaddingX), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:HorizontalThicknessConverter.Instance}}">
                    <ItemsControl x:Name="ChipList" ItemsSource="{TemplateBinding Chips}" Focusable="False" Visibility="Collapsed">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,3,4,3" Height="22" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}" Background="{DynamicResource Sl.Brush.Background.Muted}" Padding="7,0,2,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" FontSize="{DynamicResource Sl.Font.Size.Sm}" />
                              <Button x:Name="PART_RemoveChip" Width="18" Height="18" Margin="2,0,0,0" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x"
                                      sl:Sl.IconOnly="True" sl:Sl.Label="Remove" Focusable="False" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="Overflow" Text="{TemplateBinding OverflowText}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                               FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                    <Grid MinWidth="40">
                      <TextBlock x:Name="ValueText" Text="{TemplateBinding DisplayText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="PlaceholderText" Text="{TemplateBinding Placeholder}" VerticalAlignment="Center" Visibility="Collapsed"
                                 Foreground="{DynamicResource Sl.Brush.Text.Placeholder}" />
                      <TextBox x:Name="PART_Search" Style="{StaticResource Sl.TextBox.Bare}" MinWidth="60" Visibility="Collapsed" Background="Transparent"
                               Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                               AutomationProperties.Name="{TemplateBinding Label}" />
                    </Grid>
                  </WrapPanel>
                </DockPanel>
              </Border>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" StaysOpen="False" PopupAnimation="Fade">
                <ContentControl Template="{StaticResource Sl.OverlayPanel}" Focusable="False" IsTabStop="False">
                  <Grid MaxHeight="320">
                    <ListBox x:Name="PART_List" ItemsSource="{TemplateBinding Options}" Focusable="False" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource Sl.SelectOption}" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="{TemplateBinding Label}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OptionText" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ContentPresenter x:Name="Custom" Content="{Binding Item}" Visibility="Collapsed"
                                              ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=sl:Select}}" />
                            <sl:Icon x:Name="Tick" Grid.Column="1" Kind="check" Size="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Sl.Brush.Accent.Text}" Visibility="Collapsed" />
                          </Grid>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                              <Setter TargetName="OptionText" Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
                              <Setter TargetName="OptionText" Property="FontSize" Value="{DynamicResource Sl.Font.Size.2xs}" />
                              <Setter TargetName="OptionText" Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCreate}" Value="True">
                              <Setter TargetName="OptionText" Property="Foreground" Value="{DynamicResource Sl.Brush.Accent.Text}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=sl:Select}, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding IsHeader}" Value="False" />
                                <Condition Binding="{Binding IsCreate}" Value="False" />
                              </MultiDataTrigger.Conditions>
                              <Setter TargetName="Custom" Property="Visibility" Value="Visible" />
                              <Setter TargetName="OptionText" Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <ContentPresenter x:Name="Empty" Content="{TemplateBinding EmptyContent}" Margin="10,8" Visibility="Collapsed"
                                      TextElement.Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                    <sl:Spinner x:Name="ListBusy" Size="Small" Margin="10" HorizontalAlignment="Center" Visibility="Collapsed" />
                  </Grid>
                </ContentControl>
              </Popup>
            </Grid>
            <StackPanel x:Name="HelperRow" Orientation="Horizontal" Margin="0,6,0,0">
              <sl:Icon x:Name="ErrorIcon" Kind="alert-circle" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Sl.Brush.Status.Danger.Fg}" Visibility="Collapsed" />
              <TextBlock x:Name="Helper" Text="{TemplateBinding HelperText}" TextWrapping="Wrap" FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </StackPanel>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Required" Value="True">
              <Setter TargetName="RequiredMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HelperText" Value="{x:Null}">
              <Setter TargetName="HelperRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Multiple" Value="True">
              <Setter TargetName="ChipList" Property="Visibility" Value="Visible" />
              <Setter TargetName="Overflow" Property="Visibility" Value="Visible" />
              <Setter TargetName="ValueText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="OverflowText" Value="{x:Null}">
              <Setter TargetName="Overflow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="HasValue" Value="False" />
                <Condition Property="Searchable" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="Searchable" Value="True">
              <Setter TargetName="PART_Search" Property="Visibility" Value="Visible" />
              <Setter Property="Focusable" Value="False" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Searchable" Value="True" />
                <Condition Property="HasValue" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_Search" Property="sl:Sl.Placeholder" Value="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Searchable" Value="True" />
                <Condition Property="Multiple" Value="False" />
                <Condition Property="IsKeyboardFocusWithin" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="ValueText" Property="Opacity" Value="0.55" />
            </MultiTrigger>
            <Trigger Property="ShowClear" Value="True">
              <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Loading" Value="True">
              <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
              <Setter TargetName="ListBusy" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding Options.Count, RelativeSource={RelativeSource Self}}" Value="0">
              <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Small">
              <Setter TargetName="PART_Field" Property="MinHeight" Value="{DynamicResource Sl.Size.Control.Sm}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Large">
              <Setter TargetName="PART_Field" Property="MinHeight" Value="{DynamicResource Sl.Size.Control.Lg}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Lg}" />
            </Trigger>
            <Trigger Property="ActualVariant" Value="Underlined">
              <Setter TargetName="Chrome" Property="BorderThickness" Value="0,0,0,1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Path=(sl:Sl.HoverBorder), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.BorderFocus.Brush}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.BorderFocus.Brush}" />
            </Trigger>
            <Trigger Property="HasError" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
              <Setter TargetName="HelperRow" Property="Visibility" Value="Visible" />
              <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="Helper" Property="Text" Value="{Binding Error, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Helper" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Field" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Calendar & date picker ===== -->

  <Style x:Key="Sl.CalendarDay" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource Sl.Component.Calendar.DaySize}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Component.Calendar.DaySize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
    <Setter Property="Content" Value="{Binding Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Sl.CornerRadius.Sm}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
      </Trigger>
      <DataTrigger Binding="{Binding Day.InMonth}" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.IsToday}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Sl.Component.Calendar.Today.Brush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.InRange}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Component.Calendar.Range.Brush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.InPreview}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Component.Calendar.Range.Brush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.IsSelected}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Component.Calendar.Selected.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.OnAccent}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.IsRangeStart}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Component.Calendar.Selected.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.OnAccent}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.IsRangeEnd}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Component.Calendar.Selected.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.OnAccent}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsFocused}" Value="True">
        <Setter Property="IsTabStop" Value="True" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Day.IsDisabled}" Value="True">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="sl:CalendarView">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:CalendarView">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="PresetPane" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,1,0" Padding="0,0,8,0" Margin="0,0,10,0">
              <ItemsControl ItemsSource="{TemplateBinding Presets}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Label}" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button x:Name="PART_Previous" DockPanel.Dock="Left" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="chevron-left" sl:Sl.IconOnly="True" sl:Sl.Label="Previous month" />
                <Button x:Name="PART_Next" DockPanel.Dock="Right" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="chevron-right" sl:Sl.IconOnly="True" sl:Sl.Label="Next month" />
                <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}"
                           FontSize="{DynamicResource Sl.Font.Size.Sm}" />
              </DockPanel>
              <ItemsControl ItemsSource="{TemplateBinding Weekdays}" Focusable="False" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextAlignment="Center" FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}"
                               Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{TemplateBinding Weeks}" Focusable="False" AutomationProperties.Name="{TemplateBinding Title}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{DynamicResource Sl.CalendarDay}" Margin="1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Presets" Value="{x:Null}">
              <Setter TargetName="PresetPane" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="sl:DatePicker">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:DatePicker">
          <Grid>
            <StackPanel x:Name="FieldLayout">
              <StackPanel x:Name="LabelRow" Orientation="Horizontal" Margin="0,0,0,6">
                <Label Content="{TemplateBinding Label}" Target="{Binding ElementName=PART_Input}" />
              </StackPanel>
              <Grid x:Name="PART_Field" Height="{DynamicResource Sl.Size.Control.Md}" SnapsToDevicePixels="True">
                <Border x:Name="Ring" Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Focus.Ring}" Visibility="Collapsed"
                        CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerInflateConverter.Instance}, ConverterParameter=4}">
                  <Border BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Background.Canvas}"
                          CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:CornerInflateConverter.Instance}, ConverterParameter=2}" />
                </Border>
                <Border x:Name="Chrome" BorderThickness="1"
                        Background="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource TemplatedParent}}"
                        BorderBrush="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource TemplatedParent}}"
                        CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                  <DockPanel>
                    <Button x:Name="PART_Toggle" DockPanel.Dock="Right" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="chevron-down" sl:Sl.IconOnly="True"
                            sl:Sl.Label="Choose date" Margin="0,0,3,0" VerticalAlignment="Center" />
                    <Button x:Name="PART_Clear" DockPanel.Dock="Right" sl:Sl.Variant="Ghost" sl:Sl.Size="Small" sl:Sl.StartIcon="x" sl:Sl.IconOnly="True"
                            sl:Sl.Label="Clear" VerticalAlignment="Center" Visibility="Collapsed" Focusable="False" />
                    <TextBox x:Name="PART_Input" Style="{StaticResource Sl.TextBox.Bare}" FontSize="{TemplateBinding FontSize}"
                             Margin="{Binding Path=(sl:Sl.PaddingX), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static sl:HorizontalThicknessConverter.Instance}, ConverterParameter=-2}"
                             Text="{Binding InputText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                             sl:Sl.Placeholder="{TemplateBinding Placeholder}" />
                  </DockPanel>
                </Border>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                  <ContentControl Template="{StaticResource Sl.OverlayPanel}" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="Cycle">
                    <sl:CalendarView x:Name="PART_Calendar" Margin="8"
                                     Selection="{TemplateBinding Selection}" SelectedDate="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                     Range="{Binding Range, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                     Min="{TemplateBinding Min}" Max="{TemplateBinding Max}" DisabledDates="{TemplateBinding DisabledDates}"
                                     FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}" Presets="{TemplateBinding Presets}" Today="{TemplateBinding Today}" />
                  </ContentControl>
                </Popup>
              </Grid>
              <StackPanel x:Name="HelperRow" Orientation="Horizontal" Margin="0,6,0,0">
                <sl:Icon x:Name="ErrorIcon" Kind="alert-circle" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource Sl.Brush.Status.Danger.Fg}" Visibility="Collapsed" />
                <TextBlock x:Name="Helper" Text="{TemplateBinding HelperText}" TextWrapping="Wrap" FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
              </StackPanel>
            </StackPanel>
            <sl:CalendarView x:Name="InlineCalendar" Visibility="Collapsed"
                             Selection="{TemplateBinding Selection}" SelectedDate="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                             Range="{Binding Range, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                             Min="{TemplateBinding Min}" Max="{TemplateBinding Max}" DisabledDates="{TemplateBinding DisabledDates}"
                             FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}" Presets="{TemplateBinding Presets}" Today="{TemplateBinding Today}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HelperText" Value="{x:Null}">
              <Setter TargetName="HelperRow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Inline" Value="True">
              <Setter TargetName="FieldLayout" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="InlineCalendar" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ShowClear" Value="True">
              <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Small">
              <Setter TargetName="PART_Field" Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
            </Trigger>
            <Trigger Property="sl:Sl.ActualSize" Value="Large">
              <Setter TargetName="PART_Field" Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
              <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Lg}" />
            </Trigger>
            <Trigger Property="ActualVariant" Value="Underlined">
              <Setter TargetName="Chrome" Property="BorderThickness" Value="0,0,0,1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Path=(sl:Sl.HoverBorder), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Component.Field.BorderFocus.Brush}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasError" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
              <Setter TargetName="HelperRow" Property="Visibility" Value="Visible" />
              <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
              <Setter TargetName="Helper" Property="Text" Value="{Binding Error, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Helper" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PART_Field" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== TreeView ===== -->

  <Style x:Key="Sl.TreeExpander" TargetType="Button">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
    <Setter Property="AutomationProperties.Name" Value="Expand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}">
            <Grid>
              <sl:Icon x:Name="Right" Kind="chevron-right" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <sl:Icon x:Name="Down" Kind="chevron-down" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
            </Trigger>
            <DataTrigger Binding="{Binding Expanded}" Value="True">
              <Setter TargetName="Right" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Down" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sl.TreeRow" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
    <Setter Property="AutomationProperties.PositionInSet" Value="{Binding PositionInSet}" />
    <Setter Property="AutomationProperties.SizeOfSet" Value="{Binding SetSize}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left" Background="{DynamicResource Sl.Brush.Selection.Indicator}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
            </Trigger>
            <DataTrigger Binding="{Binding Selected}" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Selection.Background}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Dense, RelativeSource={RelativeSource AncestorType=sl:TreeView}}" Value="True">
        <Setter Property="Height" Value="{DynamicResource Sl.Component.Tree.ItemHeight}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="sl:TreeView">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="sl:TreeView">
          <sl:TreeViewRows x:Name="PART_List" ItemsSource="{TemplateBinding Rows}" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource Sl.TreeRow}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
            <sl:TreeViewRows.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent, Converter={x:Static sl:LeftThicknessConverter.Instance}}">
                  <Button x:Name="PART_Expander" Style="{DynamicResource Sl.TreeExpander}" Margin="0,0,4,0" />
                  <CheckBox x:Name="Check" IsChecked="{Binding IsChecked, Mode=OneWay}" Focusable="False" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="Collapsed" AutomationProperties.Name="{Binding Text}" />
                  <sl:Icon x:Name="ItemIconGlyph" Kind="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                  <ContentPresenter x:Name="Custom" Content="{Binding}" Visibility="Collapsed" VerticalAlignment="Center"
                                    ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=sl:TreeView}}" />
                  <TextBlock x:Name="TextLabel" Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <sl:Spinner x:Name="Busy" Size="Small" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasChildren}" Value="False">
                    <Setter TargetName="PART_Expander" Property="Visibility" Value="Hidden" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ShowCheckbox}" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="ItemIconGlyph" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Loading}" Value="True">
                    <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=sl:TreeView}, Converter={x:Static sl:IsNotNullConverter.Instance}}" Value="True">
                    <Setter TargetName="Custom" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TextLabel" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </sl:TreeViewRows.ItemTemplate>
          </sl:TreeViewRows>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
