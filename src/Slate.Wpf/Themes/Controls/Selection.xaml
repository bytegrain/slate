<!-- Checkbox and radio (docs/design/components.md). Outlines use border.control (>= 3:1). The whole row is
     clickable; the keyboard focus ring wraps the row. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="clr-namespace:Slate.Wpf">

  <Style TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2.5,0,0">
              <Border x:Name="Box" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}" BorderThickness="1"
                      BorderBrush="{DynamicResource Sl.Brush.Border.Control}" Background="{DynamicResource Sl.Brush.Background.Sunken}" />
              <sl:Icon x:Name="Check" Kind="check" Size="12" StrokeThickness="2" Foreground="{DynamicResource Sl.Brush.Text.OnAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
              <sl:Icon x:Name="Dash" Kind="minus" Size="12" StrokeThickness="2" Foreground="{DynamicResource Sl.Brush.Text.OnAccent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2.5,0,0">
              <Ellipse x:Name="Circle" StrokeThickness="1" Stroke="{DynamicResource Sl.Brush.Border.Control}" Fill="{DynamicResource Sl.Brush.Background.Sunken}" />
              <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Sl.Brush.Text.OnAccent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
