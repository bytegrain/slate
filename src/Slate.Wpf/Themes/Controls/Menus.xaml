<!-- Menus: raised panel, radius lg, e3 shadow, 30px items with icon / text / gesture (mono) / chevron.
     sl:Ui.Icon names an icon; sl:Ui.Variant="Danger" colours a destructive item. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="clr-namespace:Slate.Wpf">

  <ControlTemplate x:Key="Sl.MenuPanel" TargetType="ContentControl">
    <Grid Margin="8,4,8,16">
      <Border CornerRadius="{DynamicResource Sl.CornerRadius.Lg}" Background="{DynamicResource Sl.Brush.Background.Raised}"
              BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1" Effect="{DynamicResource Sl.Effect.E3}" />
      <ContentPresenter Margin="4" />
    </Grid>
  </ControlTemplate>

  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <ContentControl Template="{StaticResource Sl.MenuPanel}" MinWidth="{TemplateBinding MinWidth}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
            </ScrollViewer>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
  </Style>

  <!-- Items inside a menu panel (SubmenuItem / SubmenuHeader). -->
  <ControlTemplate x:Key="Sl.MenuItem.Sub" TargetType="MenuItem">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border x:Name="Bd" CornerRadius="5" Background="Transparent" MinHeight="30" Padding="8,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIcon" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="16" Margin="0,0,10,0" VerticalAlignment="Center">
            <ContentPresenter x:Name="IconSite" ContentSource="Icon" />
            <sl:Icon x:Name="NamedIcon" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}"
                     Kind="{Binding Path=(sl:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
            <sl:Icon x:Name="Check" Kind="check" Foreground="{DynamicResource Sl.Brush.Accent.Text}" Visibility="Collapsed" />
          </Grid>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}"
                     FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}"
                     Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
          <sl:Icon x:Name="Arrow" Grid.Column="3" Kind="chevron-right" Size="14" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" Visibility="Collapsed" />
        </Grid>
      </Border>
      <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-9" AllowsTransparency="True"
             Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" PopupAnimation="Fade">
        <ContentControl Template="{StaticResource Sl.MenuPanel}" MinWidth="200" Grid.IsSharedSizeScope="True">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
        </ContentControl>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
        <Setter TargetName="NamedIcon" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
      </Trigger>
      <Trigger Property="sl:Ui.Variant" Value="Danger">
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
        <Setter TargetName="NamedIcon" Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Items in a Menu bar (TopLevelHeader / TopLevelItem). -->
  <ControlTemplate x:Key="Sl.MenuItem.Top" TargetType="MenuItem">
    <Grid SnapsToDevicePixels="True">
      <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="Transparent" Padding="10,5">
        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
      </Border>
      <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="0" HorizontalOffset="-8" AllowsTransparency="True"
             Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}" PopupAnimation="Fade">
        <ContentControl Template="{StaticResource Sl.MenuPanel}" MinWidth="200" Grid.IsSharedSizeScope="True"
                        TextElement.Foreground="{DynamicResource Sl.Brush.Text.Primary}" TextElement.FontSize="{DynamicResource Sl.Font.Size.Md}">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
        </ContentControl>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="MenuItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource Sl.MenuItem.Sub}" />
    <Style.Triggers>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Template" Value="{StaticResource Sl.MenuItem.Top}" />
      </Trigger>
      <Trigger Property="Role" Value="TopLevelItem">
        <Setter Property="Template" Value="{StaticResource Sl.MenuItem.Top}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="-4,4" Background="{DynamicResource Sl.Brush.Border.Default}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
