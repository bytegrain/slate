<!-- Focus ring, window base, scrollbars, tooltips, separators, labels, hyperlinks.
     Every themed value is a DynamicResource so SlateTheme can switch theme/density live. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Keyboard-only focus ring (WPF shows FocusVisualStyle only for keyboard focus):
       2px gap in the canvas colour + 2px focus.ring, following the control's radius. -->
  <Style x:Key="Sl.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-4" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Focus.Ring}" SnapsToDevicePixels="True">
            <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Background.Canvas}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Round focus ring for checkboxes/radios/switch thumbs drawn around the indicator only. -->
  <Style x:Key="Sl.FocusVisual.None">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Base for any Window (SlateWindow applies it automatically). -->
  <Style x:Key="Sl.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <!-- Text colour helpers: Style="{DynamicResource Sl.Text.Secondary}" -->
  <Style x:Key="Sl.Text.Secondary" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
  </Style>
  <Style x:Key="Sl.Text.Tertiary" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
  </Style>
  <Style x:Key="Sl.Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
  </Style>

  <Style TargetType="Label">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Link}" />
    <Setter Property="TextDecorations" Value="Underline" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.LinkHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Border.Default}" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ToolTip: inverse bubble, label size. -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Inverse.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Inverse.Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Sl.CornerRadius.Md}"
                  Padding="{TemplateBinding Padding}" Margin="4" Effect="{DynamicResource Sl.Effect.E2}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim Alloy scrollbars: 10px lane, 6px thumb that widens to 8px on hover. -->
  <Style x:Key="Sl.ScrollBar.LineButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sl.ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource Sl.Brush.Border.Strong}" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
              <Setter TargetName="Bd" Property="Margin" Value="1" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Border.Control}" />
              <Setter TargetName="Bd" Property="Margin" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{DynamicResource Sl.ScrollBar.LineButton}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{DynamicResource Sl.ScrollBar.LineButton}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource Sl.ScrollBar.Thumb}" />
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{DynamicResource Sl.ScrollBar.LineButton}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{DynamicResource Sl.ScrollBar.LineButton}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{DynamicResource Sl.ScrollBar.Thumb}" />
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
