<!-- Buttons (docs/design/components.md#button). Variant × Tone × Size × Radius come from sl:Sl attached properties;
     Slate resolves them (with SlateTheme.Defaults) into the computed sl:Sl.Chrome*/Hover*/Pressed* brushes the style binds to,
     so local Background/Foreground/BorderBrush still win. Paddings and radii come from the component.button.* tokens.
     WPF has no inset shadows, so the milled edge is a 1px top highlight inside the border and a 1px shade line below it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="clr-namespace:Slate.Wpf">

  <!-- Accent fills need a stronger highlight than neutral controls (shadow.primary: white at ~20-40%). -->
  <SolidColorBrush x:Key="Sl.Brush.Effect.PrimaryHighlight" Color="White" Opacity="0.28" />
  <SolidColorBrush x:Key="Sl.Brush.Effect.HoverOverlay" Color="Black" Opacity="0.08" />
  <SolidColorBrush x:Key="Sl.Brush.Effect.PressedOverlay" Color="Black" Opacity="0.14" />

  <ControlTemplate x:Key="Sl.Button.Template" TargetType="ButtonBase">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border x:Name="Shade" Margin="0,0,0,-1" Background="{DynamicResource Sl.Brush.Effect.Shade}"
              CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
        <Grid>
          <Border x:Name="Overlay" Background="{DynamicResource Sl.Brush.Effect.HoverOverlay}" Visibility="Collapsed"
                  CornerRadius="{Binding Path=(sl:Sl.ActualCornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
          <Border x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="3,0"
                  Background="{DynamicResource Sl.Brush.Effect.Highlight}" />
          <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}">
            <StackPanel x:Name="Row" Orientation="Horizontal">
              <sl:Spinner x:Name="Spinner" Diameter="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
              <sl:Icon x:Name="IconStart" Margin="0,0,6,0" VerticalAlignment="Center" Size="{DynamicResource Sl.Component.Button.IconSize}"
                       Kind="{Binding Path=(sl:Sl.StartIcon), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter x:Name="Content" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <sl:Icon x:Name="IconEnd" Margin="6,0,0,0" VerticalAlignment="Center" Size="{DynamicResource Sl.Component.Button.IconSize}"
                       Kind="{Binding Path=(sl:Sl.EndIcon), RelativeSource={RelativeSource TemplatedParent}}" />
              <sl:Kbd x:Name="Kbd" Margin="8,0,0,0" VerticalAlignment="Center"
                      Text="{Binding Path=(sl:Sl.Shortcut), RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
            <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                    Background="{TemplateBinding Foreground}" Visibility="Collapsed" Opacity="0.45" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="sl:Sl.StartIcon" Value="{x:Null}">
        <Setter TargetName="IconStart" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Sl.EndIcon" Value="{x:Null}">
        <Setter TargetName="IconEnd" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Sl.Shortcut" Value="{x:Null}">
        <Setter TargetName="Kbd" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="IconStart" Property="Margin" Value="0" />
        <Setter TargetName="IconEnd" Property="Margin" Value="0" />
        <Setter TargetName="Spinner" Property="Margin" Value="0" />
      </Trigger>
      <Trigger Property="sl:Sl.IconOnly" Value="True">
        <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Kbd" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="IconStart" Property="Margin" Value="0" />
        <Setter TargetName="IconEnd" Property="Margin" Value="0" />
        <Setter TargetName="Spinner" Property="Margin" Value="0" />
      </Trigger>
      <Trigger Property="sl:Sl.Loading" Value="True">
        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
        <Setter TargetName="IconStart" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Sl.HoverOverlay" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Sl.HoverOverlay" Value="True" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
        <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Sl.Brush.Effect.PressedOverlay}" />
      </MultiTrigger>
      <Trigger Property="sl:Sl.ActualVariant" Value="Solid">
        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Sl.Brush.Effect.PrimaryHighlight}" />
      </Trigger>
      <Trigger Property="sl:Sl.ActualVariant" Value="Soft">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Sl.ActualVariant" Value="Ghost">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Sl.ActualVariant" Value="Link">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Sl.Button" TargetType="ButtonBase">
    <Setter Property="sl:Sl.Kind" Value="Button" />
    <Setter Property="Template" Value="{StaticResource Sl.Button.Template}" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Component.Button.FontWeight}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="MinWidth" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Padding" Value="{Binding Path=(sl:Sl.PaddingX), RelativeSource={RelativeSource Self}, Converter={x:Static sl:HorizontalThicknessConverter.Instance}}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{Binding Path=(sl:Sl.ChromeBackground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="BorderBrush" Value="{Binding Path=(sl:Sl.ChromeBorder), RelativeSource={RelativeSource Self}}" />
    <Setter Property="Foreground" Value="{Binding Path=(sl:Sl.ChromeForeground), RelativeSource={RelativeSource Self}}" />
    <Style.Triggers>
      <!-- Sizes -->
      <Trigger Property="sl:Sl.ActualSize" Value="Small">
        <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
      </Trigger>
      <Trigger Property="sl:Sl.ActualSize" Value="Large">
        <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
      </Trigger>
      <!-- Icon-only buttons are square -->
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
      </Trigger>
      <Trigger Property="sl:Sl.IconOnly" Value="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
      </Trigger>
      <Trigger Property="sl:Sl.FullWidth" Value="True">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </Trigger>

      <!-- Interaction states use the computed brushes for the variant × tone. -->
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{Binding Path=(sl:Sl.HoverBackground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="BorderBrush" Value="{Binding Path=(sl:Sl.HoverBorder), RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{Binding Path=(sl:Sl.HoverForeground), RelativeSource={RelativeSource Self}}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{Binding Path=(sl:Sl.PressedBackground), RelativeSource={RelativeSource Self}}" />
      </Trigger>

      <!-- Toggle state on plain buttons (sl:Sl.Pressed): the accent tint, like a checked ToggleButton. -->
      <Trigger Property="sl:Sl.Pressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Accent.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
      </Trigger>

      <!-- Link: inline text -->
      <Trigger Property="sl:Sl.ActualVariant" Value="Link">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
      </Trigger>

      <Trigger Property="sl:Sl.Loading" Value="True">
        <Setter Property="Cursor" Value="Wait" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}" />
  <Style TargetType="RepeatButton" BasedOn="{StaticResource Sl.Button}" />

  <!-- ToggleButton: checked = accent tint + accent text. -->
  <Style TargetType="ToggleButton" BasedOn="{StaticResource Sl.Button}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Accent.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Segmented control: put RadioButtons with Style="{DynamicResource Sl.SegmentedItem}" inside a
       Border with Style="{DynamicResource Sl.Segmented}". -->
  <Style x:Key="Sl.Segmented" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sl.CornerRadius.Md}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="Sl.SegmentedItem" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Shade" Margin="0,0,0,-1" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}" Background="{DynamicResource Sl.Brush.Effect.Shade}" Visibility="Collapsed" />
            <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Sm}" Background="Transparent" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="2,0" Background="{DynamicResource Sl.Brush.Effect.Highlight}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <sl:Icon x:Name="Icon" Margin="0,0,6,0" Size="14" Kind="{Binding Path=(sl:Sl.StartIcon), RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter RecognizesAccessKey="True" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sl:Sl.StartIcon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
              <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
              <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
