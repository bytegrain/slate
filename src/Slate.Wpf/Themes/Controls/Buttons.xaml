<!-- Buttons (docs/design/components.md#button). Variant/size/icon/loading come from sl:Ui attached properties.
     WPF has no inset shadows, so the milled edge is drawn as a 1px top highlight inside the border and
     a 1px shade line below it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="clr-namespace:Slate.Wpf">

  <!-- Accent fills need a stronger highlight than neutral controls (shadow.primary: white at ~20-40%). -->
  <SolidColorBrush x:Key="Sl.Brush.Effect.PrimaryHighlight" Color="White" Opacity="0.28" />
  <SolidColorBrush x:Key="Sl.Brush.Effect.HoverOverlay" Color="Black" Opacity="0.08" />

  <ControlTemplate x:Key="Sl.Button.Template" TargetType="ButtonBase">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border x:Name="Shade" Margin="0,0,0,-1" CornerRadius="{DynamicResource Sl.CornerRadius.Md}"
              Background="{DynamicResource Sl.Brush.Effect.Shade}" />
      <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Md}"
              Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
          <Border x:Name="Overlay" CornerRadius="5" Background="{DynamicResource Sl.Brush.Effect.HoverOverlay}" Visibility="Collapsed" />
          <Border x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="3,0"
                  Background="{DynamicResource Sl.Brush.Effect.Highlight}" />
          <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}">
            <StackPanel x:Name="Row" Orientation="Horizontal">
              <sl:Spinner x:Name="Spinner" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
              <sl:Icon x:Name="IconStart" Margin="0,0,6,0" VerticalAlignment="Center"
                       Kind="{Binding Path=(sl:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter x:Name="Content" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <sl:Icon x:Name="IconEnd" Margin="6,0,0,0" VerticalAlignment="Center"
                       Kind="{Binding Path=(sl:Ui.IconEnd), RelativeSource={RelativeSource TemplatedParent}}" />
              <sl:Kbd x:Name="Kbd" Margin="8,0,0,0" VerticalAlignment="Center"
                      Text="{Binding Path=(sl:Ui.Shortcut), RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
            <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                    Background="{TemplateBinding Foreground}" Visibility="Collapsed" Opacity="0.45" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="sl:Ui.Icon" Value="{x:Null}">
        <Setter TargetName="IconStart" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Ui.IconEnd" Value="{x:Null}">
        <Setter TargetName="IconEnd" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Ui.Shortcut" Value="{x:Null}">
        <Setter TargetName="Kbd" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Content" Value="{x:Null}">
        <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="IconStart" Property="Margin" Value="0" />
        <Setter TargetName="IconEnd" Property="Margin" Value="0" />
        <Setter TargetName="Spinner" Property="Margin" Value="0" />
      </Trigger>
      <Trigger Property="sl:Ui.IsLoading" Value="True">
        <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
        <Setter TargetName="IconStart" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Ui.Variant" Value="Primary">
        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Sl.Brush.Effect.PrimaryHighlight}" />
      </Trigger>
      <Trigger Property="sl:Ui.Variant" Value="DangerSolid">
        <Setter TargetName="Highlight" Property="Background" Value="{DynamicResource Sl.Brush.Effect.PrimaryHighlight}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Ui.Variant" Value="DangerSolid" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
      </MultiTrigger>
      <Trigger Property="sl:Ui.Variant" Value="Ghost">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="sl:Ui.Variant" Value="Link">
        <Setter TargetName="Highlight" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Shade" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Sl.Button" TargetType="ButtonBase">
    <Setter Property="Template" Value="{StaticResource Sl.Button.Template}" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="MinWidth" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Style.Triggers>
      <!-- Sizes -->
      <Trigger Property="sl:Ui.Size" Value="Small">
        <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
      </Trigger>
      <Trigger Property="sl:Ui.Size" Value="Large">
        <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
      </Trigger>
      <!-- Icon-only buttons are square -->
      <Trigger Property="Content" Value="{x:Null}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{Binding Height, RelativeSource={RelativeSource Self}}" />
      </Trigger>

      <!-- secondary (default) states -->
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Ui.Variant" Value="Secondary" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
      </MultiTrigger>

      <!-- primary -->
      <Trigger Property="sl:Ui.Variant" Value="Primary">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Default}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.OnAccent}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Ui.Variant" Value="Primary" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Hover}" />
      </MultiTrigger>

      <!-- ghost -->
      <Trigger Property="sl:Ui.Variant" Value="Ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Ui.Variant" Value="Ghost" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
      </MultiTrigger>

      <!-- danger (neutral chrome, danger text) -->
      <Trigger Property="sl:Ui.Variant" Value="Danger">
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Ui.Variant" Value="Danger" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Border}" />
      </MultiTrigger>

      <!-- danger solid -->
      <Trigger Property="sl:Ui.Variant" Value="DangerSolid">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Status.Danger.Solid}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Status.Danger.OnSolid}" />
      </Trigger>

      <!-- link -->
      <Trigger Property="sl:Ui.Variant" Value="Link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Link}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="sl:Ui.Variant" Value="Link" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.LinkHover}" />
      </MultiTrigger>

      <!-- pressed (all chrome variants) -->
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsPressed" Value="True" />
          <Condition Property="sl:Ui.Variant" Value="Secondary" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Pressed}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsPressed" Value="True" />
          <Condition Property="sl:Ui.Variant" Value="Primary" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Pressed}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsPressed" Value="True" />
          <Condition Property="sl:Ui.Variant" Value="Ghost" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Pressed}" />
      </MultiTrigger>

      <Trigger Property="sl:Ui.IsLoading" Value="True">
        <Setter Property="Cursor" Value="Wait" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Sl.Button}" />
  <Style TargetType="RepeatButton" BasedOn="{StaticResource Sl.Button}" />

  <!-- ToggleButton: checked = accent tint + accent text. -->
  <Style TargetType="ToggleButton" BasedOn="{StaticResource Sl.Button}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Accent.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Segmented control: put RadioButtons with Style="{DynamicResource Sl.SegmentedItem}" inside a
       Border with Style="{DynamicResource Sl.Segmented}". -->
  <Style x:Key="Sl.Segmented" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="Sl.SegmentedItem" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Shade" Margin="0,0,0,-1" CornerRadius="5" Background="{DynamicResource Sl.Brush.Effect.Shade}" Visibility="Collapsed" />
            <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
              <Grid>
                <Border x:Name="Highlight" Height="1" VerticalAlignment="Top" Margin="2,0" Background="{DynamicResource Sl.Brush.Effect.Highlight}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <sl:Icon x:Name="Icon" Margin="0,0,6,0" Size="14" Kind="{Binding Path=(sl:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter RecognizesAccessKey="True" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sl:Ui.Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
              <Setter TargetName="Shade" Property="Visibility" Value="Visible" />
              <Setter TargetName="Highlight" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
