<!-- Text inputs and select (docs/design/components.md#text-field). Inputs sit on background.sunken with an
     inset hairline at the top (WPF stand-in for shadow.inset); focus = accent border + focus ring. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sl="clr-namespace:Slate.Wpf">

  <Style x:Key="Sl.InputBase" TargetType="Control">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Md}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Style.Triggers>
      <Trigger Property="sl:Ui.Size" Value="Small">
        <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Sm}" />
        <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Sm}" />
        <Setter Property="Padding" Value="6,0" />
      </Trigger>
      <Trigger Property="sl:Ui.Size" Value="Large">
        <Setter Property="Height" Value="{DynamicResource Sl.Size.Control.Lg}" />
        <Setter Property="Padding" Value="12,0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Shared chrome: focus ring, field, inset hairline. The part named "Field" holds the content. -->
  <ControlTemplate x:Key="Sl.TextBox.Template" TargetType="TextBoxBase">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border x:Name="Ring" Margin="-4" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Focus.Ring}" Visibility="Collapsed">
        <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Background.Canvas}" />
      </Border>
      <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid>
          <Border Height="1" VerticalAlignment="Top" Margin="3,0" Background="{DynamicResource Sl.Brush.Effect.Shade}" />
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"
                     Foreground="{DynamicResource Sl.Brush.Text.Placeholder}" TextTrimming="CharacterEllipsis"
                     Text="{Binding Path=(sl:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="sl:Ui.IsEmpty" Value="True">
        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
      </Trigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Subtle}" />
      </Trigger>
      <Trigger Property="sl:Ui.HasError" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsKeyboardFocused" Value="True" />
          <Condition Property="sl:Ui.HasError" Value="True" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="TextBox" BasedOn="{StaticResource Sl.InputBase}">
    <Setter Property="Template" Value="{StaticResource Sl.TextBox.Template}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="CaretBrush" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="AllowDrop" Value="True" />
    <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
    <Style.Triggers>
      <!-- Multiline -->
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource Sl.InputBase}">
    <Setter Property="SelectionBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="CaretBrush" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Ring" Margin="-4" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Focus.Ring}" Visibility="Collapsed">
              <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Sl.Brush.Background.Canvas}" />
            </Border>
            <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Border Height="1" VerticalAlignment="Top" Margin="3,0" Background="{DynamicResource Sl.Brush.Effect.Shade}" />
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource Sl.Brush.Text.Placeholder}"
                           Text="{Binding Path=(sl:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="sl:Ui.IsEmpty" Value="True">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
            </Trigger>
            <Trigger Property="sl:Ui.HasError" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Select (ComboBox): looks like a text field with a trailing chevron; popup is a raised menu. -->
  <Style x:Key="Sl.ComboBox.Toggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <sl:Icon Kind="chevron-down" Size="16" HorizontalAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource Sl.InputBase}">
    <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
    <Setter Property="Padding" Value="10,0,32,0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Sl.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid x:Name="Root" SnapsToDevicePixels="True">
            <Border x:Name="Shade" Margin="0,0,0,-1" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="{DynamicResource Sl.Brush.Effect.Shade}" />
            <Border x:Name="Bd" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Border Height="1" VerticalAlignment="Top" Margin="3,0" Background="{DynamicResource Sl.Brush.Effect.Highlight}" />
            </Border>
            <ContentPresenter x:Name="ContentSite" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
            <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource Sl.Brush.Text.Placeholder}" Visibility="Collapsed"
                       Text="{Binding Path=(sl:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1" Padding="7,0,30,0" BorderThickness="0" Background="Transparent"
                     IsReadOnly="{TemplateBinding IsReadOnly}" />
            <ToggleButton Style="{StaticResource Sl.ComboBox.Toggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
              <Grid Margin="8,0,8,16" MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border CornerRadius="{DynamicResource Sl.CornerRadius.Lg}" Background="{DynamicResource Sl.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1" Effect="{DynamicResource Sl.Effect.E3}" />
                <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedItem" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.ControlHover}" />
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Accent.Default}" />
            </Trigger>
            <Trigger Property="sl:Ui.HasError" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Sl.Brush.Status.Danger.Fg}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Primary}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" />
              <sl:Icon x:Name="Check" Grid.Column="1" Kind="check" Size="14" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Sl.Brush.Accent.Text}" Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Sl.Brush.Background.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Medium}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="{DynamicResource Sl.Opacity.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
