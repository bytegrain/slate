<sl:SlateWindow x:Class="Slate.Wpf.Demo.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:sl="https://slate.dev/wpf"
                Title="Slate for WPF" AppIcon="layers"
                Width="1320" Height="860" MinWidth="720" MinHeight="520"
                WindowStartupLocation="CenterScreen">

  <sl:SlateWindow.TitleBarContent>
    <Grid Width="320">
      <TextBox x:Name="Search" sl:Sl.Size="Small" sl:Sl.Placeholder="Search components" Padding="28,0,40,0"
               AutomationProperties.Name="Search components" />
      <sl:Icon Kind="search" Size="14" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
               Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
      <sl:Kbd Text="Ctrl K" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
  </sl:SlateWindow.TitleBarContent>

  <sl:SlateWindow.TitleBarActions>
    <sl:Stack Direction="Row" Spacing="3" Align="Center">
      <Border Style="{DynamicResource Sl.Segmented}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{DynamicResource Sl.SegmentedItem}" sl:Sl.StartIcon="sun" Content="Light" Checked="OnThemeChecked" Tag="Light" />
          <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{DynamicResource Sl.SegmentedItem}" sl:Sl.StartIcon="moon" Content="Dark" Checked="OnThemeChecked" Tag="Dark" />
          <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{DynamicResource Sl.SegmentedItem}" Content="System" Checked="OnThemeChecked" Tag="System" />
        </StackPanel>
      </Border>
      <sl:Switch x:Name="Comfortable" Content="Comfortable" LabelPlacement="Start" FontSize="{DynamicResource Sl.Font.Size.Sm}" Checked="OnDensityChanged" Unchecked="OnDensityChanged"
                 VerticalAlignment="Center" />
    </sl:Stack>
  </sl:SlateWindow.TitleBarActions>

  <sl:AppShell x:Name="Shell">
    <sl:AppShell.Drawer>
      <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,12">
          <TextBlock Style="{DynamicResource Sl.Text.Tertiary}" FontFamily="{DynamicResource Sl.Font.Family.Mono}" Text="Slate.Wpf 0.1 · Alloy" />
        </Border>
        <StackPanel>
          <sl:SectionHeader Content="Library" Margin="8,4,0,0" />
          <ListBox x:Name="Nav" Style="{DynamicResource Sl.NavList}" SelectionChanged="OnNavigate" Padding="8,0">
            <sl:NavItem Icon="layers" Content="Components" Tag="Components" />
            <sl:NavItem Icon="menu" Content="Overlays &amp; pickers" Tag="Pickers" />
            <sl:NavItem Icon="settings" Content="Layout" Tag="Layout" />
            <sl:NavItem Icon="bell" Content="Feedback" Tag="Feedback">
              <sl:NavItem.Trailing>
                <sl:Badge Tone="Accent" Content="New" />
              </sl:NavItem.Trailing>
            </sl:NavItem>
            <sl:NavItem Icon="copy" Content="Dialogs" Tag="Dialogs" />
            <sl:NavItem Icon="sun" Content="Theming" Tag="Theming" />
            <sl:NavItem Icon="pencil" Content="Playground" Tag="Playground" />
          </ListBox>
          <sl:SectionHeader Content="Examples" Margin="8,8,0,0" />
          <ListBox x:Name="Examples" Style="{DynamicResource Sl.NavList}" SelectionChanged="OnNavigate" Padding="8,0">
            <sl:NavItem Icon="folder" Content="File browser" Tag="Files" />
          </ListBox>
        </StackPanel>
      </DockPanel>
    </sl:AppShell.Drawer>

    <ContentControl x:Name="PageHost" Focusable="False" />
  </sl:AppShell>
</sl:SlateWindow>
