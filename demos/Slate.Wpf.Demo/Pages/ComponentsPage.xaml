<UserControl x:Class="Slate.Wpf.Demo.Pages.ComponentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sl="https://slate.dev/wpf">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <sl:Container Size="Lg" Margin="0,28,0,48">
      <sl:Stack Spacing="6">
        <StackPanel>
          <TextBlock Style="{DynamicResource Sl.Typography.Overline}" Foreground="{DynamicResource Sl.Brush.Accent.Text}" Text="COMPONENTS" />
          <TextBlock Style="{DynamicResource Sl.Typography.H2}" Margin="0,6,0,4" Text="Every control, every state" />
          <TextBlock Style="{DynamicResource Sl.Text.Secondary}" TextWrapping="Wrap"
                     Text="Native WPF controls pick up Alloy automatically. Variants, sizes and icons are attached properties (sl:Ui.*)." />
        </StackPanel>

        <!-- Buttons -->
        <sl:Card Header="Buttons" Subtitle="Six variants, three sizes. One primary action per view.">
          <sl:Stack Spacing="4">
            <sl:Stack Orientation="Horizontal" Spacing="2">
              <Button sl:Ui.Variant="Primary" Content="Deploy" />
              <Button Content="Secondary" />
              <Button sl:Ui.Variant="Ghost" Content="Ghost" />
              <Button sl:Ui.Variant="Danger" Content="Delete" />
              <Button sl:Ui.Variant="DangerSolid" Content="Delete forever" />
              <Button sl:Ui.Variant="Link" Content="Learn more" VerticalAlignment="Center" />
            </sl:Stack>
            <sl:Stack Orientation="Horizontal" Spacing="2" Align="Center">
              <Button sl:Ui.Variant="Primary" sl:Ui.Size="Small" Content="Small" />
              <Button sl:Ui.Variant="Primary" Content="Medium" />
              <Button sl:Ui.Variant="Primary" sl:Ui.Size="Large" Content="Large" sl:Ui.IconEnd="arrow-right" />
              <Button sl:Ui.Icon="download" Content="Export" />
              <Button sl:Ui.Icon="plus" AutomationProperties.Name="Add" ToolTip="Add item" />
              <Button sl:Ui.Variant="Ghost" sl:Ui.Icon="more-horizontal" AutomationProperties.Name="More" ToolTip="More actions">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename" sl:Ui.Icon="pencil" InputGestureText="F2" />
                    <MenuItem Header="Duplicate" sl:Ui.Icon="copy" InputGestureText="Ctrl+D" />
                    <MenuItem Header="Move to">
                      <MenuItem Header="Archive" />
                      <MenuItem Header="Shared" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Delete" sl:Ui.Icon="trash" sl:Ui.Variant="Danger" InputGestureText="Del" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </sl:Stack>
            <sl:Stack Orientation="Horizontal" Spacing="2" Align="Center">
              <Button x:Name="LoadingButton" sl:Ui.Variant="Primary" Content="Deploying…" sl:Ui.IsLoading="True" />
              <Button Content="Disabled" IsEnabled="False" />
              <Button Content="Commit" sl:Ui.Shortcut="Ctrl ↵" />
              <ToggleButton Content="Pinned" sl:Ui.Icon="layers" IsChecked="True" />
              <Border Style="{DynamicResource Sl.Segmented}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton Style="{DynamicResource Sl.SegmentedItem}" Content="Day" GroupName="Range" />
                  <RadioButton Style="{DynamicResource Sl.SegmentedItem}" Content="Week" GroupName="Range" IsChecked="True" />
                  <RadioButton Style="{DynamicResource Sl.SegmentedItem}" Content="Month" GroupName="Range" />
                </StackPanel>
              </Border>
            </sl:Stack>
          </sl:Stack>
        </sl:Card>

        <!-- Inputs -->
        <sl:Card Header="Text inputs" Subtitle="Labels stay visible. Errors say what happened and how to fix it.">
          <sl:ResponsiveGrid Spacing="5">
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Project name" Text="slate-dashboard" HelperText="Lowercase letters, numbers and dashes." IsRequired="True" />
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Owner email" Text="aaron@" Error="Enter a complete email address." />
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Domain" Prefix="https://" Text="slate.dev" />
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Search" StartIcon="search" Placeholder="Files, people, settings" />
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Price" Suffix="USD" Text="24.00" />
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Build ID" Text="a1f9c2e" IsReadOnly="True" HelperText="Read-only" />
            <StackPanel sl:ResponsiveGrid.Md="6">
              <Label Content="_Password" Target="{Binding ElementName=Password}" Margin="0,0,0,6" />
              <PasswordBox x:Name="Password" sl:Ui.Placeholder="At least 12 characters" />
            </StackPanel>
            <StackPanel sl:ResponsiveGrid.Md="6">
              <Label Content="_Region" Target="{Binding ElementName=Region}" Margin="0,0,0,6" />
              <ComboBox x:Name="Region" sl:Ui.Placeholder="Choose a region">
                <ComboBoxItem Content="Europe West — London" />
                <ComboBoxItem Content="US East — Virginia" />
                <ComboBoxItem Content="Asia Pacific — Sydney" />
              </ComboBox>
            </StackPanel>
            <sl:TextField sl:ResponsiveGrid.Md="12" Label="Release notes" IsMultiline="True" Placeholder="What changed, and why?" />
            <sl:TextField sl:ResponsiveGrid.Md="6" Label="Disabled" Text="Can't touch this" IsEnabled="False" />
            <sl:TextField sl:ResponsiveGrid.Md="3" Label="Small" Size="Small" Text="26px" />
            <sl:TextField sl:ResponsiveGrid.Md="3" Label="Large" Size="Large" Text="40px" />
          </sl:ResponsiveGrid>
        </sl:Card>

        <!-- Selection -->
        <sl:ResponsiveGrid Spacing="6">
          <sl:Card sl:ResponsiveGrid.Md="6" Header="Checkbox &amp; radio">
            <sl:Stack Spacing="3">
              <CheckBox Content="Run tests before deploy" IsChecked="True" />
              <CheckBox IsChecked="True">
                <StackPanel>
                  <TextBlock Text="Notify on failure" />
                  <TextBlock Style="{DynamicResource Sl.Text.Tertiary}" Text="Sends to #builds and the commit author." />
                </StackPanel>
              </CheckBox>
              <CheckBox Content="Some packages selected" IsThreeState="True" IsChecked="{x:Null}" />
              <CheckBox Content="Auto-merge (disabled)" IsEnabled="False" />
              <sl:Divider Margin="0,4" />
              <RadioButton GroupName="Plan" Content="Team — unlimited projects" IsChecked="True" />
              <RadioButton GroupName="Plan" Content="Solo — three projects" />
            </sl:Stack>
          </sl:Card>
          <sl:Card sl:ResponsiveGrid.Md="6" Header="Switch">
            <sl:Stack Spacing="4">
              <sl:Switch Content="Preview deployments" IsChecked="True" />
              <sl:Switch Content="Compact density" Description="Fit more rows on screen." />
              <sl:Switch Content="Label after" LabelPosition="After" IsChecked="True" />
              <sl:Switch Content="Disabled" IsEnabled="False" IsChecked="True" />
            </sl:Stack>
          </sl:Card>
        </sl:ResponsiveGrid>

        <!-- Display -->
        <sl:Card Header="Badges, progress and keys">
          <sl:Stack Spacing="5">
            <sl:Stack Orientation="Horizontal" Spacing="2">
              <sl:Badge Tone="Success" ShowDot="True" Content="Ready" />
              <sl:Badge Tone="Warning" ShowDot="True" Content="Building" />
              <sl:Badge Tone="Danger" ShowDot="True" Content="Failed" />
              <sl:Badge Tone="Info" Content="Info" />
              <sl:Badge Tone="Accent" Content="New" />
              <sl:Badge Content="Draft" />
              <sl:Kbd Text="Ctrl" VerticalAlignment="Center" />
              <sl:Kbd Text="Shift" VerticalAlignment="Center" />
              <sl:Kbd Text="P" VerticalAlignment="Center" />
            </sl:Stack>
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Style="{DynamicResource Sl.Text.Mono}" Foreground="{DynamicResource Sl.Brush.Text.Secondary}" Text="64%" />
                <TextBlock Text="Uploading assets" />
              </DockPanel>
              <ProgressBar Value="64" AutomationProperties.Name="Uploading assets" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Loading" />
            <sl:Stack Orientation="Horizontal" Spacing="3" Align="Center">
              <sl:Spinner />
              <TextBlock Style="{DynamicResource Sl.Text.Secondary}" Text="Indexing 2,481 files…" />
            </sl:Stack>
          </sl:Stack>
        </sl:Card>

        <sl:Card Header="Toolbar &amp; menu bar">
          <sl:Stack Spacing="4">
            <sl:Toolbar>
              <Button sl:Ui.Variant="Ghost" sl:Ui.Size="Small" sl:Ui.Icon="arrow-left" AutomationProperties.Name="Back" />
              <Button sl:Ui.Variant="Ghost" sl:Ui.Size="Small" sl:Ui.Icon="arrow-right" AutomationProperties.Name="Forward" />
              <sl:ToolbarSeparator />
              <Button sl:Ui.Variant="Ghost" sl:Ui.Size="Small" sl:Ui.Icon="copy" Content="Copy" />
              <Button sl:Ui.Variant="Ghost" sl:Ui.Size="Small" sl:Ui.Icon="trash" Content="Delete" />
            </sl:Toolbar>
            <Menu HorizontalAlignment="Left">
              <MenuItem Header="_File">
                <MenuItem Header="New project" sl:Ui.Icon="plus" InputGestureText="Ctrl+N" />
                <MenuItem Header="Open…" sl:Ui.Icon="folder" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="Exit" />
              </MenuItem>
              <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True" />
              </MenuItem>
              <MenuItem Header="_View" />
            </Menu>
          </sl:Stack>
        </sl:Card>

        <sl:Card Header="Icons" Subtitle="The shared Slate set — the same paths render on web, Blazor, WPF and Avalonia.">
          <ItemsControl x:Name="IconGallery">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="96" Margin="0,0,0,16" ToolTip="{Binding}">
                  <sl:Icon Kind="{Binding}" Size="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding}" Margin="0,6,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                             FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="{DynamicResource Sl.Font.Size.2xs}"
                             Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </sl:Card>
      </sl:Stack>
    </sl:Container>
  </ScrollViewer>
</UserControl>
