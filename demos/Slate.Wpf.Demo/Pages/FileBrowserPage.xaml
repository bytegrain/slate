<UserControl x:Class="Slate.Wpf.Demo.Pages.FileBrowserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sl="https://slate.dev/wpf">
  <UserControl.Resources>
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Sl.Font.Size.Xs}" />
      <Setter Property="FontWeight" Value="{DynamicResource Sl.Font.Weight.Semibold}" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Sl.Brush.Background.Surface}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}"
            BorderThickness="0,0,0,1" Padding="12,8">
      <sl:Stack Direction="Row" Spacing="1" Align="Center">
        <Button sl:Sl.Variant="Ghost" sl:Sl.StartIcon="arrow-left" AutomationProperties.Name="Back" ToolTip="Back (Alt+Left)" />
        <Button sl:Sl.Variant="Ghost" sl:Sl.StartIcon="arrow-right" AutomationProperties.Name="Forward" IsEnabled="False" />
        <Button sl:Sl.Variant="Ghost" sl:Sl.StartIcon="chevron-up" AutomationProperties.Name="Up one level" />
        <Border Margin="8,0" Height="30" CornerRadius="{DynamicResource Sl.CornerRadius.Md}" Background="{DynamicResource Sl.Brush.Background.Sunken}"
                BorderBrush="{DynamicResource Sl.Brush.Border.Strong}" BorderThickness="1" Padding="4,0" MinWidth="360">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <sl:Icon Kind="folder" Size="14" Margin="6,0,4,0" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            <Button sl:Sl.Variant="Ghost" sl:Sl.Size="Small" Content="Projects" />
            <sl:Icon Kind="chevron-right" Size="12" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" VerticalAlignment="Center" />
            <Button sl:Sl.Variant="Ghost" sl:Sl.Size="Small" Content="slate" />
            <sl:Icon Kind="chevron-right" Size="12" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" VerticalAlignment="Center" />
            <Button sl:Sl.Variant="Ghost" sl:Sl.Size="Small" Content="assets" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" />
          </StackPanel>
        </Border>
        <sl:Spacer />
        <Border Style="{DynamicResource Sl.Segmented}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{DynamicResource Sl.SegmentedItem}" GroupName="View" Content="List" sl:Sl.StartIcon="menu" IsChecked="True" />
            <RadioButton Style="{DynamicResource Sl.SegmentedItem}" GroupName="View" Content="Grid" sl:Sl.StartIcon="layers" />
          </StackPanel>
        </Border>
        <Button sl:Sl.StartIcon="plus" Content="New folder" Margin="8,0,0,0" />
        <Button sl:Sl.Variant="Solid" sl:Sl.Tone="Accent" sl:Sl.StartIcon="external-link" Content="Share" Click="OnShare" />
      </sl:Stack>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Height="30" Background="{DynamicResource Sl.Brush.Background.Subtle}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}"
            BorderThickness="0,1,0,0" Padding="12,0">
      <sl:Stack Direction="Row" Spacing="4" Align="Center">
        <TextBlock x:Name="StatusText" FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Secondary}" />
        <sl:Spacer />
        <TextBlock FontSize="{DynamicResource Sl.Font.Size.Xs}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" Text="Copying 2 of 7 to \\fs01\archive" />
        <ProgressBar Width="120" Height="4" Value="38" AutomationProperties.Name="Copy progress" />
        <sl:Divider Orientation="Vertical" Height="14" />
        <TextBlock FontSize="{DynamicResource Sl.Font.Size.Xs}" FontFamily="{DynamicResource Sl.Font.Family.Mono}" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" Text="412 GB free" />
      </sl:Stack>
    </Border>

    <!-- Inspector -->
    <Border DockPanel.Dock="Right" Width="300" Background="{DynamicResource Sl.Brush.Background.Surface}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <sl:Stack Spacing="4" Margin="16">
          <Border Height="150" CornerRadius="{DynamicResource Sl.CornerRadius.Lg}" Background="{DynamicResource Sl.Brush.Background.Subtle}"
                  BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="1">
            <sl:Icon x:Name="PreviewIcon" Kind="file" Size="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
          </Border>
          <StackPanel>
            <TextBlock x:Name="InspectorName" FontSize="{DynamicResource Sl.Font.Size.Lg}" FontWeight="{DynamicResource Sl.Font.Weight.Semibold}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="InspectorKind" Style="{DynamicResource Sl.Text.Tertiary}" />
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource Sl.Text.Secondary}" Text="Size" VerticalAlignment="Center" />
            <TextBlock x:Name="InspectorSize" Grid.Column="1" Style="{DynamicResource Sl.Text.Mono}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Style="{DynamicResource Sl.Text.Secondary}" Text="Modified" VerticalAlignment="Center" />
            <TextBlock x:Name="InspectorModified" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Style="{DynamicResource Sl.Text.Secondary}" Text="Owner" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="Aaron Griffin" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Style="{DynamicResource Sl.Text.Secondary}" Text="Tags" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <sl:Badge Tone="Info" Content="textures" Margin="0,0,4,0" />
              <sl:Badge Content="v0.4" />
            </StackPanel>
          </Grid>
          <sl:Divider />
          <sl:Stack Direction="Row" Spacing="2">
            <Button sl:Sl.StartIcon="download" Content="Download" />
            <Button sl:Sl.StartIcon="copy" AutomationProperties.Name="Copy path" ToolTip="Copy path" />
            <Button sl:Sl.Tone="Danger" sl:Sl.StartIcon="trash" AutomationProperties.Name="Delete" ToolTip="Delete" Click="OnDelete" />
          </sl:Stack>
        </sl:Stack>
      </ScrollViewer>
    </Border>

    <!-- File list -->
    <Grid Grid.IsSharedSizeScope="True" Background="{DynamicResource Sl.Brush.Background.Surface}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource Sl.Brush.Background.Subtle}" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" BorderThickness="0,0,0,1" Height="32" Padding="10,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition SharedSizeGroup="Kind" Width="130" />
            <ColumnDefinition SharedSizeGroup="Size" Width="90" />
            <ColumnDefinition SharedSizeGroup="Modified" Width="130" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock Style="{StaticResource ColumnHeader}" Text="Name" Foreground="{DynamicResource Sl.Brush.Text.Primary}" />
            <sl:Icon Kind="chevron-down" Size="12" Margin="4,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="Kind" />
          <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="Size" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="Modified" Margin="16,0,0,0" />
        </Grid>
      </Border>
      <ListBox x:Name="Files" Grid.Row="1" SelectionMode="Extended" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Files">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Open" sl:Sl.StartIcon="external-link" InputGestureText="Enter" />
            <MenuItem Header="Rename" sl:Sl.StartIcon="pencil" InputGestureText="F2" />
            <MenuItem Header="Copy path" sl:Sl.StartIcon="copy" InputGestureText="Ctrl+Shift+C" />
            <MenuItem Header="Move to">
              <MenuItem Header="archive" />
              <MenuItem Header="builds" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete" sl:Sl.StartIcon="trash" sl:Sl.Tone="Danger" InputGestureText="Del" Click="OnDelete" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Height="30">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition SharedSizeGroup="Kind" Width="130" />
                <ColumnDefinition SharedSizeGroup="Size" Width="90" />
                <ColumnDefinition SharedSizeGroup="Modified" Width="130" />
              </Grid.ColumnDefinitions>
              <CheckBox VerticalAlignment="Center" Focusable="False" AutomationProperties.Name="{Binding Name}"
                        IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <sl:Icon Kind="{Binding Icon}" Margin="0,0,10,0" Foreground="{DynamicResource Sl.Brush.Accent.Text}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="{DynamicResource Sl.Brush.Text.Secondary}" />
              <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource Sl.Text.Mono}" />
              <TextBlock Grid.Column="4" Text="{Binding Modified}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
