<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sl="https://slate.dev/avalonia"
             x:Class="Slate.Avalonia.Demo.Pages.MigrationPage">
  <UserControl.Styles>
    <Style Selector="TextBlock.overline">
      <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource Sl.Brush.Text.Tertiary}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource Sl.Font.Family.Mono}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.step">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Surface}" />
      <Setter Property="BoxShadow" Value="{DynamicResource Sl.Shadow.E1}" />
    </Style>
    <Style Selector="Border.seg">
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Background.Muted}" />
    </Style>
    <Style Selector="Border.seg.on">
      <Setter Property="Background" Value="{DynamicResource Sl.Brush.Accent.Default}" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sl.Brush.Border.Default}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="220,*" Margin="0">
    <!-- step rail -->
    <Border Background="{DynamicResource Sl.Brush.Background.Subtle}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Sl.Brush.Border.Default}" Padding="12,16">
      <StackPanel Spacing="6">
        <TextBlock Classes="overline" Text="JOB · ARCHIVE-PROJECTS" Margin="6,0,0,6" />
        <Border Classes="step"><StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8"><sl:Icon Kind="check-circle" Foreground="{DynamicResource Sl.Brush.Status.Success.Fg}" /><TextBlock Text="Source" FontWeight="Medium" /></StackPanel>
          <TextBlock Text="\\fs01\projects · 2.41 TB" FontSize="12" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" Margin="24,0,0,0" />
        </StackPanel></Border>
        <Border Classes="step"><StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="8"><sl:Icon Kind="check-circle" Foreground="{DynamicResource Sl.Brush.Status.Success.Fg}" /><TextBlock Text="Destination" FontWeight="Medium" /></StackPanel>
          <TextBlock Text="s3://studio-archive" FontSize="12" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" Margin="24,0,0,0" />
        </StackPanel></Border>
        <Border Classes="step current"><StackPanel Orientation="Horizontal" Spacing="8">
          <sl:LoadingSpinner Size="14" Foreground="{DynamicResource Sl.Brush.Accent.Default}" /><TextBlock Text="Transfer" FontWeight="SemiBold" />
        </StackPanel></Border>
        <Border Classes="step"><StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="16" Height="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Sl.Brush.Border.Control}" />
          <TextBlock Text="Verify" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
        </StackPanel></Border>
      </StackPanel>
    </Border>

    <sl:Stack Grid.Column="1" Spacing="4" Margin="20,16,20,24">
      <!-- source → destination -->
      <Grid ColumnDefinitions="*,Auto,*">
        <sl:Card IsOutlined="True" Padding="14">
          <sl:Stack Orientation="Horizontal" AlignItems="Center" Spacing="3">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Sl.Brush.Background.Muted}">
              <sl:Icon Kind="folder" Size="18" />
            </Border>
            <StackPanel>
              <TextBlock Text="\\fs01\projects" Classes="mono" FontSize="13" />
              <TextBlock Text="SMB · 184,302 files" FontSize="12" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </StackPanel>
            <sl:Spacer />
            <sl:Badge Text="Connected" Tone="Success" ShowDot="True" />
          </sl:Stack>
        </sl:Card>
        <sl:Icon Grid.Column="1" Kind="arrow-right" Size="20" Margin="12,0" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
        <sl:Card Grid.Column="2" IsOutlined="True" Padding="14">
          <sl:Stack Orientation="Horizontal" AlignItems="Center" Spacing="3">
            <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Sl.Brush.Accent.Subtle}">
              <sl:Icon Kind="upload" Size="18" Foreground="{DynamicResource Sl.Brush.Accent.Text}" />
            </Border>
            <StackPanel>
              <TextBlock Text="s3://studio-archive/projects" Classes="mono" FontSize="13" />
              <TextBlock Text="eu-west-2 · Glacier IR" FontSize="12" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </StackPanel>
            <sl:Spacer />
            <sl:Badge Text="Writable" Tone="Info" />
          </sl:Stack>
        </sl:Card>
      </Grid>

      <!-- overall progress -->
      <sl:Card Header="Transfer" Subtitle="Step 3 of 4">
        <sl:Card.HeaderActions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Pause" sl:Sl.Icon="minus" sl:Sl.Size="Small" />
            <Button Content="Cancel job" Classes="danger" sl:Sl.Size="Small" />
          </StackPanel>
        </sl:Card.HeaderActions>
        <sl:Stack Spacing="4">
          <sl:Stack Orientation="Horizontal" AlignItems="End" Spacing="4">
            <TextBlock Text="62%" FontSize="40" FontWeight="SemiBold" LetterSpacing="-1" />
            <StackPanel Margin="0,0,0,6">
              <TextBlock Classes="mono" Text="1.49 TB of 2.41 TB" />
              <TextBlock FontSize="12" Text="114,207 of 184,302 files · ETA 3h 12m" Foreground="{DynamicResource Sl.Brush.Text.Tertiary}" />
            </StackPanel>
            <sl:Spacer />
            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,6">
              <TextBlock Classes="overline" Text="THROUGHPUT" HorizontalAlignment="Right" />
              <TextBlock Classes="mono" Text="842 MB/s" FontSize="15" HorizontalAlignment="Right" />
            </StackPanel>
          </sl:Stack>
          <UniformGrid Columns="20" x:Name="Gauge" Height="14" />
          <Grid ColumnDefinitions="*,24,Auto">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Bandwidth limit" FontSize="13" FontWeight="Medium" />
                <TextBlock Grid.Column="1" Classes="mono" Text="1 Gb/s" />
              </Grid>
              <Slider Minimum="0" Maximum="10" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
            <ToggleSwitch Grid.Column="2" Content="Verify checksums" IsChecked="True" VerticalAlignment="Center" />
          </Grid>
        </sl:Stack>
      </sl:Card>

      <sl:ResponsiveGrid Spacing="4">
        <!-- active transfers -->
        <sl:Card sl:ResponsiveGrid.Lg="7" Header="Active transfers" Padding="0">
          <sl:Card.HeaderActions>
            <sl:Badge Text="8 workers" />
          </sl:Card.HeaderActions>
          <StackPanel x:Name="Transfers" />
        </sl:Card>
        <!-- issues -->
        <sl:Stack sl:ResponsiveGrid.Lg="5" Spacing="3">
          <sl:Alert Severity="Warning" Title="3 files skipped" Content="Path longer than 1,024 characters." />
          <sl:Alert Severity="Error" Title="Permission denied" Content="\\fs01\projects\_secure (412 files)">
            <sl:Alert.Actions>
              <Button Content="Fix permissions…" sl:Sl.Size="Small" />
            </sl:Alert.Actions>
          </sl:Alert>
          <sl:Card Header="On conflict" IsOutlined="True" Padding="14">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ToggleButton Content="Skip" sl:Sl.Size="Small" />
              <ToggleButton Content="Overwrite" sl:Sl.Size="Small" />
              <ToggleButton Content="Keep both" sl:Sl.Size="Small" IsChecked="True" />
            </StackPanel>
          </sl:Card>
        </sl:Stack>
      </sl:ResponsiveGrid>

      <!-- log -->
      <sl:Card Header="Log" IsOutlined="True" Padding="0">
        <Border Background="{DynamicResource Sl.Brush.Background.Sunken}" Padding="14,10">
          <SelectableTextBlock x:Name="Log" FontFamily="{DynamicResource Sl.Font.Family.Mono}" FontSize="12" LineHeight="19"
                               Foreground="{DynamicResource Sl.Brush.Text.Secondary}" />
        </Border>
      </sl:Card>
    </sl:Stack>
  </Grid>
</UserControl>
