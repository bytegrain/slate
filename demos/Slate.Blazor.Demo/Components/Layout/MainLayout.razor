@inherits LayoutComponentBase

<SlateProvider @bind-Theme="_theme" @bind-Density="_density">
    <SlAppShell>
        <SlAppBar>
            <Title>
                <SlStack Row="true" Spacing="2" Align="StackAlign.Center">
                    <SlIcon Name="layers" Size="ControlSize.Large" />
                    <span>Slate</span>
                    <SlBadge>Blazor · 0.1</SlBadge>
                </SlStack>
            </Title>
            <ChildContent>
                <SlSpacer />
                <SlButton Class="demo-narrow" IconOnly="true" Variant="ButtonVariant.Ghost" StartIcon="@(_theme == ThemeMode.Dark ? "moon" : "sun")"
                          AriaLabel="@($"Theme: {_theme}. Change theme")" OnClick="CycleTheme" />
                <SlButtonGroup Label="Theme" Class="demo-wide">
                    <SlButton Size="ControlSize.Small" StartIcon="sun" Pressed="@(_theme == ThemeMode.Light)" OnClick="() => _theme = ThemeMode.Light">Light</SlButton>
                    <SlButton Size="ControlSize.Small" StartIcon="moon" Pressed="@(_theme == ThemeMode.Dark)" OnClick="() => _theme = ThemeMode.Dark">Dark</SlButton>
                    <SlButton Size="ControlSize.Small" Pressed="@(_theme == ThemeMode.System)" OnClick="() => _theme = ThemeMode.System">System</SlButton>
                </SlButtonGroup>
                <SlButtonGroup Label="Density" Class="demo-wide">
                    <SlButton Size="ControlSize.Small" Pressed="@(_density == Density.Compact)" OnClick="() => _density = Density.Compact">Compact</SlButton>
                    <SlButton Size="ControlSize.Small" Pressed="@(_density == Density.Comfortable)" OnClick="() => _density = Density.Comfortable">Comfortable</SlButton>
                </SlButtonGroup>
            </ChildContent>
        </SlAppBar>
        <SlDrawer @bind-Open="_drawerOpen">
            <SlNav>
                <SlNavHeading>Getting started</SlNavHeading>
                <SlNavLink Href="" Icon="home" Match="NavLinkMatch.All">Overview</SlNavLink>
                <SlNavHeading>Library</SlNavHeading>
                <SlNavLink Href="components" Icon="layers">Components</SlNavLink>
                <SlNavLink Href="forms" Icon="pencil">Forms</SlNavLink>
                <SlNavLink Href="layout" Icon="copy">Layout</SlNavLink>
                <SlNavLink Href="feedback" Icon="bell">Feedback</SlNavLink>
                <SlNavLink Href="dialogs" Icon="external-link">Dialogs</SlNavLink>
                <SlNavHeading>Examples</SlNavHeading>
                <SlNavLink Href="examples/issues" Icon="check-circle" Meta="24">Issue tracker</SlNavLink>
            </SlNav>
        </SlDrawer>
        <SlMain>
            @Body
        </SlMain>
    </SlAppShell>
</SlateProvider>

@code {
    private ThemeMode _theme = ThemeMode.System;
    private Density _density = Density.Compact;
    private bool _drawerOpen = true;

    private void CycleTheme() => _theme = _theme switch
    {
        ThemeMode.System => ThemeMode.Light,
        ThemeMode.Light => ThemeMode.Dark,
        _ => ThemeMode.System,
    };
}
