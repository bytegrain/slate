@inherits LayoutComponentBase
@implements IDisposable
@inject DemoTheme Demo

<SlateProvider Mode="Demo.Mode" ModeChanged="m => { Demo.Mode = m; }" Density="Demo.Density" ThemeOptions="Demo.Options">
    <SlAppShell @bind-DrawerOpen="_drawerOpen" FillViewport="true">
        <AppBar>
            <SlAppBar>
                <Leading>
                    <SlStack Row="true" Spacing="2" Align="StackAlign.Center">
                        <SlIcon Name="layers" Size="ControlSize.Large" />
                        <strong>Slate</strong>
                        <SlBadge Size="BadgeSize.Small">Blazor · 0.1</SlBadge>
                    </SlStack>
                </Leading>
                <Actions>
                    <SlButton Class="demo-narrow" IconOnly="true" Variant="ButtonVariant.Ghost" StartIcon="@(Demo.Mode == ThemeMode.Dark ? "moon" : "sun")"
                              Label="@($"Theme: {Demo.Mode}. Change theme")" Click="CycleTheme" />
                    <SlButtonGroup Label="Theme" Class="demo-wide">
                        <SlButton Size="ControlSize.Small" StartIcon="sun" Pressed="@(Demo.Mode == ThemeMode.Light)" Click="() => SetMode(ThemeMode.Light)">Light</SlButton>
                        <SlButton Size="ControlSize.Small" StartIcon="moon" Pressed="@(Demo.Mode == ThemeMode.Dark)" Click="() => SetMode(ThemeMode.Dark)">Dark</SlButton>
                        <SlButton Size="ControlSize.Small" Pressed="@(Demo.Mode == ThemeMode.System)" Click="() => SetMode(ThemeMode.System)">System</SlButton>
                    </SlButtonGroup>
                    <SlButtonGroup Label="Density" Class="demo-wide">
                        <SlButton Size="ControlSize.Small" Pressed="@(Demo.Density == Density.Compact)" Click="() => SetDensity(Density.Compact)">Compact</SlButton>
                        <SlButton Size="ControlSize.Small" Pressed="@(Demo.Density == Density.Comfortable)" Click="() => SetDensity(Density.Comfortable)">Comfortable</SlButton>
                    </SlButtonGroup>
                </Actions>
            </SlAppBar>
        </AppBar>
        <Drawer>
            <SlNav>
                <SlNavHeading>Getting started</SlNavHeading>
                <SlNavItem Href="" Icon="home" Label="Overview" Match="NavLinkMatch.All" />
                <SlNavItem Href="theming" Icon="settings" Label="Theming" />
                <SlNavItem Href="playground" Icon="sun" Label="Playground" />
                <SlNavHeading>Library</SlNavHeading>
                <SlNavItem Href="components" Icon="layers" Label="Components" />
                <SlNavItem Href="forms" Icon="pencil" Label="Forms" />
                <SlNavItem Href="layout" Icon="copy" Label="Layout" />
                <SlNavItem Href="feedback" Icon="bell" Label="Feedback" />
                <SlNavItem Href="dialogs" Icon="external-link" Label="Dialogs" />
                <SlNavItem Href="pickers" Icon="calendar" Label="Pickers" />
                <SlNavItem Href="navigation" Icon="arrow-right" Label="Navigation" />
                <SlNavItem Href="overlays" Icon="layers" Label="Overlays" />
                <SlNavItem Href="tree-view" Icon="folder" Label="Tree view" />
                <SlNavItem Href="avatar-skeleton" Icon="user" Label="Avatar &amp; skeleton" />
                <SlNavHeading>Examples</SlNavHeading>
                <SlNavItem Href="examples/issues" Icon="check-circle" Label="Issue tracker" Trailing="24" />
            </SlNav>
        </Drawer>
        <ChildContent>@Body</ChildContent>
    </SlAppShell>
</SlateProvider>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized() => Demo.Changed += OnDemoChanged;

    private void OnDemoChanged() => InvokeAsync(StateHasChanged);

    private void SetMode(ThemeMode mode)
    {
        Demo.Mode = mode;
        Demo.Notify();
    }

    private void SetDensity(Density density)
    {
        Demo.Density = density;
        Demo.Notify();
    }

    private void CycleTheme() => SetMode(Demo.Mode switch
    {
        ThemeMode.System => ThemeMode.Light,
        ThemeMode.Light => ThemeMode.Dark,
        _ => ThemeMode.System,
    });

    public void Dispose() => Demo.Changed -= OnDemoChanged;
}
