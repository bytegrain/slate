{
  "$description": "Theme-independent foundations: type, space, radius, size, motion, layout, layering.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "Instrument Sans",
          "Segoe UI",
          "system-ui",
          "sans-serif"
        ],
        "$description": "All interface text."
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "Cascadia Mono",
          "Consolas",
          "ui-monospace",
          "monospace"
        ],
        "$description": "IDs, numbers in tables, code, keyboard hints."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": "11px"
      },
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "13px"
      },
      "md": {
        "$value": "14px"
      },
      "lg": {
        "$value": "16px"
      },
      "xl": {
        "$value": "18px"
      },
      "2xl": {
        "$value": "22px"
      },
      "3xl": {
        "$value": "28px"
      },
      "4xl": {
        "$value": "36px"
      },
      "display": {
        "$value": "56px"
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.5
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0em"
      },
      "caps": {
        "$value": "0.04em"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Named text styles. Every platform exposes these by name (e.g. Text Typo=\"Body\").",
    "display": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.display}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "-0.035em"
      }
    },
    "h1": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "-0.03em"
      }
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.tight}",
        "letterSpacing": "-0.02em"
      }
    },
    "h3": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.snug}",
        "letterSpacing": "-0.015em"
      }
    },
    "title": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.lineHeight.snug}",
        "letterSpacing": "{font.tracking.normal}"
