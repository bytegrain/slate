{
  "$description": "Canonical component API. Every platform must expose each option under its canonical name (spelled per docs/design/configurability.md#spelling) with these values. Platform conformance tests read this file. 'kind': param = value option, bool = flag, slot = content region, event = notification. 'platforms' limits an option to some platforms (default: all). Components with \"status\": \"planned\" are specified but not yet required by conformance tests.",
  "common": {
    "$description": "Applies to every component below unless it says otherwise.",
    "styling": "Blazor: Class, Style, AdditionalAttributes. Web: host class/style, ::part(name) for every part listed, component CSS variables. XAML: native Classes/Style/Theme, named PART_* template parts, Sl.Component.* resources."
  },
  "enums": {
    "Tone": [
      "neutral",
      "accent",
      "success",
      "warning",
      "danger",
      "info"
    ],
    "Severity": [
      "normal",
      "info",
      "success",
      "warning",
      "error"
    ],
    "ButtonVariant": [
      "outlined",
      "solid",
      "soft",
      "ghost",
      "link"
    ],
    "FieldVariant": [
      "outlined",
      "filled",
      "underlined"
    ],
    "CardVariant": [
      "elevated",
      "outlined",
      "flat"
    ],
    "BadgeVariant": [
      "soft",
      "solid",
      "outlined"
    ],
    "AlertVariant": [
      "soft",
      "outlined",
      "solid"
    ],
    "ControlSize": [
      "small",
      "medium",
      "large"
    ],
    "Radius": [
      "default",
      "none",
      "small",
      "medium",
      "large",
      "full"
    ],
    "Placement": [
      "start",
      "end"
    ],
    "Density": [
      "compact",
      "comfortable"
    ],
    "ThemeMode": [
      "system",
      "light",
      "dark"
    ],
    "DrawerVariant": [
      "responsive",
      "persistent",
      "temporary",
      "mini"
    ],
    "Direction": [
      "row",
      "column"
    ],
    "ContainerWidth": [
      "sm",
      "md",
      "lg",
      "xl",
      "fluid"
    ],
    "SnackbarPosition": [
      "top-left",
      "top-center",
      "top-right",
      "bottom-left",
      "bottom-center",
      "bottom-right"
    ],
    "DialogWidth": [
      "xs",
      "sm",
      "md",
      "lg",
      "xl"
    ],
    "StackAlign": [
      "stretch",
      "start",
      "center",
      "end",
      "baseline"
    ],
    "StackJustify": [
      "start",
      "center",
      "end",
      "between"
    ],
    "GridSelectionMode": [
      "none",
      "single",
      "multi"
    ],
    "GridColumnType": [
      "text",
      "number",
      "date",
      "boolean",
      "enum",
      "progress",
      "sparkline",
      "actions",
      "custom"
    ],
    "SortDirection": [
      "ascending",
      "descending"
    ],
    "GridPin": [
      "none",
      "start",
      "end"
    ],
    "GridAggregate": [
      "none",
      "sum",
      "avg",
      "min",
      "max",
      "count"
    ],
    "GridPagination": [
      "none",
      "pages",
      "infinite"
    ],
    "PopoverPlacement": [
      "top",
      "top-start",
      "top-end",
      "bottom",
      "bottom-start",
      "bottom-end",
      "left",
      "left-start",
      "left-end",
      "right",
      "right-start",
      "right-end"
    ],
    "TabsVariant": [
      "line",
      "pills",
      "enclosed"
    ],
    "SelectionKind": [
      "single",
      "multiple"
    ],
    "DateSelection": [
      "single",
      "range"
    ],
    "TreeSelectionMode": [
      "none",
      "single",
      "multi",
      "checkbox"
    ]
  },
  "components": {
    "Button": {
      "web": "sl-button",
      "blazor": "SlButton",
      "xaml": "Button + sl:Sl.* attached properties",
      "options": {
        "Variant": {
          "kind": "param",
          "type": "ButtonVariant",
          "default": "outlined"
        },
        "Tone": {
          "kind": "param",
          "type": "Tone",
          "default": "neutral"
        },
        "Size": {
          "kind": "param",
          "type": "ControlSize",
          "default": "medium"
        },
        "Radius": {
          "kind": "param",
          "type": "Radius",
          "default": "default"
        },
        "StartIcon": {
          "kind": "param",
          "type": "icon"
        },
        "EndIcon": {
          "kind": "param",
          "type": "icon"
        },
        "IconOnly": {
          "kind": "bool",
          "note": "Requires Label."
        },
        "Label": {
          "kind": "param",
          "type": "string",
          "note": "Accessible name; required for IconOnly."
        },
        "Loading": {
          "kind": "bool"
        },
        "Disabled": {
          "kind": "bool",
          "note": "XAML: native IsEnabled."
        },
        "FullWidth": {
          "kind": "bool"
        },
        "Pressed": {
          "kind": "param",
          "type": "bool?",
          "note": "Toggle state (aria-pressed). Null = not a toggle."
        },
        "Shortcut": {
          "kind": "param",
          "type": "string"
        },
        "Href": {
          "kind": "param",
          "type": "string",
          "platforms": [
            "web",
            "blazor"
          ]
        },
        "Type": {
          "kind": "param",
          "type": "button|submit|reset",
          "platforms": [
            "web",
            "blazor"
          ]
        },
        "Content": {
          "kind": "slot"
        },
        "Click": {
          "kind": "event"
        }
      },
      "parts": [
        "base",
        "label",
        "start",
        "end",
        "spinner"
      ]
    },
