        "Required": {
          "kind": "bool"
        },
        "Disabled": {
          "kind": "bool"
        },
        "ReadOnly": {
          "kind": "bool"
        },
        "InputType": {
          "kind": "param",
          "type": "text|password|email|number|search|tel|url"
        },
        "Multiline": {
          "kind": "bool"
        },
        "Rows": {
          "kind": "param",
          "type": "int"
        },
        "MaxLength": {
          "kind": "param",
          "type": "int?"
        },
        "Counter": {
          "kind": "bool",
          "note": "Shows value length (and MaxLength)."
        },
        "Clearable": {
          "kind": "bool",
          "note": "Shows a clear button when not empty."
        },
        "Prefix": {
          "kind": "param",
          "type": "string"
        },
        "Suffix": {
          "kind": "param",
          "type": "string"
        },
        "StartIcon": {
          "kind": "param",
          "type": "icon"
        },
        "EndIcon": {
          "kind": "param",
          "type": "icon"
        },
        "StartContent": {
          "kind": "slot",
          "note": "Custom leading adornment (overrides StartIcon)."
        },
        "EndContent": {
          "kind": "slot",
          "note": "Custom trailing adornment (overrides EndIcon)."
        },
        "Value": {
          "kind": "param",
          "type": "T"
        },
        "ValueChanged": {
          "kind": "event"
        }
      },
      "parts": [
        "base",
        "label",
        "control",
        "input",
        "helper",
        "error",
        "prefix",
        "suffix"
      ]
